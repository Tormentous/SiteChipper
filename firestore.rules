rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid)); }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }
    function moderator() { return signedIn() && ((!exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && request.auth.token.get('moderator', false) == true) || (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['moderator','lead','admin'])); }
    function shortText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function validAvatar() { return !('avatarPath' in request.resource.data) || request.resource.data.avatarPath.matches('media/' + request.auth.uid + '/[^/]+'); }
    function validSearch() { return request.resource.data.get('searchTokens',[]) is list && request.resource.data.get('searchTokens',[]).size() <= 100; }
    function validProfile(id) {
      return get(/databases/$(database)/documents/profiles/$(id)).data.uid == request.auth.uid;
    }
    function builtinBoard(value) { return value in ['general','beesid','starry','chippercorner','labradoria','mutinydesk','giftdrive','farmreport','farmdestroyersclub','invasions','mutinies4lyfe','testboard']; }
    function board(value) { return value is string && (builtinBoard(value.lower()) || exists(/databases/$(database)/documents/boards/$(value))); }
    function safeUrl(value) { return value is string && value.size() <= 2048 && (value.matches('https://.*') || value.matches('/[^/].*') || (value.matches('http://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?/.*'))); }
    function media(value) { return value == null || (value is map && value.keys().hasOnly(['url','type','path']) && safeUrl(value.url) && value.type in ['image','video'] && value.path.matches('media/' + request.auth.uid + '/[^/]+')); }
    function blocked(a, b) { return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b)) || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a)); }
    function postExists(id) { return exists(/databases/$(database)/documents/posts/$(id)); }
    function canEngage(id) { return signedIn() && postExists(id) && !blocked(request.auth.uid, get(/databases/$(database)/documents/posts/$(id)).data.authorId); }

    function rate(kind, id) {
      let activity = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/activity/$(kind)).data;
      return activity.at == request.time && activity.operationId == id;
    }
    match /users/{uid}/activity/{kind} {
      function interval() { return kind == 'board' ? 60 : kind == 'poll' ? 30 : kind == 'report' ? 10 : kind == 'post' ? 5 : kind == 'message' ? 1 : 2; }
      function valid() { return mine(uid) && kind in ['post','reply','message','friend','poll','report','board']
        && request.resource.data.keys().hasOnly(['at','operationId']) && request.resource.data.at == request.time
        && shortText(request.resource.data.operationId,150); }
      allow read: if mine(uid);
      allow create: if valid();
      allow update: if valid() && request.time >= resource.data.at + duration.value(interval(),'s');
    }
    match /profiles/{id} {
      allow read: if true;
      allow create: if mine(id) && request.resource.data.keys().hasOnly(['uid','displayName','bio','avatarUrl','createdAt','searchTokens','avatarPath'])
        && request.resource.data.uid == request.auth.uid && validAvatar() && validSearch() && shortText(request.resource.data.displayName,48)
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 500
        && safeUrl(request.resource.data.avatarUrl) && request.resource.data.createdAt == request.time;
      // Legacy numeric profiles remain readable/editable by their established owner.
      allow update: if mine(resource.data.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio','avatarUrl','searchTokens','avatarPath'])
        && validAvatar() && validSearch() && shortText(request.resource.data.displayName,48) && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500 && safeUrl(request.resource.data.avatarUrl);
    }
    match /boards/{id} {
      allow read: if true;
      allow create: if signedIn() && rate('board',id) && !builtinBoard(id) && id.matches('[a-z0-9-]{3,32}')
        && request.resource.data.keys().hasOnly(['name','description','ownerId','createdAt'])
        && mine(request.resource.data.ownerId) && shortText(request.resource.data.name,48)
        && request.resource.data.description is string && request.resource.data.description.size() <= 280
        && request.resource.data.createdAt == request.time;
      allow update: if mine(resource.data.ownerId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description'])
        && request.resource.data.description is string && request.resource.data.description.size() <= 280;
    }
    match /posts/{id} {
      allow read: if true;
      allow create: if signedIn() && rate('post',id) && request.resource.data.keys().hasOnly(['authorId','profileId','board','text','media','contentWarnings','inGame','createdAt','editedAt','searchTokens'])
        && mine(request.resource.data.authorId) && validProfile(request.resource.data.profileId)
        && board(request.resource.data.board) && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && validSearch() && (request.resource.data.text.size() > 0 || request.resource.data.media != null) && media(request.resource.data.media)
        && request.resource.data.get('contentWarnings', []) is list && request.resource.data.get('contentWarnings', []).size() <= 6
        && request.resource.data.inGame == (request.resource.data.board == 'BeeSid')
        && request.resource.data.createdAt == request.time && request.resource.data.editedAt == null;
      allow update: if mine(resource.data.authorId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt','searchTokens'])
        && validSearch() && shortText(request.resource.data.text,2000) && request.resource.data.editedAt == request.time;
      allow delete: if mine(resource.data.authorId);
      match /reactions/{uid} {
        allow read: if postExists(id);
        allow create, update: if mine(uid) && canEngage(id) && request.resource.data.keys().hasOnly(['yeah','repost'])
          && request.resource.data.yeah is bool && request.resource.data.repost is bool;
        allow delete: if mine(uid);
      }
      match /comments/{commentId} {
        allow read: if postExists(id);
        allow create: if canEngage(id) && rate('reply',commentId) && request.resource.data.keys().hasOnly(['authorId','profileId','text','media','createdAt'])
          && mine(request.resource.data.authorId) && validProfile(request.resource.data.profileId)
          && shortText(request.resource.data.text,2000) && media(request.resource.data.media) && request.resource.data.createdAt == request.time;
        allow delete: if mine(resource.data.authorId) || (postExists(id) && mine(get(/databases/$(database)/documents/posts/$(id)).data.authorId));
      }
    }
    match /reposts/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['authorId','profileId','postId','createdAt'])
        && mine(request.resource.data.authorId) && validProfile(request.resource.data.profileId)
        && id == request.auth.uid + '__' + request.resource.data.postId && canEngage(request.resource.data.postId)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)/reactions/$(request.auth.uid)).data.repost == true;
      allow delete: if mine(resource.data.authorId);
    }
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && rate('friend',id) && request.resource.data.keys().hasOnly(['participants','requester','status','createdAt'])
        && request.resource.data.participants is list && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants && request.resource.data.participants[0] < request.resource.data.participants[1]
        && id == request.resource.data.participants[0] + '__' + request.resource.data.participants[1]
        && !blocked(request.resource.data.participants[0],request.resource.data.participants[1])
        && mine(request.resource.data.requester) && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid in resource.data.participants && request.auth.uid != resource.data.requester
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && !blocked(resource.data.participants[0],resource.data.participants[1])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }
    match /conversations/{id} {
      function participant() { return signedIn() && request.auth.uid in resource.data.participants; }
      function available() { return !blocked(resource.data.participants[0],resource.data.participants[1]); }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/conversations/$(id)) || participant());
      allow list: if participant();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['participants','createdAt','updatedAt'])
        && request.resource.data.participants is list && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants && request.resource.data.participants[0] < request.resource.data.participants[1]
        && id == request.resource.data.participants[0] + '__' + request.resource.data.participants[1]
        && !blocked(request.resource.data.participants[0],request.resource.data.participants[1])
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if participant() && available() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastSenderId','lastMessageId'])
        && request.resource.data.updatedAt == request.time && mine(request.resource.data.lastSenderId)
        && getAfter(/databases/$(database)/documents/conversations/$(id)/messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid
        && !exists(/databases/$(database)/documents/conversations/$(id)/messages/$(request.resource.data.lastMessageId));
      match /messages/{messageId} {
        function parent() { return get(/databases/$(database)/documents/conversations/$(id)).data; }
        allow read: if signedIn() && request.auth.uid in parent().participants;
        allow create: if signedIn() && rate('message',messageId) && request.auth.uid in parent().participants
          && !blocked(parent().participants[0],parent().participants[1])
          && request.resource.data.keys().hasOnly(['senderId','text','createdAt']) && mine(request.resource.data.senderId)
          && shortText(request.resource.data.text,2000) && request.resource.data.createdAt == request.time;
      }
    }
    match /users/{uid}/conversationReads/{thread} {
      allow read: if mine(uid);
      allow create, update: if mine(uid) && request.resource.data.keys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time
        && uid in get(/databases/$(database)/documents/conversations/$(thread)).data.participants;
    }
    match /users/{uid}/blocks/{target} {
      allow read, delete: if mine(uid);
      allow create: if mine(uid) && target != uid && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
    }
    match /users/{uid}/notifications/{id} {
      allow read: if mine(uid);
      allow update: if mine(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read == true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['senderId','profileId','kind','postId','commentId','text','read','createdAt'])
        && mine(request.resource.data.senderId) && validProfile(request.resource.data.profileId)
        && request.resource.data.kind == 'reply' && request.resource.data.commentId == id && request.resource.data.read == false
        && request.resource.data.createdAt == request.time && shortText(request.resource.data.text,160)
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorId == uid
        && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)/comments/$(id)).data.authorId == request.auth.uid
        && !exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)/comments/$(id));
    }
    match /polls/{id} {
      allow read: if true;
      allow create: if signedIn() && rate('poll',id) && request.resource.data.keys().hasOnly(['authorId','profileId','title','options','board','createdAt'])
        && mine(request.resource.data.authorId) && validProfile(request.resource.data.profileId) && shortText(request.resource.data.title,180)
        && board(request.resource.data.board) && request.resource.data.options is list && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 6 && request.resource.data.options.toSet().size() == request.resource.data.options.size()
        && shortText(request.resource.data.options[0],80) && shortText(request.resource.data.options[1],80)
        && (request.resource.data.options.size() < 3 || shortText(request.resource.data.options[2],80))
        && (request.resource.data.options.size() < 4 || shortText(request.resource.data.options[3],80))
        && (request.resource.data.options.size() < 5 || shortText(request.resource.data.options[4],80))
        && (request.resource.data.options.size() < 6 || shortText(request.resource.data.options[5],80))
        && request.resource.data.createdAt == request.time;
      allow update: if mine(resource.data.authorId) && !('closedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closedAt']) && request.resource.data.closedAt == request.time;
      allow delete: if mine(resource.data.authorId);
      match /votes/{uid} {
        allow read: if true;
        allow create: if mine(uid) && request.resource.data.keys().hasOnly(['choice','createdAt']) && request.resource.data.choice is int
          && !('closedAt' in get(/databases/$(database)/documents/polls/$(id)).data)
          && request.resource.data.choice >= 0 && request.resource.data.choice < get(/databases/$(database)/documents/polls/$(id)).data.options.size()
          && request.resource.data.createdAt == request.time;
      }
    }
    match /reports/{id} {
      function target() {
        let data=request.resource.data;
        return ('pollId' in data && !('postId' in data) && !('commentId' in data) && exists(/databases/$(database)/documents/polls/$(data.pollId)))
          || ('postId' in data && !('pollId' in data) && postExists(data.postId)
            && (!('commentId' in data) || exists(/databases/$(database)/documents/posts/$(data.postId)/comments/$(data.commentId))));
      }
      allow create: if signedIn() && rate('report',id)
        && request.resource.data.keys().hasOnly(['reporter','postId','commentId','pollId','reason','createdAt']) && mine(request.resource.data.reporter)
        && target() && shortText(request.resource.data.reason,1000) && request.resource.data.createdAt == request.time;
      allow read: if moderator() || mine(resource.data.reporter);
      allow update, delete: if false;
    }
    match /moderationDecisions/{id} {
      allow read: if moderator() || (signedIn() && request.auth.uid in resource.data.recipients);
      allow write: if false;
    }
    match /staff/{uid} { allow read, write: if false; }
    match /moderationCases/{id}/{path=**} { allow read, write: if false; }
    match /staffAudit/{id} { allow read, write: if false; }
    // Only trusted moderators/server code can publish the curated in-game feed.
    match /chipper/{id} { allow read: if true; allow write: if moderator(); }
    match /{document=**} { allow read, write: if false; }
  }
}
