/* Coolbrador profile shell (no Roblox card look) */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

body.profile-page {
  margin: 0;
  font-family: 'Inter', system-ui, sans-serif;
  background: linear-gradient(to bottom, var(--cb-navy-2), var(--cb-navy-3));
  color: var(--cb-text);
  min-height: 100vh;
}

.cb-profile {
  width: min(1180px, calc(100% - 24px));
  margin: 12px auto 96px;
}

.cb-profile-banner {
  position: relative;
  height: clamp(220px, 28vw, 340px);
  background:
    linear-gradient(120deg, var(--cb-navy-2), color-mix(in srgb, var(--cb-surface) 70%, var(--cb-navy-3))),
    var(--cb-navy);
  overflow: hidden;
  border: 1px solid rgba(var(--cb-accent-rgb), 0.18);
}
.cb-profile-banner img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.cb-profile-banner-open {
  position: absolute;
  inset: 0;
  border: 0;
  background: transparent;
  cursor: zoom-in;
}

.cb-profile-body {
  display: grid;
  grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
  gap: 18px;
  margin-top: 16px;
  align-items: start;
}

.cb-profile-left {
  background: color-mix(in srgb, var(--cb-navy) 88%, transparent);
  border: 1px solid rgba(var(--cb-accent-rgb), 0.2);
  padding: 18px 16px 22px;
  position: sticky;
  top: 76px;
}

.cb-profile-avatar-btn {
  display: block;
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: zoom-in;
  margin: 0 0 14px;
}
.cb-profile-avatar {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 50%;
  object-fit: cover;
  display: block;
  background: var(--cb-surface);
  outline: 4px solid var(--cb-navy-2);
  outline-offset: 0;
  box-shadow: none;
}

.cb-profile-name {
  margin: 0 0 4px;
  font-size: 1.45rem;
  line-height: 1.2;
  word-break: break-word;
}
.cb-profile-handle {
  margin: 0 0 10px;
  color: var(--cb-muted);
}
.cb-profile-bio {
  margin: 0 0 14px;
  color: var(--cb-muted);
  line-height: 1.45;
  white-space: pre-wrap;
}

.cb-profile-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 16px;
}
.cb-profile-stat {
  background: color-mix(in srgb, var(--cb-surface) 70%, transparent);
  border: 1px solid rgba(var(--cb-accent-rgb), 0.16);
  padding: 10px 8px;
  text-align: center;
}
.cb-profile-stat strong { display: block; font-size: 1.05rem; }
.cb-profile-stat span { color: var(--cb-muted); font-size: 0.78rem; }

.cb-profile-block { margin-top: 16px; }
.cb-profile-block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
}
.cb-profile-block h2,
.cb-about-copy h2,
.cb-card-col h2 {
  margin: 0;
  font-size: 1rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.cb-text-btn {
  appearance: none;
  border: 0;
  background: transparent;
  color: var(--cb-accent);
  cursor: pointer;
  font-weight: 700;
  padding: 0;
}
.cb-text-btn:hover { text-decoration: underline; }

.cb-media-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
}
.cb-media-grid button {
  appearance: none;
  border: 0;
  padding: 0;
  background: var(--cb-surface);
  cursor: zoom-in;
  aspect-ratio: 1;
  overflow: hidden;
}
.cb-media-grid img,
.cb-media-grid video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cb-friends-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 280px;
  overflow: auto;
}
.cb-friend-row {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--cb-text);
  padding: 6px;
  border: 1px solid transparent;
}
.cb-friend-row:hover {
  border-color: rgba(var(--cb-accent-rgb), 0.28);
  background: rgba(var(--cb-accent-rgb), 0.08);
}
.cb-friend-row img {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  object-fit: cover;
  outline: 2px solid var(--cb-navy-2);
}

.cb-profile-right {
  min-width: 0;
  background: color-mix(in srgb, var(--cb-navy) 82%, transparent);
  border: 1px solid rgba(var(--cb-accent-rgb), 0.2);
  padding: 0 0 18px;
}

.cb-profile-right-top {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 12px;
  border-bottom: 1px solid rgba(var(--cb-accent-rgb), 0.18);
  padding: 0 12px;
  overflow: visible;
  position: relative;
  z-index: 40;
}

.cb-profile-tabs { flex: 1; min-width: 0; }
.cb-profile-tabs-inner {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 0.15rem;
}
.cb-profile-tab {
  appearance: none;
  border: 0;
  background: transparent;
  color: var(--cb-muted);
  font-weight: 800;
  font-size: 0.95rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 1rem 1.1rem;
  cursor: pointer;
  position: relative;
}
.cb-profile-tab.is-active { color: var(--cb-text); }
.cb-profile-tab-ink {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 3px;
  width: 40px;
  background: var(--cb-accent);
  transition: transform 0.28s cubic-bezier(.2,.8,.2,1), width 0.28s cubic-bezier(.2,.8,.2,1);
  pointer-events: none;
}

.cb-profile-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 0;
  overflow: visible;
  position: relative;
  z-index: 30;
}
.cb-profile-actions button,
.cb-edit-actions button,
.cb-builder-actions button {
  appearance: none;
  border: 1px solid rgba(var(--cb-accent-rgb), 0.35);
  background: color-mix(in srgb, var(--cb-surface) 80%, transparent);
  color: var(--cb-text);
  padding: 8px 12px;
  cursor: pointer;
  font-weight: 700;
}
.cb-profile-actions button.primary,
.cb-edit-actions #editSave {
  background: linear-gradient(135deg, var(--cb-accent), var(--cb-accent-2));
  border: none;
  color: var(--cb-accent-text);
}
.cb-profile-actions button.ghost,
.cb-edit-actions .ghost,
.cb-builder-actions .ghost {
  background: transparent;
}
.cb-icon-btn {
  width: 40px;
  height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
}

.cb-profile-panes { padding: 16px 16px 0; position: relative; }
.cb-profile-pane { animation: cbPaneIn 0.28s ease; }
.cb-profile-pane[hidden] { display: none !important; }
@keyframes cbPaneIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: none; }
}

.cb-box-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}
.cb-box-tab {
  appearance: none;
  border: 1px solid rgba(var(--cb-accent-rgb), 0.28);
  background: color-mix(in srgb, var(--cb-surface) 65%, transparent);
  color: var(--cb-muted);
  padding: 8px 14px;
  cursor: pointer;
  font-weight: 700;
}
.cb-box-tab.is-active {
  color: var(--cb-text);
  border-color: rgba(var(--cb-accent-rgb), 0.55);
  background: rgba(var(--cb-accent-rgb), 0.16);
  box-shadow: 0 0 0 1px rgba(var(--cb-accent-rgb), 0.2);
}

.cb-about-row {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(120px, 0.7fr);
  gap: 14px;
  align-items: stretch;
  margin-bottom: 40px;
}
.cb-about-copy {
  background: color-mix(in srgb, var(--cb-surface) 55%, transparent);
  border: 1px solid rgba(var(--cb-accent-rgb), 0.16);
  padding: 14px;
  min-height: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-self: stretch;
}
.cb-about-copy p {
  margin: 10px 0 0;
  color: var(--cb-muted);
  white-space: pre-wrap;
  line-height: 1.5;
}
.cb-about-art-img {
  width: min(100%, 200px);
  height: auto;
  object-fit: contain;
  display: block;
  justify-self: center;
  align-self: center;
}
.cb-card-about-img {
  width: min(100%, 160px);
  height: auto;
  object-fit: contain;
  background: var(--cb-navy);
  border: 1px solid rgba(var(--cb-accent-rgb), 0.2);
  padding: 10px;
}

.cb-profile-feed .post {
  cursor: default;
}
.cb-profile-feed.hub-feed {
  width: 100%;
}
.cb-profile-feed .empty-feed {
  padding: 24px;
  color: var(--cb-muted);
}

/* Profile posts blend into page: no card chrome */
#profileFeed .post,
.cb-profile-feed .post,
.cb-profile-feed.hub-feed .post {
  border: none !important;
  box-shadow: none !important;
  background: transparent !important;
  border-radius: 0 !important;
}
#profileFeed .post + .post,
.cb-profile-feed .post + .post {
  border-top: none !important;
}


.cb-business-card {
  aspect-ratio: 3.5 / 2;
  width: min(100%, 720px);
  max-width: 100%;
  margin: 12px auto 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cb-business-card > .cb-card-layout {
  flex: 1;
  min-height: 0;
  height: 100%;
  width: 100%;
  align-self: stretch;
}
.cb-card-layout {
  display: grid;
  grid-template-columns: 1fr 1.2fr 1fr;
  gap: 14px;
  align-items: stretch;
  height: 100%;
}
.cb-card-col {
  background: color-mix(in srgb, var(--cb-surface) 55%, transparent);
  border: 1px solid rgba(var(--cb-accent-rgb), 0.16);
  padding: 16px;
  min-height: 240px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.cb-card-col.cb-card-about,
.cb-card-col.cb-card-socials {
  align-items: stretch;
  text-align: left;
}
.cb-card-col.cb-card-about > *,
.cb-card-col.cb-card-socials > * {
  width: 100%;
}
.cb-card-identity {
  align-items: center;
  justify-content: center;
  text-align: center;
}
.cb-card-avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  object-fit: cover;
  outline: 3px solid var(--cb-navy-2);
  margin-bottom: 10px;
}
.cb-card-col h2 { margin-bottom: 10px; }
.cb-social-list,
.cb-links-stack {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.cb-social-link {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--cb-text);
  border: 1px solid rgba(var(--cb-accent-rgb), 0.22);
  background: color-mix(in srgb, var(--cb-navy) 70%, transparent);
  padding: 10px 12px;
  font-weight: 700;
}
.cb-social-link:hover {
  border-color: var(--cb-accent);
  background: rgba(var(--cb-accent-rgb), 0.12);
}
.cb-social-link i { color: var(--cb-accent); width: 1.2em; text-align: center; }

.cb-links-layout {
  max-width: 420px;
  margin: 8px auto 24px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.cb-links-avatar {
  width: 112px;
  height: 112px;
  border-radius: 50%;
  object-fit: cover;
  outline: 4px solid var(--cb-navy-2);
  margin-bottom: 6px;
}
.cb-links-stack { width: 100%; margin-top: 10px; }

.cb-edit-panel {
  position: fixed;
  inset: 0;
  z-index: 4000;
  background: color-mix(in srgb, var(--cb-navy) 55%, transparent);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 48px 16px;
  overflow: auto;
}
.cb-edit-panel[hidden] { display: none !important; }
.cb-edit-panel-inner {
  width: min(680px, 100%);
  background: var(--cb-navy);
  border: 1px solid rgba(var(--cb-accent-rgb), 0.28);
  padding: 20px;
}
.cb-edit-note { color: var(--cb-muted); margin-top: 0; }
.cb-edit-panel label {
  display: block;
  margin: 12px 0 4px;
  color: var(--cb-muted);
}
.cb-edit-panel input,
.cb-edit-panel textarea,
.cb-edit-panel select {
  width: 100%;
  background: var(--cb-surface);
  border: 1px solid rgba(var(--cb-accent-rgb), 0.28);
  color: var(--cb-text);
  padding: 10px;
}
.cb-edit-upload-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 12px;
}
.cb-edit-socials label { margin-top: 8px; }
.cb-edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 18px;
}
.cb-builder-scaffold {
  margin-top: 16px;
  border: 1px solid rgba(var(--cb-accent-rgb), 0.2);
  padding: 10px 12px;
}
.cb-builder-list {
  list-style: none;
  margin: 10px 0 0;
  padding: 0;
}
.cb-builder-list li {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  padding: 8px;
  border: 1px solid rgba(var(--cb-accent-rgb), 0.14);
  margin-bottom: 6px;
}

.cb-share-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  overflow: visible;
  z-index: 20;
}
.cb-share-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  z-index: 4000;
  min-width: 220px;
  background: var(--cb-navy);
  border: 1px solid rgba(var(--cb-accent-rgb), 0.35);
  padding: 6px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
}
.cb-share-menu[hidden] { display: none !important; }
.cb-share-menu button {
  appearance: none;
  border: 0;
  background: transparent;
  color: var(--cb-text);
  text-align: left;
  padding: 10px 12px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 2px;
  align-items: flex-start;
}
.cb-share-menu button:hover { background: rgba(var(--cb-accent-rgb), 0.16); }
.cb-share-eg {
  font-size: 0.78em;
  color: var(--cb-muted);
  font-weight: 500;
}

/* Keep legacy carrd bits harmless if referenced */
.carrd-toolbar, .carrd-fab-row { display: none !important; }

@media (max-width: 900px) {
  .cb-profile-body { grid-template-columns: 1fr; }
  .cb-profile-left { position: static; }
  .cb-card-layout { grid-template-columns: 1fr; }
  .cb-about-row { grid-template-columns: 1fr; }
  .cb-edit-upload-row { grid-template-columns: 1fr; }
  .cb-profile-right-top { flex-direction: column; align-items: stretch; }
}
