  function activeThreadN() {
    if (miniRoot) return Number(miniActiveN) || 0;
    return Number(parseRoute().n) || 0;
  }

  function mediaTypeFromFile(file) {
    var t = (file && file.type) || "";
    if (t.indexOf("audio/") === 0) return "audio";
    if (t.indexOf("video/") === 0) return "video";
    return "image";
  }

  function mediaLabel(media) {
    if (!media) return "";
    if (media.type === "video") return "Video";
    if (media.type === "audio") return "Audio";
    return "Photo";
  }

  function clearPendingPreview(isMini) {
    if (isMini) {
      miniPendingMedia = null;
      var prev = miniRoot && miniRoot.querySelector("#msgMiniMediaPreview");
      var input = miniRoot && miniRoot.querySelector("#msgMiniMediaInput");
      if (prev) { prev.hidden = true; prev.innerHTML = ""; }
      if (input) input.value = "";
    } else {
      pendingMedia = null;
      var prev2 = document.getElementById("msgMediaPreview");
      var input2 = document.getElementById("msgMediaInput");
      if (prev2) { prev2.hidden = true; prev2.innerHTML = ""; }
      if (input2) input2.value = "";
    }
  }

  function renderPendingPreview(isMini) {
    var media = isMini ? miniPendingMedia : pendingMedia;
    var prev = isMini
      ? (miniRoot && miniRoot.querySelector("#msgMiniMediaPreview"))
      : document.getElementById("msgMediaPreview");
    if (!prev) return;
    if (!media || !media.url) {
      prev.hidden = true;
      prev.innerHTML = "";
      return;
    }
    var clearId = isMini ? "msgMiniMediaClear" : "msgMediaClear";
    var inner = "";
    if (media.type === "video") {
      inner = '<video class="cb-msg-attach-thumb" src="' + media.url + '" muted playsinline></video>';
    } else if (media.type === "audio") {
      inner =
        '<span class="cb-msg-attach-audio-chip">' +
          '<i class="fa-solid fa-music" aria-hidden="true"></i> ' +
          escapeHtml(media.name || "Audio") +
        "</span>";
    } else {
      inner = '<img class="cb-msg-attach-thumb" src="' + media.url + '" alt="">';
    }
    prev.innerHTML =
      inner +
      '<button type="button" class="cb-msg-attach-clear" id="' + clearId + '" aria-label="Remove media">&times;</button>';
    prev.hidden = false;
  }

  function readMediaFile(file, isMini) {
    if (!file) return;
    if (file.size > MAX_MEDIA_BYTES) {
      toast("File too large for Messages (max ~20 MB)");
      return;
    }
    var reader = new FileReader();
    reader.onload = function (e) {
      var media = {
        type: mediaTypeFromFile(file),
        url: e.target.result,
        name: file.name || ""
      };
      if (isMini) miniPendingMedia = media;
      else pendingMedia = media;
      renderPendingPreview(isMini);
    };
    reader.onerror = function () {
      toast("Could not read that file");
    };
    reader.readAsDataURL(file);
  }

  function showTyping(name, fromId) {
    var body = chatBodyEl();
