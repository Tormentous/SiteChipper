  function repairGroupLabels() {
    var me = sessionUserId();
    var meName = sessionDisplayName();
    var list = loadAll();
    var changed = false;
    list.forEach(function (t) {
      if (!t || !t.group) return;
      if (!t.groupName && t.title) t.groupName = t.title;
      // peerId "6" is a member, not the room title.
      if (String(t.peerId) === "6" || String(t.peerId) === "group_chipper" || /chipper/i.test(String(t.groupName || t.title || ""))) {
        t.groupName = "Chipper Corner";
        t.title = "Chipper Corner";
        if (String(t.peerId) === "6") t.peerId = "group_chipper";
        if (!t.groupImage) t.groupImage = "/img/PlanetChipperHomepage.png";
        if (!Array.isArray(t.members) || !t.members.length) t.members = ["6", "3", "12", me].filter(Boolean);
        changed = true;
      }
      var title = String(t.title || t.groupName || "");
      if (meName && title && title.toLowerCase() === String(meName).toLowerCase()) {
        t.title = t.groupName || "Chipper Corner";
        changed = true;
      }
      // Remap legacy seed "from":"0" bubbles onto current session user when appropriate.
      (t.messages || []).forEach(function (m) {
        if (!m) return;
        if (me && (String(m.from) === "0" || String(m.from) === "2") && String(m.from) !== String(me)) {
          // Only remap placeholder "me" markers, not demo Cardbrador chatter.
          if (String(m.from) === "0") { m.from = me; changed = true; }
        }
      });
    });
    if (changed) saveAll(list);
  }

  function sortedThreads() {
    return loadAll().slice().sort(function (a, b) {
      var la = lastMessage(a);
      var lb = lastMessage(b);
      var ta = la ? Date.parse(la.ts) || 0 : 0;
      var tb = lb ? Date.parse(lb.ts) || 0 : 0;
      return tb - ta;
    });
  }

  function previewLine(thread) {
    var last = lastMessage(thread);
    if (!last) return "No messages yet";
    var mine = String(last.from) === String(sessionUserId());
    var who = mine ? "You: " : "";
    var text = String(last.text || "").trim();
    if (text) return who + clip(text, 42);
    if (last.media && last.media.url) return who + mediaLabel(last.media);
    return who + "Message";
  }

  function openThread(n, replace) {
    if (!isMessagesPage()) return;
    n = Number(n) || 0;
    if (!(n > 0)) return;
    clearPendingReply();
    var url = threadUrl(n);
    if (replace) history.replaceState({ msgN: n }, "", url);
    else history.pushState({ msgN: n }, "", url);
    render();
  }

  function threadListHtml(activeN, filter, compact) {
    filter = String(filter || "").toLowerCase().trim();
    var threads = sortedThreads().filter(function (t) {
      if (!filter) return true;
      return String(threadDisplayTitle(t) || "").toLowerCase().indexOf(filter) >= 0 ||
        previewLine(t).toLowerCase().indexOf(filter) >= 0;
    });
    if (!threads.length) {
      return '<p class="cb-msg-list-empty">No chats match.</p>';
    }
    return threads.map(function (t) {
      var last = lastMessage(t);
      var active = Number(t.n) === Number(activeN);
      return (
        '<button type="button" class="cb-msg-thread' + (active ? " is-active" : "") + (compact ? " cb-msg-thread-compact" : "") + '" role="listitem" data-thread-n="' + t.n + '">' +
          '<img class="cb-msg-avatar" src="' + escapeHtml(threadAvatar(t)) + '" alt="">' +
          '<span class="cb-msg-thread-body">' +
            '<span class="cb-msg-thread-top">' +
              "<strong>" + escapeHtml(threadDisplayTitle(t)) + "</strong>" +
              '<span class="cb-msg-time">' + escapeHtml(last ? timeAgo(last.ts) : "") + "</span>" +
            "</span>" +
            '<span class="cb-msg-preview">' + escapeHtml(previewLine(t)) + "</span>" +
          "</span>" +
        "</button>"
      );
    }).join("");
  }

  function renderList(activeN, filter) {
    var box = document.getElementById("msgThreadList");
    if (!box) return;
    box.innerHTML = threadListHtml(activeN, filter, false);
  }

  function mediaHtml(media) {
    if (!media || !media.url) return "";
    if (media.type === "video") {
      return '<video class="cb-msg-media-video" src="' + media.url + '" controls playsinline></video>';
    }
    if (media.type === "audio") {
      return (
        '<div class="cb-msg-media-audio">' +
          '<audio controls src="' + media.url + '"></audio>' +
          '<span class="cb-msg-media-name">' + escapeHtml(media.name || "Audio") + "</span>" +
        "</div>"
      );
    }
    return '<img class="cb-msg-media-img" src="' + media.url + '" alt="">';
  }

  function bubblesHtml(thread) {
    if (!thread) return "";
    var me = sessionUserId();
    return (thread.messages || []).map(function (m, i, arr) {
      var mine = String(m.from) === String(me);
      var prev = arr[i - 1];
      var showHead = !mine && (!prev || String(prev.from) !== String(m.from));
      var name = "";
      if (showHead) {
        try {
          var u = JSON.parse(localStorage.getItem("user_" + m.from) || "{}");
          name = u.displayName || u.username || thread.title;
        } catch (e) {
          name = thread.title;
        }
      }
      var pfp = "";
      if (!mine) {
        if (showHead) {
          pfp = '<img class="cb-msg-bubble-pfp" src="' + escapeHtml(getPfp(m.from)) + '" alt="">';
        } else {
          pfp = '<span class="cb-msg-bubble-pfp-spacer" aria-hidden="true"></span>';
        }
      }
      var text = String(m.text || "");
      var textHtml = text ? escapeHtml(text) : "";
      var mHtml = mediaHtml(m.media);
      var bubbleClass = "cb-msg-bubble" + (mHtml && !textHtml ? " cb-msg-bubble-media-only" : "") + (mHtml ? " has-media" : "");
      var bubbleInner = textHtml + mHtml;
      return (
        '<div class="cb-msg-bubble-row' + (mine ? " is-me" : "") + (showHead ? " is-head" : "") + '">' +
          '<div class="cb-msg-row-inner">' +
            pfp +
            '<div class="cb-msg-bubble-col">' +
              (showHead ? '<div class="cb-msg-sender">' + escapeHtml(name) + "</div>" : "") +
              '<div class="' + bubbleClass + '">' + bubbleInner + "</div>" +
            "</div>" +
          "</div>" +
        "</div>"
      );
    }).join("");
  }

  function renderChat(thread) {
    var chat = document.getElementById("msgChat");
    var head = document.getElementById("msgChatHead");
    var body = document.getElementById("msgChatBody");
    if (!thread) {
      if (chat) chat.hidden = true;
      return;
    }
    if (chat) chat.hidden = false;
    if (!head || !body) return;

    var title = threadDisplayTitle(thread);
    var avatar = threadAvatar(thread);
    var sub = thread.group
      ? ('Group chat - #' + thread.n +
          ' · <button type="button" class="cb-msg-group-edit-btn" data-group-edit="' + thread.n + '">Edit group</button>')
      : ('Direct message - #' + thread.n +
          ' · <a class="cb-msg-profile-link" href="/users/' + encodeURIComponent(thread.peerId || "0") + '">Profile</a>');
    head.innerHTML =
      '<div class="cb-msg-chat-peer">' +
        '<img class="cb-msg-avatar" src="' + escapeHtml(avatar) + '" alt="">' +
        "<div>" +
          "<strong>" + escapeHtml(title) + "</strong>" +
          '<span class="cb-msg-sub">' + sub + "</span>" +
        "</div>" +
      "</div>";

    body.innerHTML = bubblesHtml(thread);
    body.scrollTop = body.scrollHeight;
  }

  function openGroupEdit(threadN) {
    var thread = getByNumber(threadN);
    if (!thread || !thread.group) return;
    var name = window.prompt("Group name", threadDisplayTitle(thread));
    if (name == null) return;
    name = String(name).trim();
    if (!name) name = "Chipper Corner";
    var img = window.prompt("Group image URL (leave blank to keep)", thread.groupImage || "");
    if (img == null) img = thread.groupImage || "";
    img = String(img).trim();
    updateThreadFields(threadN, {
      groupName: name,
      title: name,
      groupImage: img || thread.groupImage || ""
    });
    refreshActiveUi();
  }

  function appendPeerReply(threadN, fromId, text) {
    var list = loadAll();
    var thread = list.find(function (t) { return Number(t.n) === Number(threadN); });
    if (!thread) return;
    thread.messages = thread.messages || [];
    thread.messages.push({
      id: "m-" + Date.now() + "-r",
      from: String(fromId || thread.peerId || "1"),
      text: text,
      ts: new Date().toISOString()
    });
    saveAll(list);
  }

  function refreshActiveUi() {
    if (miniRoot) renderMini();
    else if (isMessagesPage()) render();
  }

  function scheduleAutoReply(threadN) {
    clearPendingReply();
    var thread = getByNumber(threadN);
    if (!thread) return;
    var name = thread.group ? "Chipper Corner" : (thread.title || "Lab");
    var thinkMs = 1000 + Math.floor(Math.random() * 900);
    typingTimer = setTimeout(function () {
      if (Number(activeThreadN()) !== Number(threadN)) return;
      var typingFrom = thread.group
        ? (["6", "3", "12", "5"][Math.floor(Math.random() * 4)])
        : thread.peerId;
      showTyping(name, typingFrom);
      replyTimer = setTimeout(function () {
        if (Number(activeThreadN()) !== Number(threadN)) return;
        hideTyping();
        var fromId = thread.group ? (["6", "3", "12", "5"][Math.floor(Math.random() * 4)]) : thread.peerId;
        appendPeerReply(threadN, fromId, pickAutoReply(thread));
        refreshActiveUi();
      }, 700 + Math.floor(Math.random() * 500));
    }, thinkMs);
  }

  function sendMessage(threadN, text, media) {
    text = String(text || "").trim();
    media = media && media.url ? media : null;
    if (!text && !media) return false;
    var list = loadAll();
    var thread = list.find(function (t) { return Number(t.n) === Number(threadN); });
    if (!thread) return false;
    thread.messages = thread.messages || [];
    var fromId = sessionUserId();
    if (!fromId) {
      toast("Sign in to send messages");
      return false;
    }
    var msg = {
      id: "m-" + Date.now(),
      from: fromId,
      text: text,
      ts: new Date().toISOString()
    };
    if (media) {
      msg.media = {
        type: media.type === "video" || media.type === "audio" ? media.type : "image",
        url: media.url
      };
      if (media.name) msg.media.name = String(media.name);
    }
    thread.messages.push(msg);
    saveAll(list);
    return true;
  }

  function render() {
    if (!isMessagesPage()) return;
    seedIfNeeded();
    var route = parseRoute();
    if (!(route.n > 0)) {
      var first = sortedThreads()[0];
      if (first && first.n) {
        history.replaceState({ msgN: first.n }, "", threadUrl(first.n));
        route = { n: first.n };
      }
    }
    var thread = route.n > 0 ? getByNumber(route.n) : null;
    var search = document.getElementById("msgSearch");
    renderList(route.n, search && search.value);
    renderChat(thread);
    document.title = thread ? threadDisplayTitle(thread) + " - Messages - Coolbrador" : "Messages - Coolbrador";
    var shell = document.getElementById("messagesRoot");
    if (shell) shell.classList.toggle("show-chat", !!thread);
  }

  function renderMini() {
    if (!miniRoot) return;
    seedIfNeeded();
    var listPane = miniRoot.querySelector(".cb-msg-mini-list");
    var chatPane = miniRoot.querySelector(".cb-msg-mini-chat");
    var body = miniRoot.querySelector("#msgMiniChatBody");
    var head = miniRoot.querySelector("#msgMiniChatHead");
    if (!listPane || !chatPane) return;

    if (miniView === "chat" && miniActiveN > 0) {
      var thread = getByNumber(miniActiveN);
      if (!thread) {
        miniView = "list";
        miniActiveN = 0;
      } else {
        listPane.hidden = true;
        chatPane.hidden = false;
        if (head) {
          head.innerHTML =
            '<button type="button" class="cb-msg-mini-back" data-mini-back="1" aria-label="Back to list">' +
              '<i class="fa-solid fa-arrow-left" aria-hidden="true"></i>' +
            "</button>" +
            '<img class="cb-msg-avatar" src="' + escapeHtml(threadAvatar(thread)) + '" alt="">' +
            '<div class="cb-msg-mini-peer">' +
              "<strong>" + escapeHtml(threadDisplayTitle(thread)) + "</strong>" +
              '<span class="cb-msg-sub">' + (thread.group ? "Group" : "DM") + " · #" + thread.n + "</span>" +
            "</div>";
        }
        if (body) {
          body.innerHTML = bubblesHtml(thread);
          body.scrollTop = body.scrollHeight;
        }
        return;
      }
    }

    listPane.hidden = false;
    chatPane.hidden = true;
    listPane.innerHTML = threadListHtml(miniActiveN, "", true);
  }

  function openMiniThread(n) {
    n = Number(n) || 0;
    if (!(n > 0)) return;
    clearPendingReply();
    miniActiveN = n;
    miniView = "chat";
    renderMini();
  }

  function miniBackToList() {
    clearPendingReply();
    miniView = "list";
    renderMini();
  }

  function ensureMiniShell() {
    if (!miniRoot) return;
    if (miniRoot.querySelector(".cb-msg-mini")) return;
    miniRoot.innerHTML =
      '<div class="cb-msg-mini">' +
        '<div class="cb-msg-mini-list" role="list"></div>' +
        '<div class="cb-msg-mini-chat" hidden>' +
          '<header class="cb-msg-mini-chat-head" id="msgMiniChatHead"></header>' +
          '<div class="cb-msg-chat-body cb-msg-mini-body" id="msgMiniChatBody"></div>' +
          '<form class="cb-msg-composer cb-msg-mini-composer" id="msgMiniComposer">' +
            '<div class="cb-msg-media-preview" id="msgMiniMediaPreview" hidden></div>' +
            '<div class="cb-msg-composer-row">' +
              '<button type="button" class="cb-msg-attach-btn" id="msgMiniAttachBtn" title="Attach media" aria-label="Attach media">' +
                '<i class="fa-solid fa-paperclip" aria-hidden="true"></i>' +
              "</button>" +
              '<input type="file" id="msgMiniMediaInput" accept="image/*,video/*,audio/*" hidden>' +
              '<input type="text" id="msgMiniInput" placeholder="Message..." autocomplete="off">' +
              '<button type="submit" class="post-submit-btn">Send</button>' +
            "</div>" +
          "</form>" +
        "</div>" +
      "</div>";
  }

  function wireMini() {
    if (!miniRoot || miniRoot.dataset.wired === "1") return;
    miniRoot.dataset.wired = "1";
    miniRoot.addEventListener("click", function (e) {
      var back = e.target.closest("[data-mini-back]");
      if (back) {
        e.preventDefault();
        miniBackToList();
        return;
      }
      var clearBtn = e.target.closest("#msgMiniMediaClear");
      if (clearBtn && miniRoot.contains(clearBtn)) {
        e.preventDefault();
        clearPendingPreview(true);
        return;
      }
      var attach = e.target.closest("#msgMiniAttachBtn");
      if (attach && miniRoot.contains(attach)) {
        e.preventDefault();
        var fileInput = miniRoot.querySelector("#msgMiniMediaInput");
        if (fileInput) fileInput.click();
        return;
      }
      var btn = e.target.closest(".cb-msg-thread[data-thread-n]");
      if (!btn || !miniRoot.contains(btn)) return;
      e.preventDefault();
      openMiniThread(btn.getAttribute("data-thread-n"));
    });
    miniRoot.addEventListener("change", function (e) {
      var input = e.target.closest("#msgMiniMediaInput");
      if (!input || !miniRoot.contains(input)) return;
      var file = input.files && input.files[0];
      readMediaFile(file, true);
    });
    miniRoot.addEventListener("submit", function (e) {
      var form = e.target.closest("#msgMiniComposer");
      if (!form || !miniRoot.contains(form)) return;
      e.preventDefault();
      if (!(miniActiveN > 0)) return;
      var input = miniRoot.querySelector("#msgMiniInput");
      var text = input && input.value;
      var media = miniPendingMedia;
      if (!sendMessage(miniActiveN, text, media)) return;
      if (input) input.value = "";
      clearPendingPreview(true);
      renderMini();
      scheduleAutoReply(miniActiveN);
    });
  }

  function mountMini(rootEl) {
    if (!rootEl) return;
    seedIfNeeded();
    miniRoot = rootEl;
    ensureMiniShell();
    wireMini();
    if (!(miniActiveN > 0)) miniView = "list";
    renderMini();
  }

  function unmountMini() {
    clearPendingReply();
    clearPendingPreview(true);
    if (miniRoot) {
      delete miniRoot.dataset.wired;
      miniRoot.innerHTML = "";
    }
    miniRoot = null;
    miniView = "list";
  }

  function toggleMini(rootEl) {
    if (miniRoot) {
      unmountMini();
      return false;
    }
    mountMini(rootEl);
    return true;
  }

  function wire() {
    if (!isMessagesPage()) return;
    var chatHead = document.getElementById("msgChatHead");
    if (chatHead && !chatHead.dataset.groupEditWired) {
      chatHead.dataset.groupEditWired = "1";
      chatHead.addEventListener("click", function (e) {
        var edit = e.target.closest("[data-group-edit]");
        if (!edit) return;
        e.preventDefault();
        openGroupEdit(edit.getAttribute("data-group-edit"));
      });
    }

    var list = document.getElementById("msgThreadList");
    if (list && !list.dataset.wired) {
      list.dataset.wired = "1";
      list.addEventListener("click", function (e) {
        var btn = e.target.closest(".cb-msg-thread[data-thread-n]");
        if (!btn) return;
        e.preventDefault();
        openThread(btn.getAttribute("data-thread-n"), false);
      });
    }

    var search = document.getElementById("msgSearch");
    if (search && !search.dataset.wired) {
      search.dataset.wired = "1";
      search.addEventListener("input", function () {
        renderList(parseRoute().n, search.value);
      });
    }

    var form = document.getElementById("msgComposer");
    if (form && !form.dataset.wired) {
      form.dataset.wired = "1";
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var route = parseRoute();
        if (!(route.n > 0)) return;
        var input = document.getElementById("msgInput");
        var text = input && input.value;
        var media = pendingMedia;
        if (!sendMessage(route.n, text, media)) return;
        if (input) input.value = "";
        clearPendingPreview(false);
        render();
        scheduleAutoReply(route.n);
      });
    }

    var attachBtn = document.getElementById("msgAttachBtn");
    var mediaInput = document.getElementById("msgMediaInput");
    if (attachBtn && mediaInput && !attachBtn.dataset.wired) {
      attachBtn.dataset.wired = "1";
      attachBtn.addEventListener("click", function () { mediaInput.click(); });
      mediaInput.addEventListener("change", function () {
        var file = mediaInput.files && mediaInput.files[0];
        readMediaFile(file, false);
      });
    }

    var preview = document.getElementById("msgMediaPreview");
    if (preview && !preview.dataset.wired) {
      preview.dataset.wired = "1";
      preview.addEventListener("click", function (e) {
        if (e.target.closest("#msgMediaClear")) {
          e.preventDefault();
          clearPendingPreview(false);
        }
      });
    }

    var neu = document.getElementById("msgNewBtn");
    if (neu && !neu.dataset.wired) {
      neu.dataset.wired = "1";
      neu.addEventListener("click", function () {
        if (global.CoolbradorPosts && global.CoolbradorPosts.showToast) {
          global.CoolbradorPosts.showToast("Pick a Labrador from Profiles for now");
        }
      });
    }

    if (!global._cbMsgPopWired) {
      global._cbMsgPopWired = true;
      window.addEventListener("popstate", function () {
        if (!isMessagesPage()) return;
        clearPendingReply();
        render();
      });
    }
  }

  function bootPage() {
    if (!isMessagesPage()) return;
    wire();
    render();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootPage);
  } else {
    bootPage();
  }

  global.CoolbradorMessages = {
    render: render,
    seedIfNeeded: seedIfNeeded,
    loadAll: loadAll,
    openThread: openThread,
    parseRoute: parseRoute,
    threadUrl: threadUrl,
    mountMini: mountMini,
    unmountMini: unmountMini,
    toggleMini: toggleMini
  };
})(typeof window !== "undefined" ? window : this);
