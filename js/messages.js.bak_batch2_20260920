          '<div class="cb-msg-bubble cb-msg-typing" aria-label="Typing">' +
            "<span></span><span></span><span></span>" +
          "</div>" +
        "</div>" +
      "</div>";
    body.appendChild(row);
    body.scrollTop = body.scrollHeight;
  }

