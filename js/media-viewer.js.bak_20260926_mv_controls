(function (global) {
  var ZOOM_MIN = 0.5;
  var ZOOM_MAX = 6;
  var ZOOM_STEP = 0.2;
  var FIT_ZOOM = 1;

  var zoom = FIT_ZOOM;
  var panX = 0;
  var panY = 0;
  var dragging = false;
  var dragLastX = 0;
  var dragLastY = 0;
  var current = { url: "", type: "image", name: "media" };
  var playlist = [];
  var playlistIndex = 0;
  var videoEl = null;
  var progressTimer = null;

  function ensureCss() {
    var css = [
      ".cb-mv-root{position:fixed;inset:0;z-index:5000;display:flex;align-items:center;justify-content:center;}",
      ".cb-mv-backdrop{position:absolute;inset:0;background:color-mix(in srgb,var(--cb-navy) 55%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);}",
      ".cb-mv-stage{position:relative;z-index:1;max-width:min(92vw,1100px);max-height:88vh;display:flex;flex-direction:column;align-items:center;gap:12px;}",
      ".cb-mv-media-wrap{position:relative;max-width:100%;max-height:78vh;display:flex;align-items:center;justify-content:center;}",
      ".cb-mv-media-wrap img,.cb-mv-media-wrap video{max-width:100%;max-height:78vh;object-fit:contain;transform-origin:center center;transition:transform .15s ease;box-shadow:0 20px 60px rgba(0,0,0,.45);background:var(--cb-surface);user-select:none;-webkit-user-drag:none;}",
      ".cb-mv-media-wrap.is-panning img{transition:none;}",
      ".cb-mv-media-wrap.is-pannable{touch-action:none;}",
      ".cb-mv-media-wrap.is-pannable,.cb-mv-media-wrap.is-pannable img{cursor:grab;}",
      ".cb-mv-media-wrap.is-panning,.cb-mv-media-wrap.is-panning img{cursor:grabbing;}",
      ".cb-mv-top{position:absolute;top:14px;right:14px;z-index:2;display:flex;gap:8px;}",
      ".cb-mv-zoom{position:absolute;top:14px;left:14px;z-index:2;display:flex;gap:8px;}",
      ".cb-mv-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:2;}",
      ".cb-mv-nav-prev{left:14px;}",
      ".cb-mv-nav-next{right:14px;}",
      ".cb-mv-nav[hidden]{display:none!important;}",
      ".cb-mv-nav:disabled,.cb-mv-nav[aria-disabled=\"true\"]{opacity:.35;cursor:default;pointer-events:none;}",
      ".cb-mv-counter{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);z-index:2;padding:6px 12px;background:color-mix(in srgb,var(--cb-surface) 88%,transparent);border:1px solid rgba(var(--cb-accent-rgb),0.35);color:var(--cb-muted);font-size:0.85rem;}",
      ".cb-mv-counter[hidden]{display:none!important;}",
      ".cb-mv-btn{appearance:none;border:1px solid rgba(var(--cb-accent-rgb),0.35);background:color-mix(in srgb,var(--cb-surface) 88%,transparent);color:var(--cb-text);width:40px;height:40px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;}",
      ".cb-mv-btn:hover{border-color:var(--cb-accent);background:rgba(var(--cb-accent-rgb),0.18);}",
      ".cb-mv-menu{position:absolute;top:58px;right:14px;z-index:3;min-width:160px;background:var(--cb-navy);border:1px solid rgba(var(--cb-accent-rgb),0.35);padding:6px;display:flex;flex-direction:column;gap:2px;}",
      ".cb-mv-menu[hidden]{display:none!important;}",
      ".cb-mv-menu button{appearance:none;border:0;background:transparent;color:var(--cb-text);text-align:left;padding:10px 12px;cursor:pointer;}",
      ".cb-mv-menu button:hover{background:rgba(var(--cb-accent-rgb),0.16);}",
      ".cb-mv-media-wrap video{accent-color:var(--cb-accent);}",
      ".cb-mv-media-wrap video::-webkit-media-controls-panel{background:color-mix(in srgb,var(--cb-navy) 70%,transparent);}",
      ".cb-mv-media-wrap video::-webkit-media-controls-current-time-display,.cb-mv-media-wrap video::-webkit-media-controls-time-remaining-display{color:var(--cb-text);}",
      ".cb-mv-controls{width:min(100%,720px);display:flex;flex-direction:column;gap:8px;padding:8px 4px 0;}",
      ".cb-mv-progress{appearance:none;-webkit-appearance:none;width:100%;height:8px;border-radius:999px;background:rgba(var(--cb-accent-rgb),0.18);outline:none;cursor:pointer;}",
      ".cb-mv-progress::-webkit-slider-runnable-track{height:8px;border-radius:999px;background:linear-gradient(90deg,var(--cb-accent),var(--cb-accent-2)) 0/var(--cb-mv-progress,0%) 100% no-repeat,rgba(var(--cb-accent-rgb),0.18);}",
      ".cb-mv-progress::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;margin-top:-3px;background:var(--cb-accent);border:2px solid var(--cb-surface);box-shadow:0 0 0 2px rgba(var(--cb-accent-rgb),0.35);}",
      ".cb-mv-progress::-moz-range-track{height:8px;border-radius:999px;background:rgba(var(--cb-accent-rgb),0.18);}",
      ".cb-mv-progress::-moz-range-progress{height:8px;border-radius:999px;background:linear-gradient(90deg,var(--cb-accent),var(--cb-accent-2));}",
      ".cb-mv-progress::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:var(--cb-accent);border:2px solid var(--cb-surface);}",
      ".cb-mv-control-row{display:flex;align-items:center;gap:10px;}",
      ".cb-mv-time{font-size:0.78rem;color:var(--cb-muted);min-width:88px;}"
    ].join("");
    var style = document.getElementById("cb-media-viewer-css");
    if (!style) {
      style = document.createElement("style");
      style.id = "cb-media-viewer-css";
      document.head.appendChild(style);
    }
    style.textContent = css;
  }

  function resetView() {
    zoom = FIT_ZOOM;
    panX = 0;
    panY = 0;
    dragging = false;
  }

  function clearVideo() {
    if (progressTimer) { clearInterval(progressTimer); progressTimer = null; }
    videoEl = null;
  }

  function close() {
    clearVideo();
    var root = document.getElementById("cbMediaViewer");
    if (root) root.remove();
    document.removeEventListener("keydown", onKey);
    playlist = [];
    playlistIndex = 0;
    resetView();
  }

  function isTypingTarget(el) {
    if (!el) return false;
    if (el.isContentEditable) return true;
    var tag = (el.tagName || "").toLowerCase();
    if (tag === "textarea" || tag === "select") return true;
    if (tag === "input") {
      var type = (el.type || "text").toLowerCase();
      return type !== "button" && type !== "submit" && type !== "checkbox" &&
        type !== "radio" && type !== "file" && type !== "range" && type !== "reset";
    }
    return false;
  }

  function onKey(e) {
    if (isTypingTarget(e.target)) return;
    if (e.key === "Escape") {
      close();
      return;
    }
    if (e.key === "ArrowLeft") {
      e.preventDefault();
      goTo(playlistIndex - 1);
      return;
    }
    if (e.key === "ArrowRight") {
      e.preventDefault();
      goTo(playlistIndex + 1);
      return;
    }
    if (e.key === "+" || e.key === "=" || e.key === "i" || e.key === "I" || e.code === "NumpadAdd") {
      e.preventDefault();
      setZoom(zoom + ZOOM_STEP);
      return;
    }
    if (e.key === "-" || e.key === "_" || e.key === "o" || e.key === "O" || e.code === "NumpadSubtract") {
      e.preventDefault();
      setZoom(zoom - ZOOM_STEP);
    }
  }

  function mediaEl() {
    return document.querySelector("#cbMediaViewer .cb-mv-media");
  }

  function wrapEl() {
    return document.querySelector("#cbMediaViewer .cb-mv-media-wrap");
  }

  function rootEl() {
    return document.getElementById("cbMediaViewer");
  }

  function applyTransform() {
    var media = mediaEl();
    if (!media) return;
    media.style.transform = "translate(" + panX + "px," + panY + "px) scale(" + zoom + ")";
    updateCursor();
  }

  function updateCursor() {
    var wrap = wrapEl();
    if (!wrap) return;
    if (current.type === "image" && zoom > FIT_ZOOM) wrap.classList.add("is-pannable");
    else wrap.classList.remove("is-pannable");
    if (!dragging) wrap.classList.remove("is-panning");
  }

  function setZoom(z) {
    zoom = Math.max(ZOOM_MIN, Math.min(ZOOM_MAX, z));
    if (zoom <= FIT_ZOOM) {
      panX = 0;
      panY = 0;
      dragging = false;
    }
    applyTransform();
  }

  function onWheel(e) {
    e.preventDefault();
    var dy = e.deltaY;
    if (!dy && e.deltaX) dy = e.deltaX;
    setZoom(zoom + (dy > 0 ? -ZOOM_STEP : ZOOM_STEP));
  }

  function onPointerDown(e) {
    if (current.type !== "image") return;
    if (zoom <= FIT_ZOOM) return;
    if (e.button != null && e.button !== 0) return;
    dragging = true;
    dragLastX = e.clientX;
    dragLastY = e.clientY;
    var wrap = wrapEl();
    if (wrap) {
      wrap.classList.add("is-panning");
      if (wrap.setPointerCapture && e.pointerId != null) {
        try { wrap.setPointerCapture(e.pointerId); } catch (err) {}
      }
    }
    e.preventDefault();
  }

  function onPointerMove(e) {
    if (!dragging) return;
    panX += e.clientX - dragLastX;
    panY += e.clientY - dragLastY;
    dragLastX = e.clientX;
    dragLastY = e.clientY;
    applyTransform();
  }

  function onPointerUp() {
    if (!dragging) return;
    dragging = false;
    var wrap = wrapEl();
    if (wrap) wrap.classList.remove("is-panning");
  }

  function wirePan(wrap) {
    if (!wrap || wrap._cbMvPan) return;
    wrap._cbMvPan = true;
    wrap.addEventListener("pointerdown", onPointerDown);
    wrap.addEventListener("pointermove", onPointerMove);
    wrap.addEventListener("pointerup", onPointerUp);
    wrap.addEventListener("pointercancel", onPointerUp);
    wrap.addEventListener("lostpointercapture", onPointerUp);
  }

  function save() {
    var a = document.createElement("a");
    a.href = current.url;
    a.download = current.name || "coolbrador-media";
    a.target = "_blank";
    a.rel = "noopener";
    document.body.appendChild(a);
    a.click();
    a.remove();
  }

  function report() {
    alert("Thanks. Report noted for this media. Moderators will take a look.");
  }

  function fmtTime(sec) {
    sec = Math.max(0, Math.floor(sec || 0));
    var m = Math.floor(sec / 60);
    var s = sec % 60;
    return m + ":" + (s < 10 ? "0" : "") + s;
  }

  function escAttr(s) {
    return String(s || "").replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
  }

  function normalizeItem(raw) {
    if (!raw) return null;
    if (typeof raw === "string") {
      return {
        url: raw,
        type: /\.(mp4|webm|ogg)(\?|$)/i.test(raw) ? "video" : "image",
        name: "coolbrador-media"
      };
    }
    var url = raw.url || raw.src || "";
    if (!url) return null;
    var type = raw.type || ((/\.(mp4|webm|ogg)(\?|$)/i.test(url) || raw.kind === "video") ? "video" : "image");
    return {
      url: url,
      type: type === "video" ? "video" : "image",
      name: raw.name || raw.label || "coolbrador-media"
    };
  }

  function normalizePlaylist(opts) {
    opts = opts || {};
    var items = [];
    if (Array.isArray(opts.items) && opts.items.length) {
      opts.items.forEach(function (it) {
        var n = normalizeItem(it);
        if (n) items.push(n);
      });
    }
    if (!items.length) {
      var single = normalizeItem(opts);
      if (single) items.push(single);
    }
    var index = opts.index != null ? Number(opts.index) : 0;
    if (!isFinite(index) || index < 0) index = 0;
    if (index >= items.length) index = Math.max(0, items.length - 1);
    if (opts.url || opts.src) {
      var want = opts.url || opts.src;
      for (var i = 0; i < items.length; i++) {
        if (items[i].url === want) { index = i; break; }
      }
    }
    return { items: items, index: index };
  }

  function wireVideoControls(root, video) {
    clearVideo();
    videoEl = video;
    video.controls = false;
    video.removeAttribute("controls");
    var controls = root.querySelector(".cb-mv-controls");
    if (!controls) return;
    var bar = controls.querySelector(".cb-mv-progress");
    var playBtn = controls.querySelector("[data-cb-mv-play]");
    var timeEl = controls.querySelector(".cb-mv-time");

    function sync() {
      if (!videoEl) return;
      var dur = videoEl.duration || 0;
      var cur = videoEl.currentTime || 0;
      var pct = dur ? (cur / dur) * 100 : 0;
      if (bar) {
        bar.value = String(pct);
        bar.style.setProperty("--cb-mv-progress", pct + "%");
      }
      if (timeEl) timeEl.textContent = fmtTime(cur) + " / " + fmtTime(dur);
      if (playBtn) {
        playBtn.innerHTML = videoEl.paused
          ? '<i class="fa-solid fa-play" aria-hidden="true"></i>'
          : '<i class="fa-solid fa-pause" aria-hidden="true"></i>';
        playBtn.setAttribute("aria-label", videoEl.paused ? "Play" : "Pause");
      }
    }

    playBtn.addEventListener("click", function () {
      if (videoEl.paused) videoEl.play();
      else videoEl.pause();
      sync();
    });
    bar.addEventListener("input", function () {
      var dur = videoEl.duration || 0;
      videoEl.currentTime = dur * (Number(bar.value) / 100);
      sync();
    });
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    video.addEventListener("timeupdate", sync);
    video.addEventListener("loadedmetadata", sync);
    progressTimer = setInterval(sync, 250);
    sync();
    try { video.play(); } catch (e) {}
  }

  function updateNavUi() {
    var root = rootEl();
    if (!root) return;
    var multi = playlist.length > 1;
    var prev = root.querySelector("[data-cb-mv-prev]");
    var next = root.querySelector("[data-cb-mv-next]");
    var counter = root.querySelector(".cb-mv-counter");
    if (prev) {
      prev.hidden = !multi;
      prev.disabled = playlistIndex <= 0;
      prev.setAttribute("aria-disabled", playlistIndex <= 0 ? "true" : "false");
    }
    if (next) {
      next.hidden = !multi;
      next.disabled = playlistIndex >= playlist.length - 1;
      next.setAttribute("aria-disabled", playlistIndex >= playlist.length - 1 ? "true" : "false");
    }
    if (counter) {
      if (multi) {
        counter.hidden = false;
        counter.textContent = (playlistIndex + 1) + " / " + playlist.length;
      } else {
        counter.hidden = true;
      }
    }
  }

  function renderCurrentMedia() {
    var root = rootEl();
    if (!root || !current || !current.url) return;
    clearVideo();
    resetView();

    var wrap = root.querySelector(".cb-mv-media-wrap");
    var stage = root.querySelector(".cb-mv-stage");
    if (!wrap || !stage) return;

    var mediaHtml = current.type === "video"
      ? '<video class="cb-mv-media" src="' + escAttr(current.url) + '" playsinline></video>'
      : '<img class="cb-mv-media" src="' + escAttr(current.url) + '" alt="" draggable="false">';
    wrap.innerHTML = mediaHtml;

    var oldControls = stage.querySelector(".cb-mv-controls");
    if (oldControls) oldControls.remove();

    if (current.type === "video") {
      var controlsHtml =
        '<div class="cb-mv-controls">' +
          '<input class="cb-mv-progress" type="range" min="0" max="100" step="0.1" value="0" aria-label="Seek">' +
          '<div class="cb-mv-control-row">' +
            '<button type="button" class="cb-mv-btn" data-cb-mv-play aria-label="Play"><i class="fa-solid fa-play"></i></button>' +
            '<span class="cb-mv-time">0:00 / 0:00</span>' +
          "</div></div>";
      stage.insertAdjacentHTML("beforeend", controlsHtml);
      var video = wrap.querySelector("video.cb-mv-media");
      if (video) wireVideoControls(root, video);
    } else {
      wirePan(wrap);
    }

    updateNavUi();
    applyTransform();
  }

  function goTo(index) {
    if (!playlist.length) return;
    if (index < 0 || index >= playlist.length) return;
    if (index === playlistIndex && mediaEl()) {
      updateNavUi();
      return;
    }
    playlistIndex = index;
    current = playlist[playlistIndex];
    renderCurrentMedia();
  }

  function open(opts) {
    ensureCss();
    close();
    var normalized = normalizePlaylist(opts);
    playlist = normalized.items;
    playlistIndex = normalized.index;
    if (!playlist.length) return;
    current = playlist[playlistIndex];

    var root = document.createElement("div");
    root.id = "cbMediaViewer";
    root.className = "cb-mv-root";
    root.setAttribute("role", "dialog");
    root.setAttribute("aria-modal", "true");
    root.setAttribute("aria-label", "Media viewer");

    root.innerHTML =
      '<div class="cb-mv-backdrop" data-cb-mv-close></div>' +
      '<div class="cb-mv-zoom">' +
      '<button type="button" class="cb-mv-btn" data-cb-mv-zoom-out aria-label="Zoom out"><i class="fa-solid fa-minus"></i></button>' +
      '<button type="button" class="cb-mv-btn" data-cb-mv-zoom-in aria-label="Zoom in"><i class="fa-solid fa-plus"></i></button>' +
      "</div>" +
      '<div class="cb-mv-top">' +
      '<button type="button" class="cb-mv-btn" data-cb-mv-more title="More" aria-label="More"><i class="fa-solid fa-ellipsis-vertical"></i></button>' +
      '<button type="button" class="cb-mv-btn" data-cb-mv-close title="Close" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>' +
      "</div>" +
      '<button type="button" class="cb-mv-btn cb-mv-nav cb-mv-nav-prev" data-cb-mv-prev aria-label="Previous" hidden><i class="fa-solid fa-chevron-left"></i></button>' +
      '<button type="button" class="cb-mv-btn cb-mv-nav cb-mv-nav-next" data-cb-mv-next aria-label="Next" hidden><i class="fa-solid fa-chevron-right"></i></button>' +
      '<div class="cb-mv-menu" hidden>' +
      '<button type="button" data-cb-mv-save>Save</button>' +
      '<button type="button" data-cb-mv-report>Report</button>' +
      "</div>" +
      '<div class="cb-mv-stage">' +
      '<div class="cb-mv-media-wrap"></div>' +
      "</div>" +
      '<div class="cb-mv-counter" hidden></div>';

    document.body.appendChild(root);
    document.addEventListener("keydown", onKey);
    root.addEventListener("wheel", onWheel, { passive: false });

    root.querySelectorAll("[data-cb-mv-close]").forEach(function (el) {
      el.addEventListener("click", close);
    });
    var menu = root.querySelector(".cb-mv-menu");
    root.querySelector("[data-cb-mv-more]").addEventListener("click", function (e) {
      e.stopPropagation();
      menu.hidden = !menu.hidden;
    });
    root.querySelector("[data-cb-mv-save]").addEventListener("click", save);
    root.querySelector("[data-cb-mv-report]").addEventListener("click", report);
    root.querySelector("[data-cb-mv-zoom-in]").addEventListener("click", function () { setZoom(zoom + ZOOM_STEP); });
    root.querySelector("[data-cb-mv-zoom-out]").addEventListener("click", function () { setZoom(zoom - ZOOM_STEP); });
    root.querySelector("[data-cb-mv-prev]").addEventListener("click", function () { goTo(playlistIndex - 1); });
    root.querySelector("[data-cb-mv-next]").addEventListener("click", function () { goTo(playlistIndex + 1); });

    renderCurrentMedia();
  }

  global.CoolbradorMediaViewer = {
    open: open,
    close: close,
    goTo: goTo,
    next: function () { goTo(playlistIndex + 1); },
    prev: function () { goTo(playlistIndex - 1); }
  };
})(typeof window !== "undefined" ? window : this);
