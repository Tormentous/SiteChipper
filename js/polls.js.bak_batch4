(function () {
  const STORAGE_KEY = "coolbrador_polls_v3";
  const TYPES = ["issues", "mutinies", "ideas"];

  function isSignedIn() {
    if (window.CoolbradorSession) return window.CoolbradorSession.isSignedIn();
    try { if (window.CoolbradorAuth && window.CoolbradorAuth.currentUser) return true; } catch (e) {}
    var id = localStorage.getItem("currentUserId") || "";
    return localStorage.getItem("loggedIn") === "true" && !!id;
  }
  function voterId() {
    if (window.CoolbradorSession) {
      var sid = window.CoolbradorSession.getSessionUserId();
      if (sid) return String(sid);
    }
    var id = localStorage.getItem("currentUserId") || "";
    var uid = localStorage.getItem("firebaseUid") || "";
    if (id && id !== uid) return String(id);
    if (id) return String(id);
    return "";
  }
  function requireSignedIn(what) {
    if (window.CoolbradorSession) return window.CoolbradorSession.requireSignedIn(what);
    if (isSignedIn() && voterId()) return true;
    alert("Log in to " + (what || "do that") + ".");
    return false;
  }

  function load() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}"); }
    catch (e) { return {}; }
  }
  function save(data) { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); }

  function escapeHtml(s) {
    if (window.CoolbradorPosts) return window.CoolbradorPosts.escapeHtml(s);
    return String(s).replace(/[&<>"']/g, function (c) {
      return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c];
    });
  }

  function authorName() {
    try {
      var id = voterId();
      if (id) {
        var u = JSON.parse(localStorage.getItem("user_" + id) || "{}");
        if (u.username) return u.username;
      }
    } catch (e) {}
    return "Citizen";
  }


  function authorToUserId(name) {
    var map = {
      ChipperFan: "12", PotatoPilot: "8", StarMaxxer: "6", ModTemp: "1",
      Miguel: "2", GyattToad: "3", Citizen: "0", Anon: "0"
    };
    return map[name] || name || "guest";
  }

  function seedIfEmpty() {
    const data = load();
    var changed = false;
    TYPES.forEach(function (t) {
      if (!Array.isArray(data[t])) { data[t] = []; changed = true; }
    });
    if (!data.issues.length) {
      data.issues.push({
        id: 1,
        title: "Starry sky eats my GPU on potato laptops",
        body: "Can we add a Low Stars mode? My fan sounds like a jet.",
        author: "ChipperFan",
        created: Date.now() - 86400000 * 2,
        yes: ["demo1", "demo2"],
        no: ["demo3"],
        sample: true,
        arguments: [
          { id: 11, author: "PotatoPilot", side: "yes", text: "Please. My laptop is crying.", ts: Date.now() - 86400000 },
          { id: 12, author: "StarMaxxer", side: "no", text: "Cope. More stars = more aura.", ts: Date.now() - 80000000 },
          { id: 13, author: "BatteryBat", side: "yes", text: "Low Stars mode keeps the site usable on potatoes.", ts: Date.now() - 72000000 },
          { id: 14, author: "AuraFarmer", side: "no", text: "Cut stars and Coolbrador loses the night vibe.", ts: Date.now() - 68000000 }
        ],
        discussion: [
          { id: 21, author: "ModTemp", text: "We can ship a toggle. No mutiny required.", ts: Date.now() - 70000000 }
        ],
        voteHistory: [
          { t: Date.now() - 86400000 * 2, pct: { yes: 50, no: 50 } },
          { t: Date.now() - 86400000, pct: { yes: 60, no: 40 } },
          { t: Date.now() - 60000000, pct: { yes: 67, no: 33 } },
          { t: Date.now() - 20000000, pct: { yes: 67, no: 33 } }
        ]
      });
      changed = true;
    }
    if (!data.mutinies.length) {
      data.mutinies.push({
        id: 1,
        title: "Mutiny against TemporaryMod for ban-happy vibes",
        body: "Banned three people for saying chipper too loud. Propose cooler heads.",
        author: "Miguel",
        created: Date.now() - 86400000,
        yes: ["demo1"],
        no: ["demo2", "demo3"],
        sample: true,
        arguments: [
          { id: 31, author: "CoolerHeads", side: "yes", text: "Ban-happy mods chill the pack. Walk the plank.", ts: Date.now() - 80000000 },
          { id: 32, author: "RuleStickler", side: "no", text: "Rules are rules. Loud Chipper spam was real.", ts: Date.now() - 75000000 }
        ],
        discussion: [
          { id: 41, author: "ModeratorAlly", text: "Can we demote instead of exile?", ts: Date.now() - 60000000 }
        ],
        voteHistory: [
          { t: Date.now() - 86400000, pct: { yes: 55, no: 45 } },
          { t: Date.now() - 60000000, pct: { yes: 42, no: 58 } },
          { t: Date.now() - 30000000, pct: { yes: 38, no: 62 } },
          { t: Date.now() - 3600000, pct: { yes: 33, no: 67 } }
        ]
      });
      changed = true;
    }
    if (!data.ideas.length) {
      data.ideas.push({
        id: 1,
        title: "Board stickers that follow you into Chipper",
        body: "Earn a sticker on the site, see it on your in-game collar. Instant drip.",
        author: "GyattToad",
        created: Date.now() - 3600000 * 5,
        yes: ["demo1", "demo2", "demo4"],
        no: [],
        sample: true,
        arguments: [
          { id: 51, author: "DripLord", side: "yes", text: "Collar stickers = instant flex in tunnels.", ts: Date.now() - 10000000 },
          { id: 52, author: "MinimalistPup", side: "no", text: "Cute until every screen is a sticker billboard.", ts: Date.now() - 8000000 }
        ],
        discussion: [],
        voteHistory: [
          { t: Date.now() - 3600000 * 5, pct: { yes: 70, no: 30 } },
          { t: Date.now() - 3600000 * 3, pct: { yes: 80, no: 20 } },
          { t: Date.now() - 3600000, pct: { yes: 100, no: 0 } }
        ],
        extraSides: [
          { id: "mid", label: "Maybe later", voters: [] }
        ]
      });
      changed = true;
    }
    if (changed) save(data);
    return data;
  }

  function timeAgo(ts) {
    var s = Math.floor((Date.now() - ts) / 1000);
    if (s < 60) return "just now";
    if (s < 3600) return Math.floor(s / 60) + "m ago";
    if (s < 86400) return Math.floor(s / 3600) + "h ago";
    return Math.floor(s / 86400) + "d ago";
  }

  function ensureFields(p) {
    p.yes = p.yes || [];
    p.no = p.no || [];
    p.arguments = p.arguments || [];
    p.discussion = p.discussion || [];
    p.voteHistory = p.voteHistory || [];
    p.extraSides = p.extraSides || [];
    p.extraSides.forEach(function (s) {
      if (!s.id) s.id = "side_" + Date.now();
      if (!s.label) s.label = "Side";
      s.voters = s.voters || [];
    });
    if (p.media && !p.media.url) p.media = null;
    return p;
  }

  var SIDE_COLORS = [
    { stroke: "rgb(var(--cb-accent-rgb))", fill: "rgba(var(--cb-accent-rgb),0.35)", css: "yes" },
    { stroke: "#ff4466", fill: "rgba(255,68,102,0.28)", css: "no" },
    { stroke: "#ece053", fill: "rgba(236,224,83,0.28)", css: "extra0" },
    { stroke: "#a78bfa", fill: "rgba(167,139,250,0.28)", css: "extra1" },
    { stroke: "#34d399", fill: "rgba(52,211,153,0.28)", css: "extra2" },
    { stroke: "#fb923c", fill: "rgba(251,146,60,0.28)", css: "extra3" }
  ];

  function sideLabels(type) {
    if (type === "mutinies") return { yes: "Mutineers", no: "Loyalists" };
    if (type === "ideas") return { yes: "Believers", no: "Skeptics" };
    return { yes: "Yeahs", no: "Nahs" };
  }

  function listSides(type, p) {
    p = ensureFields(p);
    var labels = sideLabels(type);
    var sides = [
      { id: "yes", label: labels.yes, short: type === "issues" ? "Yeah" : labels.yes, voters: p.yes, color: SIDE_COLORS[0] },
      { id: "no", label: labels.no, short: type === "issues" ? "Nah" : labels.no, voters: p.no, color: SIDE_COLORS[1] }
    ];
    p.extraSides.forEach(function (s, i) {
      sides.push({
        id: s.id,
        label: s.label,
        short: s.label,
        voters: s.voters,
        color: SIDE_COLORS[2 + (i % (SIDE_COLORS.length - 2))],
        extra: true
      });
    });
    return sides;
  }

  function sideVoters(p, sideId) {
    p = ensureFields(p);
    if (sideId === "yes") return p.yes;
    if (sideId === "no") return p.no;
    var side = p.extraSides.find(function (s) { return s.id === sideId; });
    return side ? side.voters : null;
  }

  function removeVoterFromAll(p, vid) {
    p.yes = (p.yes || []).filter(function (x) { return x !== vid; });
    p.no = (p.no || []).filter(function (x) { return x !== vid; });
    (p.extraSides || []).forEach(function (s) {
      s.voters = (s.voters || []).filter(function (x) { return x !== vid; });
    });
  }

  function totalVotes(p) {
    p = ensureFields(p);
    var n = p.yes.length + p.no.length;
    p.extraSides.forEach(function (s) { n += (s.voters || []).length; });
    return n;
  }

  function currentPctMap(p) {
    p = ensureFields(p);
    var total = totalVotes(p);
    var map = { yes: 0, no: 0 };
    if (!total) {
      map.yes = 50;
      map.no = 50;
      p.extraSides.forEach(function (s) { map[s.id] = 0; });
      return map;
    }
    map.yes = Math.round((p.yes.length / total) * 100);
    map.no = Math.round((p.no.length / total) * 100);
    p.extraSides.forEach(function (s) {
      map[s.id] = Math.round(((s.voters || []).length / total) * 100);
    });
    // fix rounding drift on largest
    var sum = Object.keys(map).reduce(function (a, k) { return a + map[k]; }, 0);
    if (sum !== 100) {
      var biggest = "yes";
      Object.keys(map).forEach(function (k) { if (map[k] >= map[biggest]) biggest = k; });
      map[biggest] += (100 - sum);
    }
    return map;
  }

  function currentYesPct(p) {
    return currentPctMap(p).yes;
  }

  function normalizeHistoryPoint(pt) {
    if (!pt) return null;
    if (pt.pct && typeof pt.pct === "object") return { t: pt.t, pct: pt.pct };
    // legacy yesPct-only
    var y = typeof pt.yesPct === "number" ? pt.yesPct : 50;
    return { t: pt.t, pct: { yes: y, no: Math.max(0, 100 - y) } };
  }

  function briefSideSummary(args, label) {
    var list = (args || []).slice().sort(function (a, b) { return b.ts - a.ts; });
    if (!list.length) {
      return "Quiet so far — no " + label + " arguments posted yet.";
    }
    var bits = list.slice(0, 3).map(function (a) { return a.text.replace(/\s+/g, " ").trim(); });
    if (bits.length === 1) return bits[0];
    if (bits.length === 2) return bits[0] + " Also: " + bits[1];
    return bits[0] + " Also: " + bits[1] + " Plus: " + bits[2];
  }

  function voteSeriesMulti(p, sideIds) {
    p = ensureFields(p);
    var series = (p.voteHistory || []).map(normalizeHistoryPoint).filter(Boolean).sort(function (a, b) { return a.t - b.t; });
    var end = currentPctMap(p);
    sideIds.forEach(function (id) {
      if (end[id] == null) end[id] = 0;
    });
    if (series.length >= 2) {
      var last = series[series.length - 1];
      var changed = sideIds.some(function (id) { return (last.pct[id] || 0) !== (end[id] || 0); });
      if (changed) series.push({ t: Date.now(), pct: end });
      return series;
    }
    var start = p.created || (Date.now() - 86400000);
    var now = Date.now();
    var mid = start + Math.floor((now - start) / 2);
    function midMap() {
      var m = {};
      sideIds.forEach(function (id) {
        var e = end[id] || 0;
        m[id] = Math.max(0, Math.min(100, e + (id === "yes" ? -6 : 3)));
      });
      return m;
    }
    var zeros = {};
    sideIds.forEach(function (id) { zeros[id] = 0; });
    // Kalshi-style: every fresh chart starts at 0,0 then grows as votes land.
    return [
      { t: start, pct: zeros },
      { t: mid, pct: midMap() },
      { t: now, pct: end }
    ];
  }

  function recordVoteHistory(item) {
    item.voteHistory = item.voteHistory || [];
    item.voteHistory.push({ t: Date.now(), pct: currentPctMap(item) });
    if (item.voteHistory.length > 64) item.voteHistory = item.voteHistory.slice(-64);
  }

  function polymarketChartSVG(type, p) {
    p = ensureFields(p);
    var sides = listSides(type, p);
    var sideIds = sides.map(function (s) { return s.id; });
    var series = voteSeriesMulti(p, sideIds);
    var endPct = currentPctMap(p);
    var w = 640, h = 200, padL = 44, padR = 18, padT = 16, padB = 26;
    var plotW = w - padL - padR, plotH = h - padT - padB;
    var t0 = series[0].t, t1 = series[series.length - 1].t;
    var span = Math.max(1, t1 - t0);
    function xAt(t) { return padL + ((t - t0) / span) * plotW; }
    function yAt(pct) { return padT + ((100 - pct) / 100) * plotH; }
    var uid = "pm" + String(p.id || "x").replace(/\W/g, "");

    var defs = sides.map(function (s, i) {
      return '<linearGradient id="' + uid + "F" + i + '" x1="0" y1="0" x2="0" y2="1">' +
        '<stop offset="0%" stop-color="' + s.color.stroke + '" stop-opacity="0.38"/>' +
        '<stop offset="100%" stop-color="' + s.color.stroke + '" stop-opacity="0.03"/>' +
        "</linearGradient>";
    }).join("");

    var grids = [100, 75, 50, 25, 0].map(function (v) {
      return '<line class="poll-poly-grid" x1="' + padL + '" y1="' + yAt(v) + '" x2="' + (w - padR) + '" y2="' + yAt(v) + '"/>';
    }).join("");

    var axes = [100, 75, 50, 25, 0].map(function (v) {
      return '<text class="poll-poly-axis" x="' + (padL - 8) + '" y="' + yAt(v) + '" text-anchor="end" dominant-baseline="middle">' + v + "</text>";
    }).join("");

    var sidePts = sides.map(function (s) {
      return series.map(function (pt) {
        var pct = (pt.pct && pt.pct[s.id] != null) ? pt.pct[s.id] : 0;
        return { t: pt.t, x: xAt(pt.t), y: yAt(pct), pct: pct };
      });
    });

    // Fills: draw Yeah first, then Nah/extras on top so under-Nah is that side's color
    var areas = "";
    sides.forEach(function (s, i) {
      var pts = sidePts[i];
      var d = pts.map(function (pt, j) { return (j ? "L" : "M") + pt.x.toFixed(1) + " " + pt.y.toFixed(1); }).join(" ");
      var area = d + " L" + pts[pts.length - 1].x.toFixed(1) + " " + (padT + plotH).toFixed(1) +
        " L" + pts[0].x.toFixed(1) + " " + (padT + plotH).toFixed(1) + " Z";
      areas += '<path class="poll-poly-area" d="' + area + '" fill="url(#' + uid + "F" + i + ')"/>';
    });

    var lines = "";
    var dots = "";
    sides.forEach(function (s, i) {
      var pts = sidePts[i];
      var d = pts.map(function (pt, j) { return (j ? "L" : "M") + pt.x.toFixed(1) + " " + pt.y.toFixed(1); }).join(" ");
      lines += '<path class="poll-poly-line" data-side="' + escapeHtml(s.id) + '" d="' + d + '" fill="none" style="stroke:' + s.color.stroke + '" stroke-width="2.6"/>';
      var end = pts[pts.length - 1];
      dots += '<circle class="poll-poly-dot poll-poly-end-dot" data-side="' + escapeHtml(s.id) + '" cx="' + end.x.toFixed(1) + '" cy="' + end.y.toFixed(1) + '" r="4.5" style="fill:' + s.color.stroke + '"/>';
    });

    var scrubDots = sides.map(function (s) {
      return '<circle class="poll-poly-scrub-dot" data-side="' + escapeHtml(s.id) + '" cx="0" cy="0" r="5" style="fill:' + s.color.stroke + ';display:none" />';
    }).join("");

    var legend = sides.map(function (s) {
      var pct = endPct[s.id] != null ? endPct[s.id] : 0;
      return '<div class="poll-poly-legend-item" data-side="' + escapeHtml(s.id) + '">' +
        '<span class="poll-poly-swatch" style="background:' + s.color.stroke + '"></span>' +
        '<span class="poll-poly-legend-label">' + escapeHtml(s.short) + "</span>" +
        '<span class="poll-poly-legend-pct" style="color:' + s.color.stroke + '">' + pct + "%</span>" +
        "</div>";
    }).join("");

    var payload = {
      t0: t0,
      t1: t1,
      padL: padL,
      padR: padR,
      padT: padT,
      padB: padB,
      w: w,
      h: h,
      sides: sides.map(function (s) { return { id: s.id, short: s.short, color: s.color.stroke }; }),
      series: series.map(function (pt) {
        var row = { t: pt.t, pct: {} };
        sideIds.forEach(function (id) { row.pct[id] = (pt.pct && pt.pct[id] != null) ? pt.pct[id] : 0; });
        return row;
      })
    };

    return (
      '<div class="poll-poly-wrap" data-poly="' + encodeURIComponent(JSON.stringify(payload)) + '">' +
        '<div class="poll-poly-head">' +
          '<span class="poll-poly-title">Odds over time</span>' +
          '<div class="poll-poly-legend">' + legend + "</div>" +
        "</div>" +
        '<div class="poll-poly-chart-wrap"><span class="poll-poly-readout" aria-hidden="true"></span>' +
          '<svg class="poll-poly-chart" viewBox="0 0 ' + w + " " + h + '" role="img" aria-label="Side odds over time">' +
            "<defs>" + defs + "</defs>" +
            grids + axes + areas + lines + dots +
            '<line class="poll-poly-scrub" x1="0" y1="' + padT + '" x2="0" y2="' + (padT + plotH) + '" style="display:none"/>' +
            '<rect class="poll-poly-mask" x="0" y="0" width="0" height="0" fill="rgba(0,0,0,0.45)" style="display:none"></rect>' +
            scrubDots +
          "</svg>" +
        "</div>" +
        '<div class="poll-poly-foot" style="padding-left:' + padL + 'px;padding-right:' + padR + 'px">' +
          '<span>Opened</span><span class="poll-poly-scrub-time">Now</span>' +
        '</div>' +
        '<div class="poll-poly-ticks"><span data-tick="0"></span><span data-tick="1"></span><span data-tick="2"></span><span data-tick="3"></span></div>' +
      "</div>"
    );
  }

  function bindPolyChart(root) {
    if (!root) return;
    var wrap = root.querySelector(".poll-poly-wrap");
    if (!wrap || wrap._polyBound) return;
    var svg = wrap.querySelector(".poll-poly-chart");
    if (!svg) return;
    var data;
    try { data = JSON.parse(decodeURIComponent(wrap.getAttribute("data-poly") || "") || "{}"); } catch (e) { return; }
    if (!data.series || !data.series.length) return;
    wrap._polyBound = true;

    var scrub = svg.querySelector(".poll-poly-scrub");
    var scrubDots = svg.querySelectorAll(".poll-poly-scrub-dot");
    var timeLabel = wrap.querySelector(".poll-poly-scrub-time");
    var mask = svg.querySelector(".poll-poly-mask");
    var readout = wrap.querySelector(".poll-poly-readout");
    var ticks = wrap.querySelectorAll(".poll-poly-ticks [data-tick]");
    /* batch2 kalshi scrub bind */
    function fmtTick(t) {
      try {
        var d = new Date(t);
        return d.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
      } catch (_) { return ""; }
    }
    if (ticks && ticks.length) {
      for (var ti = 0; ti < ticks.length; ti++) {
        var tt = data.t0 + (data.t1 - data.t0) * (ti / Math.max(1, ticks.length - 1));
        ticks[ti].textContent = fmtTick(tt);
      }
    }

    var legendPcts = {};
    wrap.querySelectorAll(".poll-poly-legend-item").forEach(function (el) {
      legendPcts[el.getAttribute("data-side")] = el.querySelector(".poll-poly-legend-pct");
    });
    var endDots = svg.querySelectorAll(".poll-poly-end-dot");
    var plotW = data.w - data.padL - data.padR;
    var plotH = data.h - data.padT - data.padB;
    var span = Math.max(1, data.t1 - data.t0);

    function yAt(pct) { return data.padT + ((100 - pct) / 100) * plotH; }
    function xAt(t) { return data.padL + ((t - data.t0) / span) * plotW; }

    function interpAt(t) {
      var series = data.series;
      if (t <= series[0].t) return series[0].pct;
      if (t >= series[series.length - 1].t) return series[series.length - 1].pct;
      for (var i = 0; i < series.length - 1; i++) {
        var a = series[i], b = series[i + 1];
        if (t >= a.t && t <= b.t) {
          var u = (t - a.t) / Math.max(1, b.t - a.t);
          var out = {};
          data.sides.forEach(function (s) {
            var av = a.pct[s.id] || 0, bv = b.pct[s.id] || 0;
            out[s.id] = Math.round(av + (bv - av) * u);
          });
          return out;
        }
      }
      return series[series.length - 1].pct;
    }

    function formatScrubTime(t) {
      if (t >= data.t1 - 1000) return "Now";
      var ago = Math.max(0, Date.now() - t);
      var s = Math.floor(ago / 1000);
      if (s < 60) return "just now";
      if (s < 3600) return Math.floor(s / 60) + "m ago";
      if (s < 86400) return Math.floor(s / 3600) + "h ago";
      return Math.floor(s / 86400) + "d ago";
    }

    function showAtClientX(clientX) {
      var rect = svg.getBoundingClientRect();
      var x = ((clientX - rect.left) / Math.max(1, rect.width)) * data.w;
      x = Math.max(data.padL, Math.min(data.w - data.padR, x));
      var t = data.t0 + ((x - data.padL) / plotW) * span;
      var pcts = interpAt(t);
      scrub.style.display = "";
      scrub.setAttribute("x1", x.toFixed(1));
      scrub.setAttribute("x2", x.toFixed(1));
      wrap.classList.add("is-scrubbing");
      if (mask) {
        mask.style.display = "";
        mask.setAttribute("x", x.toFixed(1));
        mask.setAttribute("y", data.padT);
        mask.setAttribute("width", Math.max(0, (data.w - data.padR) - x).toFixed(1));
        mask.setAttribute("height", plotH.toFixed(1));
      }
      if (readout) {
        var bits = data.sides.map(function (s) {
          return s.short + " " + (pcts[s.id] != null ? pcts[s.id] : 0) + "%";
        });
        readout.textContent = fmtTick(t) + " | " + bits.join(" | ");
      }
      scrubDots.forEach(function (dot) {
        var id = dot.getAttribute("data-side");
        var pct = pcts[id] != null ? pcts[id] : 0;
        dot.style.display = "";
        dot.setAttribute("cx", x.toFixed(1));
        dot.setAttribute("cy", yAt(pct).toFixed(1));
      });
      endDots.forEach(function (d) { d.style.opacity = "0.25"; });
      data.sides.forEach(function (s) {
        if (legendPcts[s.id]) legendPcts[s.id].textContent = (pcts[s.id] != null ? pcts[s.id] : 0) + "%";
      });
      if (timeLabel) timeLabel.textContent = formatScrubTime(t);
    }

    function reset() {
      scrub.style.display = "none";
      wrap.classList.remove("is-scrubbing");
      if (mask) mask.style.display = "none";
      if (readout) readout.textContent = "";

      scrubDots.forEach(function (dot) { dot.style.display = "none"; });
      endDots.forEach(function (d) { d.style.opacity = "1"; });
      var last = data.series[data.series.length - 1].pct;
      data.sides.forEach(function (s) {
        if (legendPcts[s.id]) legendPcts[s.id].textContent = (last[s.id] != null ? last[s.id] : 0) + "%";
      });
      if (timeLabel) timeLabel.textContent = "Now";
    }

    svg.addEventListener("mousemove", function (e) { showAtClientX(e.clientX); });
    svg.addEventListener("mouseleave", reset);
    svg.addEventListener("touchstart", function (e) {
      if (e.touches && e.touches[0]) showAtClientX(e.touches[0].clientX);
    }, { passive: true });
    svg.addEventListener("touchmove", function (e) {
      if (e.touches && e.touches[0]) showAtClientX(e.touches[0].clientX);
    }, { passive: true });
    svg.addEventListener("touchend", reset);
  }

  function mediaBlockHTML(media) {
    if (!media || !media.url) return "";
    if (media.type === "video") {
      return '<div class="poll-media"><video src="' + escapeHtml(media.url) + '" controls playsinline></video></div>';
    }
    return '<div class="poll-media"><img src="' + escapeHtml(media.url) + '" alt="Issue media"></div>';
  }

  function summarizePoll(p) {
    p = ensureFields(p);
    var total = totalVotes(p);
    var pct = currentPctMap(p);
    var lean = total === 0 ? "No votes yet." : ("Yeah " + pct.yes + "% · Nah " + pct.no + "%");
    p.extraSides.forEach(function (s) {
      lean += " · " + s.label + " " + (pct[s.id] || 0) + "%";
    });
    var talk = (p.discussion || []).length;
    return lean + " (" + total + " votes). Discussion: " + talk + ".";
  }

  var openState = { type: null, id: null };

  function findPoll(type, id) {
    var data = load();
    var item = (data[type] || []).find(function (p) { return p.id === id; });
    return item ? ensureFields(item) : null;
  }

  function pollSharePath(type, id) {
    var t = String(type || "issues").toLowerCase();
    if (t !== "issues" && t !== "mutinies" && t !== "ideas") t = "issues";
    return "/polls/" + t + "/" + id;
  }

  function parsePollPath() {
    var path = (location.pathname || "").replace(/\/+$/, "");
    var m = /^\/polls\/(issues|mutinies|ideas)\/(\d+)$/i.exec(path);
    if (m) return { type: m[1].toLowerCase(), id: m[2] };
    var hash = (location.hash || "").replace(/^#/, "");
    var h = /^poll-([a-z]+)-(\d+)$/i.exec(hash);
    if (h) return { type: h[1].toLowerCase(), id: h[2] };
    return null;
  }

  function setPollUrl(type, id, replace) {
    var url = pollSharePath(type, id);
    try {
      if (replace) history.replaceState({ poll: true, type: type, id: Number(id) }, "", url);
      else history.pushState({ poll: true, type: type, id: Number(id) }, "", url);
    } catch (err) {
      location.hash = "poll-" + type + "-" + id;
    }
  }

  function clearPollUrl() {
    var path = (location.pathname || "");
    if (!/^\/polls(\/|$)/i.test(path) && path.indexOf("polls") === -1) return;
    try {
      history.pushState({ poll: false }, "", "/polls");
    } catch (err) {}
  }

  function buildInlineDetailHTML(type, p) {
    p = ensureFields(p);
    var sides = listSides(type, p);
    var labels = sideLabels(type);
    var summary = summarizePoll(p);
    var sideBriefs = sides.map(function (s) {
      var args = p.arguments.filter(function (a) { return a.side === s.id; });
      return '<section class="poll-side poll-side-' + escapeHtml(s.color.css) + '" data-side="' + escapeHtml(s.id) + '">' +
        '<h3 class="poll-side-title">What ' + escapeHtml(s.label) + " say</h3>" +
        '<p class="poll-side-brief">' + escapeHtml(briefSideSummary(args, s.label)) + "</p>" +
        '<button type="button" class="poll-join-side-btn" data-join-side="' + escapeHtml(s.id) + '" style="color:' + s.color.stroke + ';border-color:' + s.color.stroke + ';background:color-mix(in srgb, ' + s.color.stroke + ' 14%, transparent)">Join ' + escapeHtml(s.short) + "</button>" +
        "</section>";
    }).join("");

    var argueOpts = sides.map(function (s) {
      return '<option value="' + escapeHtml(s.id) + '">For ' + escapeHtml(s.short) + "</option>";
    }).join("");

    var sideVoteBtns = sides.map(function (s) {
      return '<button type="button" class="action-btn poll-side-vote" data-vote="' + escapeHtml(s.id) + '" style="border-color:' + s.color.stroke + ';color:' + s.color.stroke + '">' +
        escapeHtml(s.short) + " (" + (s.voters || []).length + ")</button>";
    }).join("");

    return (
      '<div class="poll-inline-inner' + (p.sample ? " is-sample" : "") + '">' +
      '<div class="poll-inline-head">' +
        '<strong>Open</strong>' +
        '<button type="button" class="poll-close-btn" data-poll-close="1">Close</button>' +
      "</div>" +
      (p.body ? '<p class="poll-open-body">' + escapeHtml(p.body) + "</p>" : "") +
      mediaBlockHTML(p.media) +
      polymarketChartSVG(type, p) +
      '<div class="poll-side-votes">' + sideVoteBtns + "</div>" +
      '<div class="poll-new-side">' +
        '<input type="text" class="poll-new-side-input" maxlength="28" placeholder="Name a new side…">' +
        '<button type="button" class="poll-new-side-btn" data-add-side="1">Join new side</button>' +
      "</div>" +
      '<div class="poll-sides">' + sideBriefs + "</div>" +
      '<div class="poll-summary"><strong>Tally:</strong> ' + escapeHtml(summary) + "</div>" +
      '<button type="button" class="poll-refresh-summary" data-poll-summarize="1">Refresh summary</button>' +
      '<div class="poll-detail-grid">' +
        '<section><h3>Argue</h3>' +
          '<div class="poll-argue-form">' +
            '<select class="argue-side">' + argueOpts + "</select>" +
            '<textarea class="argue-text" placeholder="Make your case..."></textarea>' +
            '<button type="button" class="argue-submit">Post argument</button>' +
          "</div>" +
          '<div class="poll-argue-list">' +
            (p.arguments.length ? p.arguments.slice().sort(function (a, b) { return b.ts - a.ts; }).map(function (a) {
              var side = sides.find(function (s) { return s.id === a.side; });
              var sideName = side ? side.short : a.side;
              return '<div class="poll-arg ' + escapeHtml(a.side) + '"><div class="meta">' + escapeHtml(a.author) + " · " + escapeHtml(sideName) + " · " + timeAgo(a.ts) + "</div><div>" + escapeHtml(a.text) + "</div></div>";
            }).join("") : '<p class="poll-empty-mini">No arguments yet.</p>') +
          "</div></section>" +
        "<section><h3>Discuss</h3>" +
          '<div class="poll-discuss-form">' +
            '<textarea class="discuss-text" placeholder="Talk it out..."></textarea>' +
            '<button type="button" class="discuss-submit">Post</button>' +
          "</div>" +
          '<div class="poll-discuss-list">' +
            (p.discussion.length ? p.discussion.slice().sort(function (a, b) { return b.ts - a.ts; }).map(function (d) {
              return '<div class="poll-msg"><div class="meta">' + escapeHtml(d.author) + " · " + timeAgo(d.ts) + "</div><div>" + escapeHtml(d.text) + "</div></div>";
            }).join("") : '<p class="poll-empty-mini">No discussion yet.</p>') +
          "</div></section>" +
      "</div></div>"
    );
  }


  function closeAllInline(exceptCard) {
    document.querySelectorAll(".post-poll .poll-inline-detail").forEach(function (el) {
      if (exceptCard && exceptCard.contains(el)) return;
      el.hidden = true;
      el.innerHTML = "";
    });
  }

  function openInline(type, id, scroll, opts) {
    opts = opts || {};
    var card = document.querySelector('.post-poll[data-type="' + type + '"][data-id="' + id + '"]');
    if (!card) card = document.querySelector('.poll-card[data-type="' + type + '"][data-id="' + id + '"]');
    if (!card) return;
    var p = findPoll(type, id);
    if (!p) return;
    openState = { type: type, id: Number(id) };
    closeAllInline(card);
    var panel = card.querySelector(".poll-inline-detail");
    if (!panel) return;
    panel.hidden = false;
    panel.innerHTML = buildInlineDetailHTML(type, p);
    bindPolyChart(panel);
    window.__cbRefreshOpenPoll = function () {
      try {
        var cur = panel.getAttribute("data-open-poll");
        if (!cur) return;
        var parts = cur.split(":");
        if (parts.length === 2) {
          // rebuild chart only
          var t = parts[0]; var id = Number(parts[1]);
          var item = (typeof getPoll === "function") ? getPoll(t, id) : null;
          if (!item) return;
          var chartHost = panel.querySelector(".poll-poly-wrap");
          if (!chartHost) return;
          var parent = chartHost.parentNode;
          var html = polymarketChartSVG(t, item);
          var tmp = document.createElement("div");
          tmp.innerHTML = html;
          var next = tmp.firstChild;
          parent.replaceChild(next, chartHost);
          bindPolyChart(panel);
        }
      } catch (_) {}
    };
    try { panel.setAttribute("data-open-poll", type + ":" + id); } catch (_) {}

    if (!opts.skipUrl) setPollUrl(type, id, !!opts.replaceUrl);
    if (scroll) panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function renderList(type) {
    var data = load();
    var list = document.getElementById("list-" + type);
    if (!list) return;
    var items = (data[type] || []).slice().sort(function (a, b) { return b.created - a.created; });
    if (!items.length) {
      list.innerHTML = '<div class="poll-empty">Nothing here yet. Be the first Labrador to propose.</div>';
      return;
    }
    var vid = voterId();
    var CP = window.CoolbradorPosts;
    list.innerHTML = items.map(function (raw) {
      var p = ensureFields(raw);
      var yes = p.yes;
      var no = p.no;
      var myYes = yes.indexOf(vid) !== -1;
      var myNo = no.indexOf(vid) !== -1;
      var actions =
        '<div class="post-actions poll-vote-row">' +
        '<div class="post-action-btns">' +
        '<button type="button" class="action-btn yeah-btn' + (myYes ? " liked" : "") + '" data-vote="yes" data-id="' + p.id + '" title="Yeah">' +
          '<i class="fa-solid fa-thumbs-up" aria-hidden="true"></i><span>' + (myYes ? "Unyeah" : "Yeah!") + "</span>" +
        "</button>" +
        '<button type="button" class="action-btn nah-btn' + (myNo ? " liked" : "") + '" data-vote="no" data-id="' + p.id + '" title="Nah">' +
          '<i class="fa-solid fa-thumbs-down" aria-hidden="true"></i><span>' + (myNo ? "Unnah" : "Nah") + "</span>" +
        "</button>" +
        '<button type="button" class="action-btn comment-btn poll-open-btn" data-open="1" title="Open">' +
          '<i class="fa-solid fa-folder-open" aria-hidden="true"></i><span>Open</span>' +
        "</button>" +
        "</div>" +
        '<div class="stats"><span>' + yes.length + " Yeah</span><span>" + no.length + " Nah</span></div>" +
        "</div>";
      var pseudo = {
        id: p.id,
        username: p.author || "Anon",
        userId: authorToUserId(p.author),
        text: "",
        timestamp: p.created,
        yeahs: yes.slice(),
        replies: p.discussion || [],
        views: yes.length + no.length,
        media: p.media || null
      };

      var yesN = yes.length;
      var noN = no.length;
      var totalV = yesN + noN;
      var yesPct = totalV ? Math.round((yesN / totalV) * 100) : 50;
      var noPct = totalV ? (100 - yesPct) : 50;
      var leanLabel = !totalV
        ? "No votes yet — waiting on the pack."
        : (yesN === noN
          ? "Tied — the pack is split."
          : (yesN > noN ? "Leaning Yeah (" + yesPct + "%)" : "Leaning Nah (" + noPct + "%)"));
      var leanBar =
        '<div class="poll-lean" aria-label="Vote lean">' +
          '<div class="poll-lean-label">' + leanLabel + "</div>" +
          '<div class="poll-lean-track">' +
            '<div class="poll-lean-yes" style="width:' + yesPct + '%"></div>' +
            '<div class="poll-lean-no" style="width:' + noPct + '%"></div>' +
          "</div>" +
          '<div class="poll-lean-legend"><span>Yeah ' + yesN + "</span><span>Nah " + noN + "</span></div>" +
        "</div>";

      var titleHtml = "<strong class=\"post-poll-title\">" + escapeHtml(p.title) + "</strong>" +
        (p.body ? '<div class="post-poll-body">' + escapeHtml(p.body) + "</div>" : "") +
        leanBar;
      var shareHref = pollSharePath(type, p.id);
      if (CP && CP.renderPostCard) {
        var card = CP.renderPostCard(pseudo, {
          showBoard: false,
          hideBoard: true,
          showMenu: true,
          showYeahSection: true,
          showActions: true,
          skipThreadLink: true,
          className: "post-poll" + (p.sample ? " is-sample" : ""),
          textHtml: titleHtml,
          actionsHtml: actions,
          headerExtra: p.sample ? '<span class="test-watermark inline">test</span>' : ""
        });
        card = card.replace('data-id="' + p.id + '"', 'data-id="' + p.id + '" data-type="' + type + '" data-href="' + shareHref + '"');
        var cut = card.lastIndexOf("</div></div>");
        if (cut !== -1) {
          card = card.slice(0, cut) + '<div class="poll-inline-detail" hidden></div>' + card.slice(cut);
        }
        return card;
      }
      return (
        '<article class="poll-card' + (p.sample ? " is-sample" : "") + '" data-id="' + p.id + '" data-type="' + type + '">' +
        "<h3>" + escapeHtml(p.title) + "</h3>" +
        '<div class="poll-vote-row">' + actions + "</div>" +
        '<div class="poll-inline-detail" hidden></div></article>'
      );
    }).join("");

    if (CP && CP.bindFeedInteractions && !list._cbPostsBound) {
      CP.bindFeedInteractions(list, {});
    }
    // restore open panel after re-render
    if (openState.type === type && openState.id) {
      openInline(openState.type, openState.id, false, { skipUrl: true });
    }
  }

  function renderDetail() {
    // legacy top panel retired — keep hidden
    var host = document.getElementById("pollDetail");
    if (host) { host.hidden = true; host.innerHTML = ""; }
  }

  function switchTab(tab) {
    document.querySelectorAll(".poll-tab").forEach(function (b) {
      b.classList.toggle("active", b.dataset.tab === tab);
    });
    document.querySelectorAll(".poll-panel").forEach(function (p) {
      p.classList.toggle("active", p.dataset.panel === tab);
    });
    openState = { type: null, id: null };
    renderList(tab);
  }

  document.addEventListener("DOMContentLoaded", function () {
    seedIfEmpty();
    document.querySelectorAll(".poll-tab").forEach(function (btn) {
      btn.addEventListener("click", function () { switchTab(btn.dataset.tab); });
    });
    var composeMeta = {
      issues: { placeholder: "What happened? Who is involved? What should we do?", submit: "Propose Issue", verb: "propose an issue" },
      mutinies: { placeholder: "Charges, receipts, and proposed replacement (optional)", submit: "Launch Mutiny", verb: "launch a mutiny" },
      ideas: { placeholder: "Sell us on it. Why is this cool?", submit: "Pitch Idea", verb: "pitch an idea" }
    };
    document.querySelectorAll(".poll-compose").forEach(function (box) {
      var type = box.dataset.type;
      var host = box.querySelector(".poll-compose-mount");
      var titleEl = box.querySelector(".poll-title");
      var meta = composeMeta[type] || composeMeta.issues;
      var CP = window.CoolbradorPosts;
      if (!host || !CP || !CP.composerHTML || !CP.mountComposer) return;
      var ids = {
        pfpId: "pollPfp_" + type,
        textId: "pollText_" + type,
        submitId: "pollSubmit_" + type,
        mediaInputId: "pollMedia_" + type,
        attachId: "pollAttach_" + type,
        previewId: "pollPreview_" + type
      };
      host.innerHTML = CP.composerHTML({
        mode: "comment",
        showBoard: false,
        showMedia: true,
        placeholder: meta.placeholder,
        submitLabel: meta.submit,
        requireBoard: false,
        pfpId: ids.pfpId,
        textId: ids.textId,
        submitId: ids.submitId,
        mediaInputId: ids.mediaInputId,
        attachId: ids.attachId,
        previewId: ids.previewId,
        containerClass: "poll-create-post"
      });
      var mounted = CP.mountComposer(host, {
        mode: "comment",
        requireBoard: false,
        signInVerb: meta.verb,
        onSubmit: function (payload) {
          var title = ((titleEl && titleEl.value) || "").trim();
          var body = (payload.text || "").trim();
          if (!title) { alert("Needs a title, captain."); return; }
          if (!body && !(payload.media && payload.media.url)) {
            alert("Add details or media.");
            return;
          }
          if (!requireSignedIn(meta.verb)) return;
          var data = load();
          if (!data[type]) data[type] = [];
          var newId = Date.now();
          data[type].unshift({
            id: newId,
            title: title,
            body: body,
            media: payload.media || null,
            author: authorName(),
            created: Date.now(),
            yes: [],
            no: [],
            arguments: [],
            discussion: [],
            voteHistory: [{ t: Date.now(), pct: { yes: 50, no: 50 } }]
          });
          save(data);
          if (titleEl) titleEl.value = "";
          if (payload.clear) payload.clear();
          renderList(type);
          openInline(type, newId, true);
        }
      });
      var submitBtn = host.querySelector(".post-submit-btn");
      var textArea = host.querySelector("textarea");
      function syncProposeEnabled() {
        if (!submitBtn) return;
        var hasTitle = !!(titleEl && titleEl.value.trim());
        var hasBody = !!(textArea && textArea.value.trim());
        var hasMedia = !!(host.querySelector(".media-preview") && host.querySelector(".media-preview").style.display !== "none" && host.querySelector(".media-preview").querySelector("img,video"));
        // keep mountComposer rules for body/media, but don't look broken: allow click when title+body
        if (hasTitle && (hasBody || hasMedia)) submitBtn.disabled = false;
      }
      if (titleEl) titleEl.addEventListener("input", syncProposeEnabled);
      if (textArea) textArea.addEventListener("input", syncProposeEnabled);
      if (mounted && mounted.updateButton) {
        var _upd = mounted.updateButton;
        // after their update, re-run ours on next tick via input listeners
      }
      syncProposeEnabled();
    });
    var page = document.querySelector(".polls-page");
    if (page) {
      page.addEventListener("click", function (e) {
        var closeBtn = e.target.closest("[data-poll-close]");
        if (closeBtn) {
          e.preventDefault();
          e.stopPropagation();
          openState = { type: null, id: null };
          closeAllInline();
          clearPollUrl();
          return;
        }
        var sumBtn = e.target.closest("[data-poll-summarize]");
        if (sumBtn) {
          e.preventDefault();
          e.stopPropagation();
          if (openState.type && openState.id) openInline(openState.type, openState.id, false, { skipUrl: true });
          return;
        }
        var argueSubmit = e.target.closest(".argue-submit");
        if (argueSubmit) {
          e.preventDefault();
          e.stopPropagation();
          var panelA = argueSubmit.closest(".poll-inline-detail");
          var cardA = argueSubmit.closest(".post-poll, .poll-card");
          if (!panelA || !cardA) return;
          var textA = ((panelA.querySelector(".argue-text") || {}).value || "").trim();
          var sideA = ((panelA.querySelector(".argue-side") || {}).value || "yes");
          if (!textA) return;
          if (!requireSignedIn("argue")) return;
          var dataA = load();
          var itemA = (dataA[cardA.dataset.type] || []).find(function (x) { return String(x.id) === String(cardA.dataset.id); });
          if (!itemA) return;
          ensureFields(itemA);
          itemA.arguments.unshift({ id: Date.now(), author: authorName(), side: sideA, text: textA, ts: Date.now() });
          save(dataA);
          openInline(cardA.dataset.type, cardA.dataset.id, false, { skipUrl: true });
          return;
        }
        var discussSubmit = e.target.closest(".discuss-submit");
        if (discussSubmit) {
          e.preventDefault();
          e.stopPropagation();
          var panelD = discussSubmit.closest(".poll-inline-detail");
          var cardD = discussSubmit.closest(".post-poll, .poll-card");
          if (!panelD || !cardD) return;
          var textD = ((panelD.querySelector(".discuss-text") || {}).value || "").trim();
          if (!textD) return;
          if (!requireSignedIn("post")) return;
          var dataD = load();
          var itemD = (dataD[cardD.dataset.type] || []).find(function (x) { return String(x.id) === String(cardD.dataset.id); });
          if (!itemD) return;
          ensureFields(itemD);
          itemD.discussion.unshift({ id: Date.now(), author: authorName(), text: textD, ts: Date.now() });
          save(dataD);
          openInline(cardD.dataset.type, cardD.dataset.id, false, { skipUrl: true });
          return;
        }

        var openBtn = e.target.closest("[data-open]");
        if (openBtn) {
          e.preventDefault();
          e.stopPropagation();
          var card = openBtn.closest(".post-poll, .poll-card");
          if (!card) return;
          var typeO = card.dataset.type;
          var idO = Number(card.dataset.id);
          var panel = card.querySelector(".poll-inline-detail");
          if (panel && !panel.hidden && openState.id === idO && openState.type === typeO) {
            openState = { type: null, id: null };
            closeAllInline();
            clearPollUrl();
            return;
          }
          openInline(typeO, idO, true);
          return;
        }

        // Clicking the issue card (title/body) opens it
        var cardHit = e.target.closest(".post-poll, .poll-card");
        if (cardHit && !e.target.closest(".post-menu") && !e.target.closest(".post-actions") && !e.target.closest(".poll-inline-detail") && !e.target.closest("[data-vote]") && !e.target.closest("a") && !e.target.closest("button") && !e.target.closest("textarea") && !e.target.closest("input") && !e.target.closest("select")) {
          e.preventDefault();
          e.stopPropagation();
          var typeC = cardHit.dataset.type;
          var idC = Number(cardHit.dataset.id);
          if (!typeC || !idC) return;
          var panelC = cardHit.querySelector(".poll-inline-detail");
          if (panelC && !panelC.hidden && openState.id === idC && openState.type === typeC) {
            openState = { type: null, id: null };
            closeAllInline();
            clearPollUrl();
            return;
          }
          openInline(typeC, idC, true);
          return;
        }

        
        var addSideBtn = e.target.closest("[data-add-side]");
        if (addSideBtn) {
          e.preventDefault();
          e.stopPropagation();
          var cardAdd = addSideBtn.closest(".post-poll, .poll-card");
          var panelAdd = addSideBtn.closest(".poll-inline-detail");
          if (!cardAdd || !panelAdd) return;
          var nameEl = panelAdd.querySelector(".poll-new-side-input");
          var label = ((nameEl && nameEl.value) || "").trim().slice(0, 28);
          if (!label) { alert("Name the side first."); return; }
          if (!requireSignedIn("join a side")) return;
          var typeAdd = cardAdd.dataset.type;
          var idAdd = Number(cardAdd.dataset.id);
          var dataAdd = load();
          var itemAdd = (dataAdd[typeAdd] || []).find(function (x) { return x.id === idAdd; });
          if (!itemAdd) return;
          ensureFields(itemAdd);
          var slug = label.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "") || ("side_" + Date.now());
          if (slug === "yes" || slug === "no") slug = slug + "_2";
          if (itemAdd.extraSides.some(function (s) { return s.id === slug || s.label.toLowerCase() === label.toLowerCase(); })) {
            alert("That side already exists — join it instead.");
            return;
          }
          if (itemAdd.extraSides.length >= 4) { alert("Max 4 custom sides."); return; }
          var vidAdd = voterId();
          if (!vidAdd) return;
          removeVoterFromAll(itemAdd, vidAdd);
          itemAdd.extraSides.push({ id: slug, label: label, voters: [vidAdd] });
          recordVoteHistory(itemAdd);
          save(dataAdd);
          if (nameEl) nameEl.value = "";
          var keepAdd = { type: openState.type, id: openState.id };
          renderList(typeAdd);
          if (keepAdd.type === typeAdd && keepAdd.id === idAdd) openInline(typeAdd, idAdd, false, { skipUrl: true });
          return;
        }

        var joinBtn = e.target.closest("[data-join-side]");
        if (joinBtn) {
          e.preventDefault();
          e.stopPropagation();
          joinBtn.setAttribute("data-vote", joinBtn.getAttribute("data-join-side"));
        }

var btn = e.target.closest("[data-vote]");
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        var card2 = btn.closest(".post-poll, .poll-card");
        if (!card2) return;
        var type = card2.dataset.type;
        var id = Number(card2.dataset.id);
        var vote = btn.dataset.vote;
        if (!requireSignedIn("vote")) return;
        var data = load();
        var item = (data[type] || []).find(function (p) { return p.id === id; });
        if (!item) return;
        ensureFields(item);
        var vid = voterId();
        if (!vid) return;
        var bucket = sideVoters(item, vote);
        if (!bucket) return;
        var already = bucket.indexOf(vid) !== -1;
        removeVoterFromAll(item, vid);
        if (!already) {
          var bucket2 = sideVoters(item, vote);
          if (bucket2) bucket2.push(vid);
        }
        recordVoteHistory(item);
        save(data);
        var keep = { type: openState.type, id: openState.id };
        renderList(type);
        if (keep.type === type && keep.id === id) openInline(type, id, false, { skipUrl: true });
      });
    }

    // deep link /polls/issues/1 (or legacy #poll-issues-1)
    var deep = parsePollPath();
    if (deep) {
      switchTab(deep.type);
      openInline(deep.type, deep.id, true, { replaceUrl: true });
    } else {
      switchTab("issues");
    }
    renderDetail();

    window.addEventListener("popstate", function () {
      var d = parsePollPath();
      if (d) {
        switchTab(d.type);
        openInline(d.type, d.id, false, { skipUrl: true });
      } else {
        openState = { type: null, id: null };
        closeAllInline();
      }
    });
  });
})();
