/**
 * Coolbrador custom media player — YouTube-like chrome using CSS variables.
 * Compact controls: seek flexes, volume expands on hover, fullscreen always visible.
 */
(function (global) {
  "use strict";

  var STYLE_ID = "cb-media-player-inline-css";

  function ensureStyles() {
    if (document.getElementById(STYLE_ID)) return;
    var css =
      ".cb-player{position:relative;width:100%;border-radius:12px;overflow:hidden;" +
      "background:color-mix(in srgb,var(--cb-navy,#00001c) 92%,#000);" +
      "border:1px solid color-mix(in srgb,var(--cb-accent) 25%,transparent)}" +
      ".cb-player-video video.post-media,.cb-player video{display:block;width:100%;max-height:420px;background:#000;cursor:pointer}" +
      ".cb-player-audio{padding:10px 12px 8px}" +
      ".cb-player-audio audio{position:absolute;width:0;height:0;opacity:0;pointer-events:none}" +
      ".cb-player-bar{display:flex;align-items:center;gap:6px;padding:8px 10px;" +
      "background:color-mix(in srgb,var(--cb-navy,#00001c) 88%,transparent);min-width:0}" +
      ".cb-player-video .cb-player-bar{position:absolute;left:0;right:0;bottom:0;" +
      "background:linear-gradient(transparent,color-mix(in srgb,var(--cb-navy,#00001c) 92%,#000));" +
      "opacity:0;transition:opacity .15s ease}" +
      ".cb-player-video:hover .cb-player-bar,.cb-player-video.is-paused .cb-player-bar," +
      ".cb-player-video:focus-within .cb-player-bar{opacity:1}" +
      ".cb-player-play,.cb-player-mute,.cb-player-fs{" +
      "appearance:none;border:0;background:transparent;color:var(--cb-text,#fff);cursor:pointer;" +
      "width:28px;height:28px;flex:0 0 28px;border-radius:999px;display:inline-flex;" +
      "align-items:center;justify-content:center;padding:0}" +
      ".cb-player-play:hover,.cb-player-mute:hover,.cb-player-fs:hover{" +
      "background:color-mix(in srgb,var(--cb-accent) 22%,transparent)}" +
      ".cb-player-seek{position:relative;height:4px;border-radius:999px;" +
      "background:color-mix(in srgb,var(--cb-text,#fff) 18%,transparent);cursor:pointer;" +
      "flex:1 1 auto;min-width:0}" +
      ".cb-player-seek-fill,.cb-player-vol-fill{position:absolute;left:0;top:0;bottom:0;width:0;" +
      "border-radius:inherit;background:var(--cb-accent)}" +
      ".cb-player-seek-fill::after,.cb-player-vol-fill::after{content:\"\";position:absolute;right:-5px;" +
      "top:50%;width:10px;height:10px;border-radius:50%;transform:translateY(-50%);" +
      "background:var(--cb-accent);box-shadow:0 0 0 2px color-mix(in srgb,var(--cb-navy,#00001c) 70%,transparent)}" +
      ".cb-player-time{font-size:.7rem;color:color-mix(in srgb,var(--cb-text,#fff) 75%,transparent);" +
      "white-space:nowrap;font-variant-numeric:tabular-nums;flex:0 0 auto;max-width:5.6rem;" +
      "overflow:hidden;text-overflow:clip}" +
      ".cb-player-vol-wrap{display:flex;align-items:center;gap:4px;flex:0 0 auto;min-width:28px;" +
      "max-width:28px;overflow:hidden;transition:max-width .15s ease}" +
      ".cb-player-vol-wrap:hover,.cb-player-vol-wrap:focus-within,.cb-player-vol-wrap.is-open{" +
      "max-width:110px}" +
      ".cb-player-vol{position:relative;height:4px;width:64px;flex:0 0 64px;border-radius:999px;" +
      "background:color-mix(in srgb,var(--cb-text,#fff) 18%,transparent);cursor:pointer;" +
      "opacity:0;pointer-events:none;transition:opacity .12s ease}" +
      ".cb-player-vol-wrap:hover .cb-player-vol,.cb-player-vol-wrap:focus-within .cb-player-vol," +
      ".cb-player-vol-wrap.is-open .cb-player-vol{opacity:1;pointer-events:auto}" +
      "@media (max-width:420px){.cb-player-time{font-size:.65rem;max-width:4.8rem}" +
      ".cb-player-bar{gap:4px;padding:6px 8px}}";
    var style = document.createElement("style");
    style.id = STYLE_ID;
    style.textContent = css;
    (document.head || document.documentElement).appendChild(style);
  }

  function fmt(t) {
    if (!isFinite(t)) return "0:00";
    t = Math.max(0, Math.floor(t));
    var m = Math.floor(t / 60);
    var s = t % 60;
    return m + ":" + (s < 10 ? "0" : "") + s;
  }

  function enhance(media) {
    if (!media || media.dataset.cbPlayer === "1") return;
    if (media.closest(".cb-player")) return;
    ensureStyles();
    media.dataset.cbPlayer = "1";
    media.removeAttribute("controls");
    media.controls = false;

    var isAudio = media.tagName === "AUDIO";
    var shell = document.createElement("div");
    shell.className = "cb-player " + (isAudio ? "cb-player-audio" : "cb-player-video is-paused");
    media.parentNode.insertBefore(shell, media);
    shell.appendChild(media);

    var bar = document.createElement("div");
    bar.className = "cb-player-bar";
    bar.innerHTML =
      '<button type="button" class="cb-player-play" aria-label="Play"><i class="fa-solid fa-play"></i></button>' +
      '<div class="cb-player-seek"><div class="cb-player-seek-fill"></div></div>' +
      '<span class="cb-player-time">0:00/0:00</span>' +
      '<div class="cb-player-vol-wrap">' +
        '<button type="button" class="cb-player-mute" aria-label="Mute"><i class="fa-solid fa-volume-high"></i></button>' +
        '<div class="cb-player-vol" role="slider" aria-label="Volume"><div class="cb-player-vol-fill"></div></div>' +
      "</div>" +
      (isAudio
        ? ""
        : '<button type="button" class="cb-player-fs" aria-label="Fullscreen"><i class="fa-solid fa-expand"></i></button>');
    shell.appendChild(bar);

    var playBtn = bar.querySelector(".cb-player-play");
    var seek = bar.querySelector(".cb-player-seek");
    var seekFill = bar.querySelector(".cb-player-seek-fill");
    var timeEl = bar.querySelector(".cb-player-time");
    var muteBtn = bar.querySelector(".cb-player-mute");
    var volWrap = bar.querySelector(".cb-player-vol-wrap");
    var vol = bar.querySelector(".cb-player-vol");
    var volFill = bar.querySelector(".cb-player-vol-fill");
    var fsBtn = bar.querySelector(".cb-player-fs");

    function syncPlayIcon() {
      playBtn.innerHTML = media.paused
        ? '<i class="fa-solid fa-play"></i>'
        : '<i class="fa-solid fa-pause"></i>';
      shell.classList.toggle("is-paused", media.paused);
    }
    function syncMuteIcon() {
      muteBtn.innerHTML = media.muted || media.volume === 0
        ? '<i class="fa-solid fa-volume-xmark"></i>'
        : media.volume < 0.4
          ? '<i class="fa-solid fa-volume-low"></i>'
          : '<i class="fa-solid fa-volume-high"></i>';
    }
    function syncTime() {
      var d = media.duration;
      var cur = media.currentTime || 0;
      timeEl.textContent = fmt(cur) + "/" + fmt(d);
      var pct = d ? (cur / d) * 100 : 0;
      seekFill.style.width = pct + "%";
    }
    function syncVol() {
      volFill.style.width = (media.muted ? 0 : media.volume * 100) + "%";
    }
    function isFs() {
      var fsEl = document.fullscreenElement || document.webkitFullscreenElement;
      return fsEl === shell || fsEl === media;
    }
    function syncFsIcon() {
      if (!fsBtn) return;
      fsBtn.innerHTML = isFs()
        ? '<i class="fa-solid fa-compress"></i>'
        : '<i class="fa-solid fa-expand"></i>';
    }
    function toggleFs() {
      try {
        if (isFs()) {
          if (document.exitFullscreen) document.exitFullscreen();
          else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
        } else if (shell.requestFullscreen) {
          shell.requestFullscreen();
        } else if (shell.webkitRequestFullscreen) {
          shell.webkitRequestFullscreen();
        } else if (media.requestFullscreen) {
          media.requestFullscreen();
        } else if (media.webkitRequestFullscreen) {
          media.webkitRequestFullscreen();
        }
      } catch (e) {}
    }

    playBtn.addEventListener("click", function (e) {
      e.preventDefault();
      e.stopPropagation();
      if (media.paused) media.play();
      else media.pause();
    });
    media.addEventListener("play", syncPlayIcon);
    media.addEventListener("pause", syncPlayIcon);
    media.addEventListener("timeupdate", syncTime);
    media.addEventListener("loadedmetadata", syncTime);
    media.addEventListener("volumechange", function () {
      syncMuteIcon();
      syncVol();
    });

    seek.addEventListener("click", function (e) {
      e.preventDefault();
      e.stopPropagation();
      var r = seek.getBoundingClientRect();
      var u = Math.max(0, Math.min(1, (e.clientX - r.left) / Math.max(1, r.width)));
      if (isFinite(media.duration)) media.currentTime = u * media.duration;
    });
    vol.addEventListener("click", function (e) {
      e.preventDefault();
      e.stopPropagation();
      var r = vol.getBoundingClientRect();
      var u = Math.max(0, Math.min(1, (e.clientX - r.left) / Math.max(1, r.width)));
      media.muted = false;
      media.volume = u;
    });
    muteBtn.addEventListener("click", function (e) {
      e.preventDefault();
      e.stopPropagation();
      media.muted = !media.muted;
      if (volWrap) volWrap.classList.add("is-open");
    });
    if (fsBtn) {
      fsBtn.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        toggleFs();
      });
    }
    document.addEventListener("fullscreenchange", syncFsIcon);
    document.addEventListener("webkitfullscreenchange", syncFsIcon);

    if (!isAudio) {
      media.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (media.paused) media.play();
        else media.pause();
      });
      media.addEventListener("dblclick", function (e) {
        e.preventDefault();
        e.stopPropagation();
        toggleFs();
      });
    }

    syncPlayIcon();
    syncMuteIcon();
    syncTime();
    syncVol();
    syncFsIcon();
  }

  function enhanceAll(root) {
    root = root || document;
    root.querySelectorAll("video.post-media, audio.post-media, video[controls], audio[controls], video, audio").forEach(function (el) {
      if (el.dataset.cbPlayer === "1") return;
      if (el.hasAttribute("controls") || el.classList.contains("post-media") || el.classList.contains("post-media-blur") === false && el.closest(".post-media-frame")) {
        if (el.classList.contains("post-media-blur")) return;
        enhance(el);
      }
    });
  }

  function boot() {
    ensureStyles();
    enhanceAll(document);
    if (typeof MutationObserver !== "undefined") {
      var mo = new MutationObserver(function (muts) {
        muts.forEach(function (m) {
          m.addedNodes && m.addedNodes.forEach(function (n) {
            if (n.nodeType !== 1) return;
            if (n.matches && n.matches("video,audio")) enhance(n);
            else if (n.querySelector) enhanceAll(n);
          });
        });
      });
      mo.observe(document.documentElement, { childList: true, subtree: true });
    }
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();

  global.CoolbradorMediaPlayer = { enhance: enhance, enhanceAll: enhanceAll };
})(typeof window !== "undefined" ? window : this);
