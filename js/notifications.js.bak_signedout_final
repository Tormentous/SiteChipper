(function (global) {
  var STORE_KEY = "cb_notifications";
  var SEED_KEY = "cb_notifications_seed_v";
  var SEED_VER = "9";

  function escapeHtml(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function sessionUserId() {
    if (global.CoolbradorPosts && global.CoolbradorPosts.sessionUserId) {
      return String(global.CoolbradorPosts.sessionUserId() || "");
    }
    if (global.CoolbradorSession && global.CoolbradorSession.getSessionUserId) {
      return String(global.CoolbradorSession.getSessionUserId() || "");
    }
    return "";
  }

  function loadAll() {
    try {
      var list = JSON.parse(localStorage.getItem(STORE_KEY) || "[]");
      return Array.isArray(list) ? list : [];
    } catch (e) {
      return [];
    }
  }

  function saveAll(list) {
    localStorage.setItem(STORE_KEY, JSON.stringify(list || []));
    try {
      global.dispatchEvent(new CustomEvent("cb-notifications-changed"));
    } catch (e) {}
  }

  function nextNumber(list) {
    var max = 0;
    (list || []).forEach(function (n) {
      var v = Number(n && n.n) || 0;
      if (v > max) max = v;
    });
    return max + 1;
  }

  function sortNewest(list) {
    return (list || []).slice().sort(function (a, b) {
      var ta = Date.parse(a.timestamp || "") || 0;
      var tb = Date.parse(b.timestamp || "") || 0;
      if (ta !== tb) return tb - ta;
      return (Number(b.n) || 0) - (Number(a.n) || 0);
    });
  }

  function getByNumber(n) {
    var want = Number(n);
    return loadAll().find(function (item) { return Number(item.n) === want; }) || null;
  }

  function notificationUrl(n) {
    return "/notifications/" + encodeURIComponent(String(n));
  }

  function clip(s, n) {
    s = String(s || "").replace(/\s+/g, " ").trim();
    if (!s) return "";
    if (s.length <= n) return s;
    return s.slice(0, n - 1) + "...";
  }

  function quoteSnippet(s, maxLen) {
    maxLen = maxLen || 72;
    s = String(s || "").replace(/\s+/g, " ").trim();
    if (!s) return "";
    if (s.length > maxLen) s = s.slice(0, Math.max(0, maxLen - 3)) + "...";
    return '"' + s + '"';
  }

  function buildPostLabel(board, snippet, maxLen) {
    board = String(board || "").trim();
    var q = quoteSnippet(snippet, maxLen || 72);
    if (board && q) return board + ": " + q;
    if (q) return q;
    if (board) return board;
    return "";
  }

  function postLabel(item) {
    if (!item) return "";
    var built = buildPostLabel(item.board || "", item.postSnippet || "", 72);
    if (built) return built;
    // Fallback for non-post alerts (follow/poll) that stored a custom label
    if (item.postLabel && String(item.postLabel).indexOf("post #") === -1) return item.postLabel;
    return "";
  }

  function postHref(item) {
    return targetHref(item);
  }

  /**
   * opts: type, fromUserId, fromName, text, href, toUserId,
   *       board, postN, postSnippet, postLabel
   */
  function add(opts) {
    opts = opts || {};
    var list = loadAll();
    var board = opts.board || "";
    var postN = Number(opts.postN) || 0;
    var postSnippet = clip(opts.postSnippet || "", 120);
    var label = buildPostLabel(board, postSnippet, 72) || opts.postLabel || "";
    var item = {
      n: nextNumber(list),
      type: opts.type || "alert",
      fromUserId: opts.fromUserId != null ? String(opts.fromUserId) : "",
      fromName: opts.fromName || "Lab",
      text: opts.text || "",
      href: opts.href || (board && postN ? "/b/" + encodeURIComponent(board) + "/post/" + postN + "/comments" : "/notifications"),
      board: board,
      postN: postN,
      postSnippet: postSnippet,
      postLabel: label,
      replyId: opts.replyId || "",
      toUserId: opts.toUserId != null ? String(opts.toUserId) : "",
      read: false,
      timestamp: opts.timestamp || new Date().toISOString()
    };
    list.push(item);
    saveAll(list);
    return item;
  }

  function markRead(n) {
    var list = loadAll();
    var want = Number(n);
    var changed = false;
    list.forEach(function (item) {
      if (Number(item.n) === want && !item.read) {
        item.read = true;
        changed = true;
      }
    });
    if (changed) saveAll(list);
    return changed;
  }

  function markAllRead() {
    var list = loadAll();
    var changed = false;
    list.forEach(function (item) {
      if (!item.read) {
        item.read = true;
        changed = true;
      }
    });
    if (changed) saveAll(list);
  }

  function unreadCount(forUserId) {
    var uid = forUserId != null ? String(forUserId) : "";
    return loadAll().filter(function (item) {
      if (item.read) return false;
      if (!uid) return true;
      return !item.toUserId || String(item.toUserId) === uid;
    }).length;
  }

  function listForUser(forUserId) {
    var uid = forUserId != null ? String(forUserId) : "";
    var list = sortNewest(loadAll());
    if (!uid) return list;
    return list.filter(function (item) {
      return !item.toUserId || String(item.toUserId) === uid;
    });
  }

  function getPfp(userId) {
    if (global.CoolbradorPosts && global.CoolbradorPosts.getPfp) {
      return global.CoolbradorPosts.getPfp(userId);
    }
    try {
      return localStorage.getItem("pfp_" + userId) || "/users/default/pfp.jpg";
    } catch (e) {
      return "/users/default/pfp.jpg";
    }
  }

  function timeAgo(ts) {
    if (global.CoolbradorPosts && global.CoolbradorPosts.timeAgo) {
      return global.CoolbradorPosts.timeAgo(ts);
    }
    return "";
  }

  function typeLabel(type) {
    if (type === "yeah") return "Yeah";
    if (type === "reply") return "Reply";
    if (type === "mention") return "Mention";
    if (type === "follow") return "Follow";
    if (type === "poll") return "Poll";
    return "Alert";
  }

  function typeIcon(type) {
    if (type === "yeah") return "fa-thumbs-up";
    if (type === "reply") return "fa-comment";
    if (type === "mention") return "fa-at";
    if (type === "follow") return "fa-user-plus";
    if (type === "poll") return "fa-square-poll-vertical";
    return "fa-bell";
  }

  function postContextHtml(item) {
    var label = postLabel(item);
    if (!label) return "";
    return (
      '<span class="cb-notif-post">' +
        '<span class="cb-notif-post-label">On ' + escapeHtml(label) + "</span>" +
      "</span>"
    );
  }

  function replyDomId(replyId) {
    return "reply-" + String(replyId || "").replace(/[^a-zA-Z0-9_-]/g, "-");
  }

  /** Make sure General has a real comment we can deep-link + highlight. */
  function ensureDemoHighlightComment() {
    var replyId = "demo-highlight-1";
    var key = "posts_/b/General";
    var list = [];
    try { list = JSON.parse(localStorage.getItem(key) || "[]"); } catch (e) { list = []; }
    if (!Array.isArray(list)) list = [];

    var chron = list.slice().sort(function (a, b) {
      var ta = Date.parse(a.timestamp || "") || Number(a.id) || 0;
      var tb = Date.parse(b.timestamp || "") || Number(b.id) || 0;
      if (ta !== tb) return ta - tb;
      return (Number(a.id) || 0) - (Number(b.id) || 0);
    });

    var post = null;
    var postN = 1;
    for (var i = 0; i < chron.length; i++) {
      if (chron[i] && /cat massage|in-game clip|chipper/i.test(chron[i].text || "")) {
        post = chron[i];
        postN = i + 1;
        break;
      }
    }
    if (!post && chron.length) {
      post = chron[0];
      postN = 1;
    }
    if (!post) {
      post = {
        id: "demo-notif-post-1",
        username: "EvilRobot",
        userId: "6",
        text: "In-game clip check. Cat massage energy incoming.",
        media: null,
        timestamp: new Date(Date.now() - 3600000).toISOString(),
        yeahs: ["0"],
        replies: [],
        views: 21
      };
      list.unshift(post);
      chron = [post];
      postN = 1;
    }

    post.replies = post.replies || [];
    var reply = null;
    for (var r = 0; r < post.replies.length; r++) {
      if (post.replies[r] && String(post.replies[r].id) === replyId) {
        reply = post.replies[r];
        break;
      }
    }
    if (!reply) {
      reply = {
        id: replyId,
        parentId: null,
        userId: "1",
        username: "BeeSid",
        text: "I sniffed it. 10/10.",
        timestamp: new Date(Date.now() - 1800000).toISOString(),
        yeahs: [],
        replies: [],
        views: 0
      };
      post.replies.unshift(reply);
    }

    // Write the mutated post back into storage (newest-first)
    var found = false;
    for (var li = 0; li < list.length; li++) {
      if (list[li] && String(list[li].id) === String(post.id)) {
        list[li] = post;
        found = true;
        break;
      }
    }
    if (!found) list.unshift(post);
    list.sort(function (a, b) {
      var ta = Date.parse(a.timestamp || "") || Number(a.id) || 0;
      var tb = Date.parse(b.timestamp || "") || Number(b.id) || 0;
      if (ta !== tb) return tb - ta;
      return (Number(b.id) || 0) - (Number(a.id) || 0);
    });
    localStorage.setItem(key, JSON.stringify(list));

    // Recompute post number after save (chronological)
    chron = JSON.parse(localStorage.getItem(key) || "[]");
    chron = chron.slice().sort(function (a, b) {
      var ta = Date.parse(a.timestamp || "") || Number(a.id) || 0;
      var tb = Date.parse(b.timestamp || "") || Number(b.id) || 0;
      if (ta !== tb) return ta - tb;
      return (Number(a.id) || 0) - (Number(b.id) || 0);
    });
    postN = 1;
    for (var j = 0; j < chron.length; j++) {
      if (chron[j] && String(chron[j].id) === String(post.id)) {
        postN = j + 1;
        post = chron[j];
        break;
      }
    }

    return {
      board: "General",
      postN: postN,
      postSnippet: post.text || "",
      replyId: replyId,
      replyText: reply.text || "I sniffed it. 10/10.",
      fromUserId: "1",
      fromName: "BeeSid",
      href: "/b/General/post/" + postN + "/comments#" + replyDomId(replyId)
    };
  }

  function targetHref(item) {
    if (!item) return "/notifications";
    // Prefer the content link (post/comment/profile). Never send inbox rows to /notifications/N.
    if (item.href && String(item.href).indexOf("/notifications/") !== 0) return item.href;
    if (item.replyId && item.board && item.postN) {
      return "/b/" + encodeURIComponent(item.board) + "/post/" + item.postN + "/comments#" + replyDomId(item.replyId);
    }
    if (item.board && item.postN) {
      return "/b/" + encodeURIComponent(item.board) + "/post/" + item.postN + "/comments";
    }
    return item.href || "/notifications";
  }

  function seedIfNeeded() {
    try {
      if (localStorage.getItem(SEED_KEY) === SEED_VER && loadAll().length) return;
    } catch (e) {}

    var deep = ensureDemoHighlightComment();
    var deepHref = deep ? deep.href : "/b/General/post/1/comments#comment-1";
    var deepBoard = deep ? deep.board : "General";
    var deepPostN = deep ? deep.postN : 1;
    var deepSnip = deep ? deep.postSnippet : "In-game clip check. Cat massage energy incoming.";
    var deepFromId = deep ? deep.fromUserId : "1";
    var deepFromName = deep ? deep.fromName : "BeeSid";
    var deepReplyText = deep ? deep.replyText : "I sniffed it. 10/10.";

    var samples = [
      { type: "reply", fromUserId: deepFromId, fromName: deepFromName, text: "Replied: \"" + String(deepReplyText).slice(0, 80) + "\"", board: deepBoard, postN: deepPostN, postSnippet: deepSnip, href: deepHref, replyId: deep ? deep.replyId : "demo-highlight-1" },
      { type: "yeah", fromUserId: "14", fromName: "PantsWetterLabrador", text: "Yeah'd your post.", board: "General", postN: 1, postSnippet: "Check your pants", href: "/b/General/post/1/comments" },
      { type: "reply", fromUserId: "0", fromName: "Cardbrador", text: "Replied: \"I'm putting this on Coolbrador!\"", board: "General", postN: 2, postSnippet: "First post energy. Yeah this if the starry sky made you smile.", href: "/b/General/post/2/comments" },
      { type: "yeah", fromUserId: "3", fromName: "GyattToad", text: "Yeah'd your clip.", board: "General", postN: 3, postSnippet: "Receipts from the mutiny desk. Little Jimmy says hi.", href: "/b/General/post/3/comments" },
      { type: "reply", fromUserId: "18", fromName: "SnackBandit", text: "Nested reply: \"Day 1775 still asking for 9999 tennis balls\"", board: "General", postN: 1, postSnippet: "In-game clip check. Cat massage energy incoming.", href: "/b/General/post/1/comments" },
      { type: "mention", fromUserId: "12", fromName: "CoolDog", text: "Mentioned you.", board: "ChipperCorner", postN: 1, postSnippet: "BeeSid board is live. Bring rhombuses.", href: "/b/ChipperCorner/post/1/comments" },
      { type: "follow", fromUserId: "17", fromName: "BarTabby", text: "Started following you. Zoomies tax unpaid.", href: "/users/profile/?id=17" },
      { type: "poll", fromUserId: "2", fromName: "Miguel", text: "Your mutiny poll got a new vote.", postLabel: "Polls", postSnippet: "Issues, mutinies, ideas.", href: "/polls" },
      { type: "reply", fromUserId: "6", fromName: "EvilRobot", text: "Replied: \"CHIPPER!!!\"", board: "General", postN: 4, postSnippet: "Pitch: board stickers that jiggle. Prototype gif attached.", href: "/b/General/post/4/comments" },
      { type: "yeah", fromUserId: "1", fromName: "BeeSid", text: "Yeah'd your post.", board: "Labradoria", postN: 1, postSnippet: "East Labradoria checking in. Tennis balls status: 0", href: "/b/Labradoria/post/1/comments" }
    ];

    var list = [];
    var now = Date.now();
    samples.forEach(function (s, i) {
      var board = s.board || "";
      var postN = Number(s.postN) || 0;
      list.push({
        n: i + 1,
        type: s.type,
        fromUserId: s.fromUserId,
        fromName: s.fromName,
        text: s.text,
        href: s.href,
        board: board,
        postN: postN,
        postSnippet: s.postSnippet || "",
        postLabel: buildPostLabel(board, s.postSnippet || "", 72) || s.postLabel || "",
        replyId: s.replyId || "",
        toUserId: "",
        read: i > 5,
        timestamp: new Date(now - (i + 1) * 37 * 60000).toISOString()
      });
    });
    saveAll(list);
    try { localStorage.setItem(SEED_KEY, SEED_VER); } catch (e) {}
  }

  function parseRoute() {
    var path = location.pathname || "";
    var m = path.match(/\/notifications\/(\d+)\/?$/i);
    if (m) return { view: "detail", n: parseInt(m[1], 10) };
    return { view: "list", n: 0 };
  }

  function wireListClicks(root) {
    root.querySelectorAll("a.cb-notif-row[data-notif-n]").forEach(function (a) {
      a.addEventListener("click", function () {
        var n = a.getAttribute("data-notif-n");
        markRead(n);
        refreshBadges();
      });
    });
  }

  function renderPage() {
    ensureDemoHighlightComment();
    seedIfNeeded();
    var root = document.getElementById("notificationsRoot");
    if (!root) return;

    var route = parseRoute();
    var uid = sessionUserId();
    var items = listForUser(uid);

    if (route.view === "detail" && route.n > 0) {
      markRead(route.n);
      refreshBadges();
      var item = getByNumber(route.n);
      if (item) {
        var jump = targetHref(item);
        if (jump && String(jump).indexOf("/notifications") !== 0) {
          location.replace(jump);
          return;
        }
      }
      if (!item) {
        root.innerHTML =
          '<div class="cb-notif-empty">' +
            "<strong>Notification not found</strong>" +
            "<span>That number does not exist (yet).</span>" +
            '<p><a href="/notifications">Back to Notifications</a></p>' +
          "</div>";
        return;
      }
      var label = postLabel(item);
      var snip = "";
      var openHref = postHref(item);
      root.innerHTML =
        '<p class="cb-notif-crumb"><a href="/notifications">Notifications</a> / #' + item.n + "</p>" +
        '<article class="cb-notif-detail">' +
          '<div class="cb-notif-detail-head">' +
            '<img class="cb-notif-avatar" src="' + escapeHtml(getPfp(item.fromUserId)) + '" alt="">' +
            "<div>" +
              '<p class="cb-notif-kicker"><i class="fa-solid ' + typeIcon(item.type) + '"></i> ' + escapeHtml(typeLabel(item.type)) + " - #" + item.n + " - Read</p>" +
              "<h1>" + escapeHtml(item.fromName) + "</h1>" +
              '<p class="cb-notif-meta">' + escapeHtml(timeAgo(item.timestamp) || "") + "</p>" +
            "</div>" +
          "</div>" +
          '<p class="cb-notif-detail-text">' + escapeHtml(item.text) + "</p>" +
          ((label || snip)
            ? '<a class="cb-notif-post-card" href="' + escapeHtml(openHref) + '">' +
                '<span class="cb-notif-post-card-kicker">About this post</span>' +
                (label ? '<strong>' + escapeHtml(label) + "</strong>" : "") +
              "</a>"
            : "") +
          '<div class="cb-notif-detail-actions">' +
            (openHref ? '<a class="post-submit-btn" href="' + escapeHtml(openHref) + '">' + (item.replyId ? "Open comment" : "Open post") + '</a>' : "") +
            '<a class="tool-btn" href="/users/profile/?id=' + encodeURIComponent(item.fromUserId || "0") + '">Profile</a>' +
            '<a class="tool-btn" href="/notifications">All notifications</a>' +
          "</div>" +
        "</article>";
      return;
    }

    var unread = unreadCount(uid);
    var head =
      '<div class="cb-notif-head">' +
        "<div>" +
          "<h1>Notifications</h1>" +
          '<p class="cb-notif-sub">' + (unread ? unread + " unread" : "You're caught up") + "</p>" +
        "</div>" +
        '<button type="button" class="tool-btn" id="notifMarkAll">Mark all read</button>' +
      "</div>";

    if (!items.length) {
      root.innerHTML = head +
        '<div class="cb-notif-empty">' +
          "<strong>No notifications yet</strong>" +
          "<span>Yeahs, replies, and pack pings will land here.</span>" +
        "</div>";
    } else {
      root.innerHTML = head +
        '<div class="cb-notif-list" role="list">' +
          items.map(function (item) {
            return (
              '<a class="cb-notif-row' + (item.read ? "" : " is-unread") + '" role="listitem" data-notif-n="' + item.n + '" href="' + escapeHtml(targetHref(item)) + '">' +
                '<span class="cb-notif-num">#' + item.n + "</span>" +
                '<img class="cb-notif-avatar" src="' + escapeHtml(getPfp(item.fromUserId)) + '" alt="">' +
                '<span class="cb-notif-body">' +
                  '<span class="cb-notif-top">' +
                    "<strong>" + escapeHtml(item.fromName) + "</strong>" +
                    '<span class="cb-notif-type"><i class="fa-solid ' + typeIcon(item.type) + '"></i> ' + escapeHtml(typeLabel(item.type)) + "</span>" +
                    '<span class="cb-notif-meta">' + escapeHtml(timeAgo(item.timestamp) || "") + "</span>" +
                  "</span>" +
                  '<span class="cb-notif-text">' + escapeHtml(item.text) + "</span>" +
                  postContextHtml(item) +
                "</span>" +
                (item.read ? "" : '<span class="cb-notif-dot" aria-label="Unread"></span>') +
              "</a>"
            );
          }).join("") +
        "</div>";
      wireListClicks(root);
    }

    var btn = document.getElementById("notifMarkAll");
    if (btn) {
      btn.onclick = function () {
        markAllRead();
        renderPage();
        refreshBadges();
      };
    }
  }

  function refreshBadges() {
    var count = unreadCount(sessionUserId());
    document.querySelectorAll("[data-nav='notifications']").forEach(function (a) {
      var badge = a.querySelector(".cb-notif-badge");
      if (!count) {
        if (badge) badge.remove();
        return;
      }
      if (!badge) {
        badge = document.createElement("span");
        badge.className = "cb-notif-badge";
        a.appendChild(badge);
      }
      badge.textContent = count > 99 ? "99+" : String(count);
    });
  }

  function notifyYeah(actorId, actorName, postOwnerId, href, snippet, meta) {
    meta = meta || {};
    if (!postOwnerId || String(postOwnerId) === String(actorId)) return;
    add({
      type: "yeah",
      fromUserId: actorId,
      fromName: actorName || "Lab",
      toUserId: String(postOwnerId),
      text: "Yeah'd your post.",
      href: href || "/notifications",
      board: meta.board || "",
      postN: meta.postN || 0,
      postSnippet: snippet || meta.postSnippet || "",
      postLabel: meta.postLabel || ""
    });
  }

  function notifyReply(actorId, actorName, postOwnerId, href, snippet, meta) {
    meta = meta || {};
    add({
      type: "reply",
      fromUserId: actorId,
      fromName: actorName || "Lab",
      toUserId: postOwnerId ? String(postOwnerId) : "",
      text: "Replied" + (snippet ? ': "' + clip(snippet, 100) + '"' : "."),
      href: href || "/notifications",
      board: meta.board || "",
      postN: meta.postN || 0,
      postSnippet: meta.postSnippet || "",
      postLabel: meta.postLabel || "",
      replyId: meta.replyId || ""
    });
  }

  global.CoolbradorNotifications = {
    seedIfNeeded: seedIfNeeded,
    loadAll: loadAll,
    listForUser: listForUser,
    getByNumber: getByNumber,
    add: add,
    markRead: markRead,
    markAllRead: markAllRead,
    unreadCount: unreadCount,
    notificationUrl: notificationUrl,
    renderPage: renderPage,
    refreshBadges: refreshBadges,
    notifyYeah: notifyYeah,
    notifyReply: notifyReply,
    escapeHtml: escapeHtml
  };

  document.addEventListener("DOMContentLoaded", function () {
    seedIfNeeded();
    refreshBadges();
    if (document.getElementById("notificationsRoot")) renderPage();
  });
  global.addEventListener("cb-notifications-changed", refreshBadges);
})(typeof window !== "undefined" ? window : this);
