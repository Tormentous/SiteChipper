(function () {
  var DEMO_AVATARS = {
    "0": "/shared/TestImages/ProfilePhotos/Cardbrador.png",
    "1": "/shared/TestImages/ProfilePhotos/BeeSid.png",
    "2": "/shared/TestImages/ProfilePhotos/Miguel.webp",
    "3": "/shared/TestImages/ProfilePhotos/GyattToad.png",
    "4": "/shared/TestImages/ProfilePhotos/AnthonySpade.png",
    "5": "/shared/TestImages/ProfilePhotos/Barcat.png",
    "6": "/shared/TestImages/ProfilePhotos/EvilRobot.jpg",
    "7": "/shared/TestImages/ProfilePhotos/AbovegroundBro.png",
    "8": "/shared/TestImages/ProfilePhotos/NerdDog.png",
    "9": "/shared/TestImages/ProfilePhotos/OrangeTabby.png",
    "10": "/shared/TestImages/ProfilePhotos/EvilKid23.png",
    "11": "/shared/TestImages/ProfilePhotos/NoFilterBro.png",
    "12": "/shared/TestImages/ProfilePhotos/CoolDog.png",
    "13": "/shared/TestImages/ProfilePhotos/ANIMEGIRL.png"
  };
  var IMAGE_MAX_BYTES = 1200000; // ~1.2MB

  function demoAvatar(id) {
    return (window.CB_DEMO_AVATARS && window.CB_DEMO_AVATARS[id]) || DEMO_AVATARS[id] || "/users/default/pfp.jpg";
  }
  function escapeHtml(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
      return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c];
    });
  }
  function qs(name) {
    return new URLSearchParams(location.search).get(name);
  }
  function pathIdFallback() {
    // Support /users/5 and /users/profile/0 style routes
    var parts = location.pathname.split("/").filter(Boolean);
    if (parts[0] === "users" && parts.length >= 2) {
      var seg = parts[1];
      if (seg === "profile") {
        var last = parts[parts.length - 1];
        if (last && /^\d+$/.test(last)) return last;
        return null;
      }
      if (/^\d+$/.test(seg) || /^[a-zA-Z0-9_-]+$/.test(seg)) return seg;
    }
    var last = parts[parts.length - 1];
    if (last && /^\d+$/.test(last)) return last;
    return null;
  }

  function getSessionUserId() {
    try {
      if (window.CoolbradorLayout && typeof window.CoolbradorLayout.getSessionUserId === "function") {
        var a = window.CoolbradorLayout.getSessionUserId();
        if (a) return String(a);
      }
    } catch (e) {}
    try {
      if (window.CoolbradorSession && typeof window.CoolbradorSession.getSessionUserId === "function") {
        var b = window.CoolbradorSession.getSessionUserId();
        if (b) return String(b);
      }
    } catch (e) {}
    return localStorage.getItem("currentUserId") || "";
  }

  function isSignedIn() {
    try {
      if (window.CoolbradorLayout && typeof window.CoolbradorLayout.isSignedIn === "function") {
        if (window.CoolbradorLayout.isSignedIn()) return true;
      }
    } catch (e) {}
    try {
      if (window.CoolbradorSession && typeof window.CoolbradorSession.isSignedIn === "function") {
        if (window.CoolbradorSession.isSignedIn()) return true;
      }
    } catch (e) {}
    var id = localStorage.getItem("currentUserId") || "";
    return localStorage.getItem("loggedIn") === "true" && !!id;
  }

  
  function cbCssVar(name, fallback) {
    try {
      var v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return v || fallback;
    } catch (e) {
      return fallback;
    }
  }
  function themeNavy() {
    return cbCssVar("--cb-navy", "#00001c");
  }
  function resolveCardBg(stored) {
    var legacy = { "#0d001f": 1, "#1a1040": 1 };
    var bg = stored == null ? "" : String(stored).trim();
    if (!bg || legacy[bg.toLowerCase()]) return themeNavy();
    return bg;
  }
  function resolveBlockBg(stored) {
    var legacy = { "#0d001f": 1, "#1a1040": 1 };
    var bg = stored == null ? "" : String(stored).trim();
    if (!bg || legacy[bg.toLowerCase()]) return themeNavy();
    return bg;
  }

  function defaultSections(profile) {
    return [
      {
        id: "s_avatar",
        left: 40, top: 36, width: 160, height: 160,
        type: "image", locked: false,
        imageSrc: profile.avatar || demoAvatar(profile.id),
        imageStyle: "50%"
      },
      {
        id: "s_name",
        left: 220, top: 48, width: 420, height: 70,
        type: "text", locked: false,
        text: profile.displayName || "User",
        fontSize: "2.2rem", color: "#e8eefc", fontWeight: "700"
      },
      {
        id: "s_handle",
        left: 220, top: 118, width: 320, height: 40,
        type: "text", locked: false,
        text: "@" + (profile.handle || "user"),
        fontSize: "1.1rem", color: cbCssVar("--cb-muted", "#8ea0c0")
      },
      {
        id: "s_bio",
        left: 40, top: 230, width: 760, height: 120,
        type: "text", locked: false,
        text: profile.bio || "Coolbrador explorer.",
        fontSize: "1rem", color: cbCssVar("--cb-muted", "#c9d0e0")
      }
    ];
  }
  function defaultProfile(id) {
    var demos = {
      "0": { displayName: "Cardbrador", handle: "cardbrador", bio: "Welcome aboard.", about: "Official-ish demo pup." },
      "1": { displayName: "BeeSid", handle: "beesid", bio: "Rhombus enjoyer.", about: "Lives in the header glow." },
      "2": { displayName: "Miguel", handle: "miguel", bio: "Mutiny correspondent.", about: "Keeps receipts." },
      "3": { displayName: "GyattToad", handle: "gyatttoad", bio: "Pitch machine.", about: "Ideas tab forever." },
      "4": { displayName: "AnthonySpade", handle: "anthonyspade", bio: "Gift drive booster.", about: "Stockings full of rhombuses." },
      "5": { displayName: "Barcat", handle: "barcat", bio: "Lounge lookout.", about: "Always on the rail." },
      "6": { displayName: "EvilRobot", handle: "evilrobot", bio: "Beep boop menace.", about: "Mostly jokes." },
      "7": { displayName: "AbovegroundBro", handle: "abovegroundbro", bio: "Above-ground vibes.", about: "Test mesh enjoyer." },
      "8": { displayName: "NerdDog", handle: "nerddog", bio: "Specs and snacks.", about: "8x the polish." },
      "9": { displayName: "OrangeTabby", handle: "orangetabby", bio: "Triple leverage vibes.", about: "Charts and stars." },
      "10": { displayName: "EvilKid23", handle: "evilkids23", bio: "Spooky soft launch.", about: "Friendly haunt." },
      "11": { displayName: "NoFilterBro", handle: "nofilterbro", bio: "Raw feed only.", about: "What you see is what you get." },
      "12": { displayName: "CoolDog", handle: "cooldog", bio: "Cool by default.", about: "Name is the vibe." },
      "13": { displayName: "ANIMEGIRL", handle: "animegirl", bio: "Main character energy.", about: "Frame-perfect poses." },
      demo: { displayName: "Cardbrador", handle: "cardbrador", bio: "Welcome aboard.", about: "Official-ish demo pup." },
      demo2: { displayName: "BeeSid", handle: "beesid", bio: "Rhombus enjoyer.", about: "Lives in the header glow." },
      demo3: { displayName: "Miguel", handle: "miguel", bio: "Mutiny correspondent.", about: "Keeps receipts." },
      demo4: { displayName: "GyattToad", handle: "gyatttoad", bio: "Pitch machine.", about: "Ideas tab forever." },
      demo5: { displayName: "AnthonySpade", handle: "anthonyspade", bio: "Gift drive booster.", about: "Stockings full of rhombuses." },
      guest: { displayName: "Guest", handle: "guest", bio: "Just looking around.", about: "Log in to claim a cooler profile." }
    };
    var base = demos[id] || {
      displayName: id === "me" ? "You" : ("User " + id),
      handle: String(id || "user").toLowerCase().replace(/[^a-z0-9_]/g, "").slice(0, 24) || "user",
      bio: "Coolbrador explorer.",
      about: "No extra details yet."
    };
    var profile = {
      id: id,
      displayName: base.displayName,
      handle: base.handle,
      bio: base.bio,
      about: base.about,
      avatar: localStorage.getItem("pfp_" + id) || demoAvatar(id),
      joined: Date.now() - 86400000 * 40,
      card: { width: 880, height: 520, background: themeNavy() },
      sections: []
    };
    profile.sections = defaultSections(profile);
    return profile;
  }
  function loadProfile(id) {
    try {
      var stored = JSON.parse(localStorage.getItem("profile_" + id) || "null");
      if (stored) {
        stored.id = id;
        if (!stored.card) stored.card = { width: 880, height: 520, background: themeNavy() };
        if (!Array.isArray(stored.sections) || !stored.sections.length) {
          stored.sections = defaultSections(stored);
        }
        if (!stored.avatar) stored.avatar = localStorage.getItem("pfp_" + id) || demoAvatar(id);
        return stored;
      }
    } catch (e) {}
    try {
      var user = JSON.parse(localStorage.getItem("user_" + id) || "{}");
      if (user.username || user.displayName) {
        var name = user.username || user.displayName;
        var p = {
          id: id,
          displayName: name,
          handle: String(name || "user").toLowerCase().replace(/\s+/g, ""),
          bio: user.bio || "Coolbrador explorer.",
          about: user.about || "Member of the Coolbrador cosmos.",
          avatar: user.profilePicture || localStorage.getItem("pfp_" + id) || demoAvatar(id),
          joined: user.joined || Date.now(),
          card: { width: 880, height: 520, background: themeNavy() },
          sections: []
        };
        p.sections = defaultSections(p);
        return p;
      }
    } catch (e) {}
    return defaultProfile(id);
  }
  function saveProfile(profile) {
    localStorage.setItem("profile_" + profile.id, JSON.stringify(profile));
    if (profile.avatar) localStorage.setItem("pfp_" + profile.id, profile.avatar);
    try {
      var user = JSON.parse(localStorage.getItem("user_" + profile.id) || "{}");
      user.username = profile.displayName;
      user.displayName = profile.displayName;
      user.bio = profile.bio;
      user.about = profile.about;
      user.profilePicture = profile.avatar;
      localStorage.setItem("user_" + profile.id, JSON.stringify(user));
    } catch (e) {}
  }
  function countActivity(userId) {
    var posts = 0, yeahs = 0;
    for (var i = 0; i < localStorage.length; i++) {
      var key = localStorage.key(i);
      if (!key || !key.startsWith("posts_")) continue;
      try {
        var list = JSON.parse(localStorage.getItem(key) || "[]");
        list.forEach(function (p) {
          if (String(p.userId) === String(userId)) posts += 1;
          if ((p.yeahs || []).map(String).indexOf(String(userId)) !== -1) yeahs += 1;
        });
      } catch (e) {}
    }
    return { posts: posts, yeahs: yeahs };
  }
  function recentPosts(userId) {
    var out = [];
    for (var i = 0; i < localStorage.length; i++) {
      var key = localStorage.key(i);
      if (!key || !key.startsWith("posts_")) continue;
      try {
        var list = JSON.parse(localStorage.getItem(key) || "[]");
        list.forEach(function (p) {
          if (String(p.userId) === String(userId)) {
            out.push({
              text: p.text || "",
              board: key.replace("posts_", ""),
              id: p.id,
              ts: p.timestamp
            });
          }
        });
      } catch (e) {}
    }
    return out.sort(function (a, b) { return (b.id || 0) - (a.id || 0); }).slice(0, 8);
  }

  document.addEventListener("DOMContentLoaded", function () {
    var currentUserId = getSessionUserId();
    var loggedIn = isSignedIn() && !!currentUserId;
    if (!currentUserId) currentUserId = localStorage.getItem("currentUserId") || "";
    if (!loggedIn) loggedIn = localStorage.getItem("loggedIn") === "true" && !!currentUserId;

    var viewId = qs("id") || pathIdFallback() || currentUserId || "guest";
    if (viewId === "me" && currentUserId) viewId = currentUserId;
    // Ignore non-id path segments like "profile" or "index.html"
    if (viewId === "profile" || viewId === "index.html" || viewId === "index") {
      viewId = qs("id") || currentUserId || "guest";
    }
    var isOwn = loggedIn && currentUserId && String(viewId) === String(currentUserId);
    var profile = loadProfile(viewId);
    var editMode = false;
    var selectedId = null;

    if (!profile.displayName || !String(profile.displayName).trim()) {
      try {
        var u2 = JSON.parse(localStorage.getItem("user_" + viewId) || "{}");
        profile.displayName = u2.username || u2.displayName || ("User " + viewId);
      } catch (e) {
        profile.displayName = "User " + viewId;
      }
    }
    if (!profile.handle) {
      profile.handle = String(profile.displayName || "user").toLowerCase().replace(/\s+/g, "");
    }

    document.title = profile.displayName + " - Coolbrador";
    document.getElementById("profileDisplayName").textContent = profile.displayName;
    document.getElementById("profileHandle").textContent = "@" + profile.handle;
    document.getElementById("profileBio").textContent = profile.bio || "";
    document.getElementById("profileAbout").textContent = profile.about || "No extra details yet.";
    document.getElementById("profileAvatar").src = profile.avatar || demoAvatar(viewId);

    var stats = countActivity(viewId);
    document.getElementById("statPosts").textContent = String(stats.posts);
    document.getElementById("statYeahs").textContent = String(stats.yeahs);
    document.getElementById("statJoined").textContent = new Date(profile.joined || Date.now()).toLocaleDateString();

    var actions = document.getElementById("profileActions");
    if (isOwn) {
      actions.innerHTML =
        '<button type="button" id="editCarrdBtn" class="rbx-edit-icon-btn" title="Edit page" aria-label="Edit custom page">' +
        '<i class="fa-solid fa-pen" aria-hidden="true"></i></button>' +
        '<button type="button" id="editToggle" class="ghost rbx-edit-meta-btn" title="Edit profile info">Profile info</button>';
    } else {
      actions.innerHTML = '<a class="buttonish ghost" href="/community.html">View posts</a>';
    }

    var postsBox = document.getElementById("profilePosts");
    var posts = recentPosts(viewId);
    if (!posts.length) {
      postsBox.innerHTML = '<p class="empty-feed" style="padding:24px;">No posts yet.</p>';
    } else {
      postsBox.innerHTML = posts.map(function (p) {
        var board = (p.board || "").split("/").pop();
        return '<div class="post" style="cursor:default;"><div class="post-body"><div class="post-header"><span class="post-board">' + escapeHtml(board) + '</span></div><div class="post-text">' + escapeHtml(p.text).replace(/\n/g, "<br>") + "</div></div></div>";
      }).join("");
    }

    var cardEl = document.getElementById("carrdCard");
    var toolbar = document.getElementById("carrdToolbar");
    var fabRow = document.getElementById("carrdFabRow");
    var panel = document.getElementById("editPanel");
    var imageFileInput = document.getElementById("carrdImageFile");

    function selectedSection() {
      if (!selectedId) return null;
      return (profile.sections || []).find(function (s) { return s.id === selectedId; }) || null;
    }

    function syncBlockColorInputs() {
      var sec = selectedSection();
      var bgIn = document.getElementById("carrdBlockBg");
      var txIn = document.getElementById("carrdBlockText");
      if (!bgIn || !txIn) return;
      if (sec) {
        if (sec.type === "image") { bgIn.value = themeNavy(); } else { bgIn.value = (sec.background && /^#/.test(sec.background) && sec.background.toLowerCase() !== "#1a1040" && sec.background.toLowerCase() !== "#0d001f") ? sec.background : themeNavy(); }
        txIn.value = (sec.color && /^#/.test(sec.color)) ? sec.color : "#e8eefc";
        bgIn.disabled = false;
        txIn.disabled = sec.type === "image";
      } else {
        bgIn.disabled = true;
        txIn.disabled = true;
      }
    }

    function applyCardChrome() {
      var w = (profile.card && profile.card.width) || 880;
      var h = (profile.card && profile.card.height) || 520;
      var bg = resolveCardBg(profile.card && profile.card.background);
      cardEl.style.width = w + "px";
      cardEl.style.height = h + "px";
      cardEl.style.minHeight = h + "px";
      cardEl.style.backgroundColor = bg;
      var bgInput = document.getElementById("carrdBgColor");
      var wInput = document.getElementById("carrdWidth");
      var hInput = document.getElementById("carrdHeight");
      if (bgInput) bgInput.value = /^#/.test(bg) ? bg : themeNavy();
      if (wInput) wInput.value = w;
      if (hInput) hInput.value = h;
      cardEl.querySelectorAll(".resize-circle").forEach(function (el) {
        el.hidden = !editMode;
      });
    }

    function sectionHtml(sec) {
      var style =
        "left:" + sec.left + "px;top:" + sec.top + "px;width:" + sec.width + "px;height:" + sec.height + "px;";
      if (sec.type === "image") {
        style += "background:transparent;";
      } else if (sec.background) {
        var sbg = resolveBlockBg(sec.background);
        style += "background:" + sbg + ";";
      }
      if (sec.borderColor) style += "border-color:" + sec.borderColor + ";";
      var inner = "";
      if (sec.type === "image") {
        var radius = sec.imageStyle || "0";
        inner = '<div class="section-content" style="padding:0;background:transparent;"><img src="' + escapeHtml(sec.imageSrc || "/users/default/pfp.jpg") + '" alt="" style="border-radius:' + escapeHtml(radius) + ';"></div>';
      } else if (sec.type === "link") {
        var href = sec.href || "#";
        var linkColor = sec.color || cbCssVar("--cb-accent-text", "#9cf");
        inner = '<div class="section-content"><a href="' + escapeHtml(href) + '" target="_blank" rel="noopener" style="color:' + escapeHtml(linkColor) + ';font-weight:700;text-decoration:none;">' + escapeHtml(sec.text || href) + "</a></div>";
      } else {
        var tstyle = "";
        if (sec.fontSize) tstyle += "font-size:" + sec.fontSize + ";";
        if (sec.color) tstyle += "color:" + sec.color + ";";
        if (sec.fontWeight) tstyle += "font-weight:" + sec.fontWeight + ";";
        if (sec.fontStyle) tstyle += "font-style:" + sec.fontStyle + ";";
        inner = '<div class="section-content" style="justify-content:flex-start;align-items:flex-start;"><div style="' + tstyle + 'white-space:pre-wrap;">' + escapeHtml(sec.text || "") + "</div></div>";
      }
      var handle = editMode ? '<div class="resize-handle" data-sec-resize="' + escapeHtml(sec.id) + '"></div>' : "";
      var sel = selectedId === sec.id ? " selected" : "";
      var lock = sec.locked ? " locked" : "";
      return '<div class="movable section' + (sec.type === "image" ? " image" : "") + sel + lock + '" data-id="' + escapeHtml(sec.id) + '" data-type="' + escapeHtml(sec.type || "text") + '" style="' + style + '">' + inner + handle + "</div>";
    }

    function renderCarrd() {
      applyCardChrome();
      var existing = cardEl.querySelectorAll(".movable");
      existing.forEach(function (n) { n.remove(); });
      (profile.sections || []).forEach(function (sec) {
        cardEl.insertAdjacentHTML("beforeend", sectionHtml(sec));
      });
      wireSectionEvents();
      syncBlockColorInputs();
    }

    function setEditMode(on) {
      editMode = !!on;
      toolbar.classList.toggle("open", editMode);
      fabRow.classList.toggle("open", editMode);
      cardEl.classList.toggle("editing", editMode);
      document.body.classList.toggle("carrd-editing", editMode);
      if (!editMode) selectedId = null;
      renderCarrd();
    }

    function fillEdit() {
      document.getElementById("editDisplay").value = profile.displayName || "";
      document.getElementById("editHandle").value = profile.handle || "";
      document.getElementById("editBio").value = profile.bio || "";
      document.getElementById("editAbout").value = profile.about || "";
      document.getElementById("editAvatar").value = profile.avatar || "";
    }

    function wireSectionEvents() {
      if (!editMode) return;
      cardEl.querySelectorAll(".movable").forEach(function (el) {
        el.onmousedown = function (e) {
          if (e.target.classList.contains("resize-handle")) return;
          e.preventDefault();
          selectedId = el.getAttribute("data-id");
          renderCarrd();
          var sec = profile.sections.find(function (s) { return s.id === selectedId; });
          if (!sec || sec.locked) return;
          var live = cardEl.querySelector('.movable[data-id="' + selectedId + '"]') || el;
          var startX = e.clientX, startY = e.clientY;
          var origL = sec.left, origT = sec.top;
          function move(ev) {
            sec.left = Math.max(0, origL + (ev.clientX - startX));
            sec.top = Math.max(0, origT + (ev.clientY - startY));
            live.style.left = sec.left + "px";
            live.style.top = sec.top + "px";
          }
          function up() {
            document.removeEventListener("mousemove", move);
            document.removeEventListener("mouseup", up);
          }
          document.addEventListener("mousemove", move);
          document.addEventListener("mouseup", up);
        };
        el.ondblclick = function () {
          var sec = profile.sections.find(function (s) { return s.id === el.getAttribute("data-id"); });
          if (!sec) return;
          if (sec.type === "image") {
            var choice = confirm("OK = upload file, Cancel = enter URL");
            if (choice) {
              selectedId = sec.id;
              if (imageFileInput) imageFileInput.click();
            } else {
              var url = prompt("Image URL", sec.imageSrc || "");
              if (url !== null) { sec.imageSrc = url.trim() || sec.imageSrc; renderCarrd(); }
            }
          } else if (sec.type === "link") {
            var label = prompt("Link label", sec.text || "");
            if (label === null) return;
            var href = prompt("Link URL", sec.href || "https://");
            if (href === null) return;
            sec.text = label; sec.href = href; renderCarrd();
          } else {
            var text = prompt("Text", sec.text || "");
            if (text !== null) { sec.text = text; renderCarrd(); }
          }
        };
      });
      cardEl.querySelectorAll(".resize-handle").forEach(function (h) {
        h.onmousedown = function (e) {
          e.preventDefault();
          e.stopPropagation();
          var id = h.getAttribute("data-sec-resize");
          var sec = profile.sections.find(function (s) { return s.id === id; });
          if (!sec) return;
          selectedId = id;
          var startX = e.clientX, startY = e.clientY;
          var ow = sec.width, oh = sec.height;
          function move(ev) {
            sec.width = Math.max(80, ow + (ev.clientX - startX));
            sec.height = Math.max(40, oh + (ev.clientY - startY));
            var live = cardEl.querySelector('.movable[data-id="' + id + '"]');
            if (live) {
              live.style.width = sec.width + "px";
              live.style.height = sec.height + "px";
            }
          }
          function up() {
            document.removeEventListener("mousemove", move);
            document.removeEventListener("mouseup", up);
            renderCarrd();
          }
          document.addEventListener("mousemove", move);
          document.addEventListener("mouseup", up);
        };
      });
    }

    function uid() { return "s_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }

    function persistCarrd() {
      var w = Number(document.getElementById("carrdWidth").value) || 880;
      var h = Number(document.getElementById("carrdHeight").value) || 520;
      var bg = document.getElementById("carrdBgColor").value || themeNavy();
      profile.card = { width: w, height: h, background: bg };
      saveProfile(profile);
      applyCardChrome();
    }

    function addImageFromDataUrl(dataUrl) {
      var sec = {
        id: uid(), left: 80, top: 80, width: 180, height: 180,
        type: "image", imageSrc: dataUrl, imageStyle: "8px"
      };
      profile.sections.push(sec);
      selectedId = sec.id;
      renderCarrd();
    }

    function readImageFile(file) {
      if (!file || !file.type || file.type.indexOf("image/") !== 0) {
        alert("Please choose an image file.");
        return;
      }
      if (file.size > IMAGE_MAX_BYTES) {
        alert("Image too large (max ~1.2MB). Try a smaller file.");
        return;
      }
      var reader = new FileReader();
      reader.onload = function () {
        var dataUrl = String(reader.result || "");
        if (!dataUrl) return;
        // If a selected image block exists, replace its src; else add new
        var sec = selectedSection();
        if (sec && sec.type === "image") {
          sec.imageSrc = dataUrl;
          renderCarrd();
        } else {
          addImageFromDataUrl(dataUrl);
        }
      };
      reader.onerror = function () { alert("Could not read that image."); };
      reader.readAsDataURL(file);
    }

    renderCarrd();

    if (isOwn) {
      document.getElementById("editToggle").onclick = function () {
        panel.classList.toggle("open");
        fillEdit();
      };
      var carrdBtn = document.getElementById("editCarrdBtn");
      if (carrdBtn) {
        carrdBtn.onclick = function () {
          setEditMode(true);
          cardEl.scrollIntoView({ behavior: "smooth", block: "center" });
        };
      }
      document.getElementById("editCancel").onclick = function () { panel.classList.remove("open"); };
      document.getElementById("editOpenCarrd").onclick = function () {
        panel.classList.remove("open");
        setEditMode(true);
        cardEl.scrollIntoView({ behavior: "smooth", block: "center" });
      };
      document.getElementById("editSave").onclick = function () {
        profile.displayName = (document.getElementById("editDisplay").value || "").trim() || profile.displayName;
        profile.handle = (document.getElementById("editHandle").value || "").trim().replace(/^@/, "") || profile.handle;
        profile.bio = (document.getElementById("editBio").value || "").trim();
        profile.about = (document.getElementById("editAbout").value || "").trim();
        profile.avatar = (document.getElementById("editAvatar").value || "").trim() || "/users/default/pfp.jpg";
        (profile.sections || []).forEach(function (s) {
          if (s.id === "s_name") s.text = profile.displayName;
          if (s.id === "s_handle") s.text = "@" + profile.handle;
          if (s.id === "s_bio") s.text = profile.bio;
          if (s.id === "s_avatar") s.imageSrc = profile.avatar;
        });
        saveProfile(profile);
        location.reload();
      };

      document.getElementById("carrdAddText").onclick = function () {
        var sec = {
          id: uid(), left: 60, top: 60, width: 280, height: 80,
          type: "text", text: "New text", fontSize: "1.1rem", color: "#e8eefc"
        };
        profile.sections.push(sec);
        selectedId = sec.id;
        renderCarrd();
      };
      document.getElementById("carrdAddImage").onclick = function (ev) {
        // Default: file upload. Shift+click: URL prompt. Right-click also offers URL.
        if (ev && ev.shiftKey) {
          var url = prompt("Image URL", "/users/default/pfp.jpg");
          if (url === null) return;
          var src = url.trim() || "/users/default/pfp.jpg";
          profile.sections.push({
            id: uid(), left: 80, top: 80, width: 180, height: 180,
            type: "image", imageSrc: src, imageStyle: "8px"
          });
          selectedId = profile.sections[profile.sections.length - 1].id;
          renderCarrd();
          return;
        }
        if (imageFileInput) imageFileInput.click();
      };
      if (imageFileInput) {
        imageFileInput.onchange = function () {
          var file = imageFileInput.files && imageFileInput.files[0];
          imageFileInput.value = "";
          if (file) readImageFile(file);
        };
      }
      // Secondary: right-click Add image for URL
      document.getElementById("carrdAddImage").oncontextmenu = function (e) {
        e.preventDefault();
        var url = prompt("Image URL", "/users/default/pfp.jpg");
        if (url === null) return;
        profile.sections.push({
          id: uid(), left: 80, top: 80, width: 180, height: 180,
          type: "image", imageSrc: url.trim() || "/users/default/pfp.jpg", imageStyle: "8px"
        });
        selectedId = profile.sections[profile.sections.length - 1].id;
        renderCarrd();
      };
      document.getElementById("carrdAddLink").onclick = function () {
        var sec = {
          id: uid(), left: 100, top: 100, width: 220, height: 48,
          type: "link", text: "My link", href: "https://", color: cbCssVar("--cb-accent-text", "#9cf")
        };
        profile.sections.push(sec);
        selectedId = sec.id;
        renderCarrd();
      };
      document.getElementById("carrdSave").onclick = function () {
        persistCarrd();
        alert("Page saved.");
      };
      document.getElementById("carrdQuickSave").onclick = function () {
        persistCarrd();
        alert("Layout saved.");
      };
      document.getElementById("carrdCancel").onclick = function () {
        persistCarrd();
        setEditMode(false);
      };
      document.getElementById("carrdReset").onclick = function () {
        if (!confirm("Reset custom page to a starter layout?")) return;
        profile.sections = defaultSections(profile);
        profile.card = { width: 880, height: 520, background: themeNavy() };
        saveProfile(profile);
        renderCarrd();
      };
      ["carrdBgColor", "carrdWidth", "carrdHeight"].forEach(function (id) {
        document.getElementById(id).addEventListener("change", function () {
          persistCarrd();
          renderCarrd();
        });
      });
      document.getElementById("carrdBgColor").addEventListener("input", function () {
        var bg = document.getElementById("carrdBgColor").value || themeNavy();
        if (!profile.card) profile.card = {};
        profile.card.background = bg;
        cardEl.style.backgroundColor = bg;
      });
      document.getElementById("carrdBlockBg").addEventListener("input", function () {
        var sec = selectedSection();
        if (!sec) return;
        sec.background = document.getElementById("carrdBlockBg").value;
        var live = cardEl.querySelector('.movable[data-id="' + sec.id + '"]');
        if (live) live.style.background = sec.background;
      });
      document.getElementById("carrdBlockText").addEventListener("input", function () {
        var sec = selectedSection();
        if (!sec || sec.type === "image") return;
        sec.color = document.getElementById("carrdBlockText").value;
        renderCarrd();
      });
      document.addEventListener("keydown", function (e) {
        if (!editMode || !selectedId) return;
        if (e.key === "Delete" || e.key === "Backspace") {
          var tag = (e.target && e.target.tagName) || "";
          if (tag === "INPUT" || tag === "TEXTAREA") return;
          e.preventDefault();
          profile.sections = profile.sections.filter(function (s) { return s.id !== selectedId; });
          selectedId = null;
          renderCarrd();
        }
      });
    }
  });
})();
