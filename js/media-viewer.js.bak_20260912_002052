(function (global) {
  var zoom = 1;
  var current = { url: "", type: "image", name: "media" };

  function ensureCss() {
    if (document.getElementById("cb-media-viewer-css")) return;
    var style = document.createElement("style");
    style.id = "cb-media-viewer-css";
    style.textContent = [
      ".cb-mv-root{position:fixed;inset:0;z-index:5000;display:flex;align-items:center;justify-content:center;}",
      ".cb-mv-backdrop{position:absolute;inset:0;background:color-mix(in srgb,var(--cb-navy) 55%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);}",
      ".cb-mv-stage{position:relative;z-index:1;max-width:min(92vw,1100px);max-height:88vh;display:flex;flex-direction:column;align-items:center;gap:12px;}",
      ".cb-mv-media-wrap{position:relative;max-width:100%;max-height:78vh;display:flex;align-items:center;justify-content:center;}",
      ".cb-mv-media-wrap img,.cb-mv-media-wrap video{max-width:100%;max-height:78vh;object-fit:contain;transform-origin:center center;transition:transform .15s ease;box-shadow:0 20px 60px rgba(0,0,0,.45);background:var(--cb-surface);}",
      ".cb-mv-top{position:absolute;top:14px;right:14px;z-index:2;display:flex;gap:8px;}",
      ".cb-mv-btn{appearance:none;border:1px solid rgba(var(--cb-accent-rgb),0.35);background:color-mix(in srgb,var(--cb-surface) 88%,transparent);color:var(--cb-text);width:40px;height:40px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;}",
      ".cb-mv-btn:hover{border-color:var(--cb-accent);background:rgba(var(--cb-accent-rgb),0.18);}",
      ".cb-mv-menu{position:absolute;top:58px;right:14px;z-index:3;min-width:160px;background:var(--cb-navy);border:1px solid rgba(var(--cb-accent-rgb),0.35);padding:6px;display:flex;flex-direction:column;gap:2px;}",
      ".cb-mv-menu[hidden]{display:none!important;}",
      ".cb-mv-menu button{appearance:none;border:0;background:transparent;color:var(--cb-text);text-align:left;padding:10px 12px;cursor:pointer;}",
      ".cb-mv-menu button:hover{background:rgba(var(--cb-accent-rgb),0.16);}",
      ".cb-mv-zoom{position:relative;z-index:2;display:flex;gap:8px;}",
      ".cb-mv-media-wrap video::-webkit-media-controls-panel{background:color-mix(in srgb,var(--cb-navy) 70%,transparent);}",
      ".cb-mv-media-wrap video{accent-color:var(--cb-accent);}"
    ].join("");
    document.head.appendChild(style);
  }

  function close() {
    var root = document.getElementById("cbMediaViewer");
    if (root) root.remove();
    document.removeEventListener("keydown", onKey);
    zoom = 1;
  }

  function onKey(e) {
    if (e.key === "Escape") close();
    if (e.key === "+" || e.key === "=") setZoom(zoom + 0.15);
    if (e.key === "-") setZoom(zoom - 0.15);
  }

  function setZoom(z) {
    zoom = Math.max(0.4, Math.min(3, z));
    var media = document.querySelector("#cbMediaViewer .cb-mv-media");
    if (media) media.style.transform = "scale(" + zoom + ")";
  }

  function save() {
    var a = document.createElement("a");
    a.href = current.url;
    a.download = current.name || "coolbrador-media";
    a.target = "_blank";
    a.rel = "noopener";
    document.body.appendChild(a);
    a.click();
    a.remove();
  }

  function report() {
    alert("Thanks. Report noted for this media. Moderators will take a look.");
  }

  function open(opts) {
    ensureCss();
    close();
    opts = opts || {};
    current.url = opts.url || opts.src || "";
    current.type = opts.type || ((/\.(mp4|webm|ogg)(\?|$)/i.test(current.url) || opts.kind === "video") ? "video" : "image");
    current.name = opts.name || "coolbrador-media";
    if (!current.url) return;

    var root = document.createElement("div");
    root.id = "cbMediaViewer";
    root.className = "cb-mv-root";
    root.setAttribute("role", "dialog");
    root.setAttribute("aria-modal", "true");
    root.setAttribute("aria-label", "Media viewer");

    var mediaHtml = current.type === "video"
      ? '<video class="cb-mv-media" src="' + current.url.replace(/"/g, "&quot;") + '" controls playsinline></video>'
      : '<img class="cb-mv-media" src="' + current.url.replace(/"/g, "&quot;") + '" alt="">';

    root.innerHTML =
      '<div class="cb-mv-backdrop" data-cb-mv-close></div>' +
      '<div class="cb-mv-top">' +
      '<button type="button" class="cb-mv-btn" data-cb-mv-more title="More" aria-label="More"><i class="fa-solid fa-ellipsis-vertical"></i></button>' +
      '<button type="button" class="cb-mv-btn" data-cb-mv-close title="Close" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>' +
      "</div>" +
      '<div class="cb-mv-menu" hidden>' +
      '<button type="button" data-cb-mv-save>Save</button>' +
      '<button type="button" data-cb-mv-report>Report</button>' +
      "</div>" +
      '<div class="cb-mv-stage">' +
      '<div class="cb-mv-media-wrap">' + mediaHtml + "</div>" +
      '<div class="cb-mv-zoom">' +
      '<button type="button" class="cb-mv-btn" data-cb-mv-zoom-out aria-label="Zoom out"><i class="fa-solid fa-minus"></i></button>' +
      '<button type="button" class="cb-mv-btn" data-cb-mv-zoom-in aria-label="Zoom in"><i class="fa-solid fa-plus"></i></button>' +
      "</div></div>";

    document.body.appendChild(root);
    document.addEventListener("keydown", onKey);

    root.querySelectorAll("[data-cb-mv-close]").forEach(function (el) {
      el.addEventListener("click", close);
    });
    var menu = root.querySelector(".cb-mv-menu");
    root.querySelector("[data-cb-mv-more]").addEventListener("click", function (e) {
      e.stopPropagation();
      menu.hidden = !menu.hidden;
    });
    root.querySelector("[data-cb-mv-save]").addEventListener("click", save);
    root.querySelector("[data-cb-mv-report]").addEventListener("click", report);
    root.querySelector("[data-cb-mv-zoom-in]").addEventListener("click", function () { setZoom(zoom + 0.2); });
    root.querySelector("[data-cb-mv-zoom-out]").addEventListener("click", function () { setZoom(zoom - 0.2); });
  }

  global.CoolbradorMediaViewer = { open: open, close: close };
})(typeof window !== "undefined" ? window : this);
