(function () {
  function isSignedInHome() {
    try {
      if (window.CoolbradorSession && window.CoolbradorSession.isSignedIn) {
        return !!window.CoolbradorSession.isSignedIn();
      }
    } catch (e) {}
    try {
      return localStorage.getItem("loggedIn") === "true" && !!String(localStorage.getItem("currentUserId") || "").trim();
    } catch (e) {
      return false;
    }
  }

  function escapeHtml(s) {
    if (window.CoolbradorPosts) return window.CoolbradorPosts.escapeHtml(s);
    return String(s).replace(/[&<>"']/g, function (c) {
      return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c];
    });
  }
  function getPfp(id) {
    if (window.CoolbradorPosts) return window.CoolbradorPosts.getPfp(id);
    return localStorage.getItem("pfp_" + id) || "/users/default/pfp.jpg";
  }
  function profileUrl(id) {
    if (window.CoolbradorPosts) return window.CoolbradorPosts.profileUrl(id);
    return "/users/" + encodeURIComponent(id);
  }
  var KNOWN_BOARDS = { beesid: "BeeSid", general: "General", testboard: "testboard", starry: "Starry", chippercorner: "ChipperCorner", labradoria: "Labradoria", mutinydesk: "MutinyDesk", giftdrive: "GiftDrive", farmreport: "FarmReport" };
  function canonicalBoard(name) {
    var raw = String(name || "").replace(/^\/+/, "").replace(/\/+$/, "");
    var lower = raw.toLowerCase();
    return KNOWN_BOARDS[lower] || raw;
  }
  function boardIcon(name) {
    var b = canonicalBoard(name);
    if (b.toLowerCase() === "beesid") return "/b/BeeSid/icon.png";
    if (b.toLowerCase() === "general") return "/b/General/icon.png";
    return "/b/" + b + "/icon.png";
  }
  function boardFallback(name) {
    var b = canonicalBoard(name);
    if (b.toLowerCase() === "beesid") return "/shared/TestImages/ProfilePhotos/BeeSid.png";
    if (b.toLowerCase() === "general") return "/img/Osaka_Stars.png";
    if (b.toLowerCase() === "testboard") return "/img/Osaka_Stars.png";
    return "/shared/TestImages/ProfilePhotos/" + b + ".png";
  }
  function isJunkRecent(h) {
    if (!h) return true;
    var label = String(h.label || "").trim();
    var url = String(h.url || "").trim();
    if (!label || !url) return true;
    var low = label.toLowerCase();
    if (low === "add friends" || low === "+" || low === "see all" || low === "browse" || low === "vote") return true;
    if (low === "home" || low === "#" || url === "/" || url === "/index.html") return true;
    if (url === "/community.html" && (low === "add friends" || h.fromAddFriends)) return true;
    if (/pants|wet themselves|sample \(demo\)/i.test(label)) return true;
    return false;
  }
  function cleanHistory(hist) {
    var seen = {};
    var out = [];
    (hist || []).forEach(function (h) {
      if (isJunkRecent(h)) return;
      var key = String(h.url || "");
      if (seen[key]) return;
      seen[key] = true;
      out.push(h);
    });
    return out;
  }
  function trackVisit(label, url, kind) {
    try {
      if (isJunkRecent({ label: label, url: url, kind: kind })) return;
      var hist = cleanHistory(JSON.parse(localStorage.getItem("cb_recent_v1") || "[]"));
      hist = hist.filter(function (h) { return h.url !== url; });
      hist.unshift({ label: label, url: url, kind: kind || "page", ts: Date.now() });
      localStorage.setItem("cb_recent_v1", JSON.stringify(hist.slice(0, 24)));
    } catch (e) {}
  }
  function card(opts) {
    var fallback = opts.fallback || "";
    var onerr = fallback
      ? "this.onerror=null;this.src='" + fallback + "';"
      : "this.onerror=null;this.parentElement.classList.add('no-img');this.remove();";
    var coming = !!opts.comingSoon;
    var cls = (opts.cls || "") + (coming ? " cb-coming-soon-wrap" : "");
    var href = coming ? "#" : opts.href;
    var overlay = coming ? '<div class="cb-coming-soon-overlay"><span>Coming soon</span></div>' : "";
    return (
      '<a class="hub-card ' + cls + '" href="' + href + '"' + (coming ? ' aria-disabled="true" tabindex="-1"' : "") + '>' +
      (opts.img
        ? '<div class="hub-card-thumb"><img src="' + opts.img + '" alt="" onerror="' + onerr + '"></div>'
        : '<div class="hub-card-thumb placeholder"></div>') +
      '<div class="hub-card-body"><strong>' + escapeHtml(opts.title) + '</strong>' +
      (opts.sub ? '<span>' + escapeHtml(opts.sub) + '</span>' : '') +
      '</div>' + overlay + '</a>'
    );
  }
  function friendTile(name, id, isAdd) {
    if (isAdd) {
      return (
        '<a class="hub-friend add" href="/friends.html" title="Add Friends">' +
        '<div class="hub-friend-avatar add-circle" aria-hidden="true">+</div>' +
        '<span>Add Friends</span></a>'
      );
    }
    return (
      '<a class="hub-friend" href="' + profileUrl(id) + '" title="' + escapeHtml(name) + '">' +
      '<div class="hub-friend-avatar"><img src="' + getPfp(id) + '" alt=""></div>' +
      '<span>' + escapeHtml(name) + '</span></a>'
    );
  }
  function fitFriendsScroller(scroller) {
    // Keep all friends; arrow carousel handles overflow.
    return;
  }

  function boardPostCount(boardName) {
    var key = "posts_/b/" + boardName;
    try {
      var list = JSON.parse(localStorage.getItem(key) || "[]");
      return Array.isArray(list) ? list.length : 0;
    } catch (e) { return 0; }
  }
  function boardDesc(boardName) {
    try {
      var meta = JSON.parse(localStorage.getItem("boardmeta_/b/" + boardName) || "{}");
      if (meta && meta.desc) return String(meta.desc).replace(/\s+/g, " ").trim().slice(0, 72);
    } catch (e) {}
    if (String(boardName).toLowerCase() === "general") return "The shared front porch for Labradors.";
    if (String(boardName).toLowerCase() === "beesid") return "BeeSid's hive and hangout.";
    return "A Coolbrador community board.";
  }

  function wireCarousel(wrap) {
    if (!wrap) return;
    var track = wrap.querySelector(".hub-carousel-track");
    var prev = wrap.querySelector(".hub-carousel-btn.prev");
    var next = wrap.querySelector(".hub-carousel-btn.next");
    if (!track) return;

    function step() {
      var cardEl = track.querySelector(".hub-card, .hub-friend");
      if (!cardEl) return Math.max(180, Math.floor(track.clientWidth * 0.8));
      var styles = window.getComputedStyle(track);
      var gap = parseFloat(styles.columnGap || styles.gap || "12") || 12;
      return cardEl.getBoundingClientRect().width + gap;
    }
    function updateBtns() {
      var max = track.scrollWidth - track.clientWidth - 2;
      var atStart = track.scrollLeft <= 2;
      var atEnd = track.scrollLeft >= max;
      if (prev) {
        prev.disabled = atStart;
        prev.setAttribute("aria-disabled", atStart ? "true" : "false");
      }
      if (next) {
        next.disabled = atEnd || max <= 0;
        next.setAttribute("aria-disabled", (atEnd || max <= 0) ? "true" : "false");
      }
      wrap.classList.toggle("is-scrollable", max > 2);
    }
    if (prev) {
      prev.addEventListener("click", function () {
        track.scrollBy({ left: -step(), behavior: "smooth" });
      });
    }
    if (next) {
      next.addEventListener("click", function () {
        track.scrollBy({ left: step(), behavior: "smooth" });
      });
    }
    track.addEventListener("scroll", updateBtns, { passive: true });
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(updateBtns).observe(track);
    } else {
      window.addEventListener("resize", updateBtns);
    }
    updateBtns();
  }

  document.addEventListener("DOMContentLoaded", function () {
    var greet = document.getElementById("hubGreeting");
    var name = "Home";
    try {
      var id = localStorage.getItem("currentUserId");
      if (localStorage.getItem("loggedIn") === "true" && id) {
        var u = JSON.parse(localStorage.getItem("user_" + id) || "{}");
        if (u.username) name = "Hey, " + u.username;
      }
    } catch (e) {}
    if (greet) greet.textContent = name;

    var friends = document.getElementById("friendsScroller");
    if (friends) {
      friends.classList.add("hub-friends-track");
      function currentProfileId() {
        try {
          if (localStorage.getItem("loggedIn") === "true") {
            var id = localStorage.getItem("currentUserId");
            if (id != null && String(id) !== "") return String(id);
          }
        } catch (e) {}
        return "0";
      }
      function remapFriendId(id) {
        var s = String(id == null ? "" : id).trim();
        if (!s || !/^\d+$/.test(s)) return "";
        var n = parseInt(s, 10);
        var base = (window.CB_DEMO_ID_BASE != null) ? Number(window.CB_DEMO_ID_BASE) : 2;
        if (n >= 0 && n < base) return String(base + n);
        return s;
      }
      function resolveFriend(fid) {
        var id = remapFriendId(fid);
        if (!id) return null;
        if (window.CoolbradorLayout && typeof window.CoolbradorLayout.resolveFriendEntry === "function") {
          return window.CoolbradorLayout.resolveFriendEntry(id);
        }
        var u = {};
        var p = {};
        try { u = JSON.parse(localStorage.getItem("user_" + id) || "{}"); } catch (e) {}
        try { p = JSON.parse(localStorage.getItem("profile_" + id) || "null") || {}; } catch (e) {}
        var seedNames = {
          "2":"Cardbrador","3":"BeeSid","4":"Miguel","5":"GyattToad","6":"AnthonySpade",
          "7":"Barcat","8":"EvilRobot","9":"AbovegroundBro","10":"NerdDog","11":"OrangeTabby",
          "12":"EvilKid23","13":"NoFilterBro","14":"CoolDog","15":"ANIMEGIRL",
          "16":"PantsWetterLabrador","17":"RhombusRex","18":"SnackBandit","19":"BarTabby",
          "20":"PuddlePirate","21":"TreatTaxer","22":"SofaThief","23":"BarkBroker"
        };
        var name = (p && p.displayName) || u.displayName || u.username || seedNames[id] || "";
        if (!name) return null;
        return { id: id, name: name };
      }
      function loadFriendIds(profileId) {
        var pid = String(profileId || "0");
        var base = (window.CB_DEMO_ID_BASE != null) ? Number(window.CB_DEMO_ID_BASE) : 2;
        try {
          var raw = JSON.parse(localStorage.getItem("friends_" + pid) || "[]");
          if (Array.isArray(raw) && raw.length) {
            var mapped = raw.map(remapFriendId).filter(Boolean);
            var seen = {};
            var out = [];
            mapped.forEach(function (id) {
              if (id === pid || seen[id]) return;
              seen[id] = true;
              out.push(id);
            });
            if (out.length) return out;
          }
        } catch (e) {}
        var pack = [];
        for (var i = 0; i <= 13; i++) {
          var did = String(base + i);
          if (did !== pid) pack.push(did);
        }
        return pack;
      }
      var myId = currentProfileId();
      if (myId === "me" || !/^\d+$/.test(String(myId))) {
        try {
          if (window.CoolbradorSession && window.CoolbradorSession.getSessionUserId) {
            var sid = String(window.CoolbradorSession.getSessionUserId() || "");
            if (/^\d+$/.test(sid)) myId = sid;
          }
        } catch (e) {}
      }
      var friendsRow = document.getElementById("rowFriends");
      var friendsEl = document.getElementById("friendsScroller");
      if (!isSignedInHome()) {
        if (friendsRow) friendsRow.hidden = true;
        if (friendsEl) friendsEl.innerHTML = "";
      } else {
        if (friendsRow) friendsRow.hidden = false;
      var friendIds = loadFriendIds(myId);
      var demoFriends = friendIds.map(resolveFriend).filter(Boolean);
      var html = friendTile("", "", true);
      demoFriends.forEach(function (f) {
        var nm = String(f.name || "").toLowerCase();
        if (String(f.id) === "2" || nm === "cardbrador") return;
        html += friendTile(f.name, f.id, false);
      });
      friends.innerHTML = html;
      wireCarousel(document.getElementById("friendsCarousel") || friends.closest(".hub-carousel"));

      }
    }

    var boards = [];
    var boardSeen = {};
    function addBoard(name) {
      var canon = canonicalBoard(name);
      if (!canon) return;
      var low = canon.toLowerCase();
      if (low === "testboard") return;
      if (boardSeen[low]) return;
      boardSeen[low] = true;
      boards.push(canon);
    }
    for (var i = 0; i < localStorage.length; i++) {
      var key = localStorage.key(i);
      if (key && key.startsWith("posts_/b/")) addBoard(key.replace("posts_/b/", ""));
      if (key && key.startsWith("boardmeta_/b/")) addBoard(key.replace("boardmeta_/b/", ""));
    }
    addBoard("General");
    addBoard("BeeSid");
    addBoard("Starry");
    addBoard("ChipperCorner");
    addBoard("Labradoria");
    addBoard("MutinyDesk");
    addBoard("GiftDrive");
    addBoard("FarmReport");
    boards.sort(function (a, b) {
      var order = { general: 0, beesid: 1, starry: 2, chippercorner: 3, labradoria: 4, mutinydesk: 5, giftdrive: 6, farmreport: 7 };
      var ao = order[a.toLowerCase()];
      var bo = order[b.toLowerCase()];
      if (ao == null) ao = 50;
      if (bo == null) bo = 50;
      if (ao !== bo) return ao - bo;
      return a.toLowerCase().localeCompare(b.toLowerCase());
    });

    var rec = document.getElementById("recommendedScroller");
    var carousel = document.getElementById("recommendedCarousel");
    if (rec) {
      if (!boards.length) {
        rec.innerHTML =
          '<div class="hub-empty">' +
          "<strong>No communities yet</strong>" +
          "<span>Boards Labradors hang out in will show up here.</span>" +
          "</div>";
      } else {
        rec.innerHTML = boards.map(function (b) {
          var n = boardPostCount(b);
          var label = b.toLowerCase() === "beesid" ? "BeeSid" : (b.toLowerCase() === "general" ? "General" : b);
          return card({
            title: label,
            sub: (n === 1 ? "1 post" : n + " posts") + " - " + boardDesc(b),
            href: "/b/" + b + "/board.html",
            img: boardIcon(b),
            fallback: boardFallback(b),
            cls: "community-card",
            comingSoon: b.toLowerCase() === "giftdrive"
          });
        }).join("");
      }
      wireCarousel(carousel || rec.closest(".hub-carousel"));
    }


    var homeFeed = document.getElementById("homePostsFeed");
    if (homeFeed && window.CoolbradorPosts && typeof window.CoolbradorPosts.mountFeed === "function") {
      window.CoolbradorPosts.mountFeed(homeFeed, {
        boards: "all",
        showBoard: true,
        navigateToBoard: false,
        limit: 24,
        emptyHtml: '<div class="hub-empty"><strong>No posts yet</strong><span>Board posts from across Coolbrador will land here.</span></div>'
      });
    } else if (homeFeed) {
      homeFeed.innerHTML = '<div class="hub-empty"><strong>Posts unavailable</strong><span>Refresh once seed and posts.js finish loading.</span></div>';
    }

    document.querySelectorAll(".hub-card, .hub-feature, .hub-friend").forEach(function (el) {
      el.addEventListener("click", function () {
        if (el.classList.contains("add") || (el.classList.contains("hub-friend") && /add friends/i.test((el.textContent || "")))) return;
        var href = el.getAttribute("href") || "";
        var label = (el.querySelector("strong, h3, span") || el).textContent.trim().slice(0, 40);
        if (/add friends/i.test(label)) return;
        var kind = "page";
        if (el.classList.contains("hub-feature")) kind = "feature";
        if (/\/b\//.test(href)) kind = "board";
        else if (/chipper/i.test(href)) kind = "game";
        else if (/profile/i.test(href)) kind = "profile";
        trackVisit(label, href, kind);
      });
    });
  });
})();
