<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/img/favicon3.ico" type="image/x-icon" sizes="any">
  <link rel="shortcut icon" href="/img/favicon3.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="/img/favicon3.ico">
  <title>Community - Coolbrador</title>
  <link rel="stylesheet" href="/styles.css"/>
</head>
<body class="community-page">
  <div id="shared-header"></div>
<script src="/js/shell-boot.js"></script>
  <div class="boards-top-banner">
    <h1>Community</h1>
    <div class="feed-tabs" role="tablist">
      <button type="button" class="feed-tab active" data-feed="foryou" role="tab">For You</button>
      <button type="button" class="feed-tab" data-feed="ingame" role="tab">Friends</button>
    </div>
    <p class="feed-hint" id="feedHint">Posts from boards across Coolbrador.</p>
  </div>

  <section class="container bodytext-section">
    <div class="create-post-container" id="createPostBox">
      <div class="create-post">
        <div class="post-avatar">
          <img id="currentUserPfp" src="/users/default/pfp.jpg" alt="You">
        </div>
        <textarea id="newPostText" placeholder="Say something and watch what happens..."></textarea>
      </div>
      <div class="media-preview" id="mediaPreview" style="display:none; position:relative;"></div>
      <div class="create-post-footer">
        <div class="post-tools">
          <button type="button" class="tool-btn" id="attachMedia" title="Add photo/video">Photo/Video</button>
        </div>
        <div class="board-input-wrapper">
          <input type="text" id="boardInput" value="General" placeholder="Pick a community / your board" autocomplete="off">
          <div id="suggestions"></div>
        </div>
        <button type="button" class="post-submit-btn" id="submitPost" disabled>Post</button>
      </div>
    </div>
    <input type="file" id="mediaInput" accept="image/*,video/*" style="display:none;">
    <div class="gallery items" id="communityFeed"></div>
  </section>

  <div id="shared-footer"></div>
  <script src="/js/layout.js"></script>
  <script src="/js/seed-demo.js"></script>
  <script src="/js/media-viewer.js"></script>
  <script src="/js/posts.js"></script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const CP = window.CoolbradorPosts;
  if (!CP) return;

  const boardInput = document.getElementById("boardInput");
  const suggestionsBox = document.getElementById("suggestions");
  const gallery = document.getElementById("communityFeed") || document.querySelector(".gallery.items");
  let feedMode = "foryou";

  let availableBoards = [];
  for (let i = 0; i < localStorage.length; i++) {
    const k = localStorage.key(i);
    if (k && k.startsWith("posts_/b/")) availableBoards.push(k.replace("posts_/b/", ""));
  }
  if (!availableBoards.includes("BeeSid") && !availableBoards.some(b => String(b).toLowerCase() === "beesid")) availableBoards.push("BeeSid");
  if (!availableBoards.some(b => String(b).toLowerCase() === "general")) availableBoards.push("General");
  if (!availableBoards.length) availableBoards.push("General");
  availableBoards = [...new Set(availableBoards)].sort();

  boardInput.addEventListener("input", () => {
    const q = boardInput.value.trim().toLowerCase();
    suggestionsBox.innerHTML = "";
    if (!q) { suggestionsBox.style.display = "none"; return; }
    const matches = availableBoards.filter(b => b.toLowerCase().includes(q));
    if (!matches.length) { suggestionsBox.style.display = "none"; return; }
    matches.forEach(b => {
      const div = document.createElement("div");
      div.className = "suggestion-item";
      div.textContent = b;
      div.onclick = () => { boardInput.value = b; suggestionsBox.style.display = "none"; };
      suggestionsBox.appendChild(div);
    });
    suggestionsBox.style.display = "block";
  });
  document.addEventListener("click", e => {
    if (!boardInput.contains(e.target) && !suggestionsBox.contains(e.target)) suggestionsBox.style.display = "none";
  });

  function friendsFilter(p) {
    return p.inGame || (p.board && String(p.board).indexOf("chipper") !== -1) || /chipper|in.?game/i.test(p.text || "");
  }

  function loadFeed() {
    let posts = (typeof CP.loadFeedPosts === "function")
      ? CP.loadFeedPosts({ boards: "all", includeReposts: true })
      : CP.loadPostsFromStorage("all");
    if (feedMode === "ingame") posts = posts.filter(friendsFilter);
    if (!posts.length) {
      gallery.innerHTML = '<p class="empty-feed">' + (feedMode === "ingame" ? "No Friends posts yet." : "No posts yet. Be the first!") + "</p>";
      return;
    }
    gallery.innerHTML = posts.map(post => CP.renderPostCard(post, {
      board: post.board,
      showBoard: true,
      repostBy: post._repost || null
    })).join("");
  }

  CP.bindFeedInteractions(gallery, {
    reload: loadFeed,
    onYeah: function () { loadFeed(); }
  });

  CP.mountComposer(document.getElementById("createPostBox"), {
    defaultBoard: "General",
    boardInput: boardInput,
    onPosted: function () { loadFeed(); }
  });

  document.querySelectorAll(".feed-tab").forEach(btn => {
    btn.addEventListener("click", () => {
      feedMode = btn.dataset.feed;
      document.querySelectorAll(".feed-tab").forEach(b => b.classList.toggle("active", b === btn));
      document.getElementById("feedHint").textContent = feedMode === "ingame"
        ? "Posts from friends across Coolbrador."
        : "Posts from boards across Coolbrador.";
      loadFeed();
    });
  });

  loadFeed();
});
</script>
</body>
</html>
