<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile - Coolbrador</title>
  <link rel="icon" href="/img/favicon3.ico" type="image/x-icon">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/styles-profile.css">
  <script>
    (function () {
      try {
        var known = ["default","green","ember","violet","ocean","rose","slate"];
        var t = localStorage.getItem("cb_theme") || "default";
        if (t === "certa-green") {
          t = "green";
          try { localStorage.setItem("cb_theme", "green"); } catch (e) {}
        }
        if (t === "light") {
          t = "default";
          try {
            localStorage.setItem("cb_theme", "default");
            if (!localStorage.getItem("cb_mode")) localStorage.setItem("cb_mode", "light");
          } catch (e) {}
        }
        if (known.indexOf(t) === -1) t = "default";
        var mode = localStorage.getItem("cb_mode") === "light" ? "light" : "dark";
        document.documentElement.dataset.theme = t;
        document.documentElement.dataset.mode = mode;
        if (t !== "default") document.documentElement.classList.add("pre-theme-" + t);
        var wall = localStorage.getItem("cb_wallpaper");
        if (wall) {
          document.documentElement.classList.add("cb-has-wallpaper");
          document.documentElement.style.setProperty("--cb-wallpaper", 'url("' + wall.replace(/\/g, "\\").replace(/"/g, '\"') + '")');
          document.documentElement.style.setProperty("--cb-wallpaper-tint", (localStorage.getItem("cb_wallpaper_tint") || "55") + "%");
          document.documentElement.style.setProperty("--cb-wallpaper-blur", (localStorage.getItem("cb_wallpaper_blur") || "0") + "px");
        }
        var accent = localStorage.getItem("cb_custom_accent");
        if (accent) {
          document.documentElement.style.setProperty("--cb-accent", accent);
          document.documentElement.style.setProperty("--cb-link", accent);
        }
      } catch (e) {}
    })();
  </script>
</head>
<body class="profile-page">
  <div id="shared-header"></div>
  <div class="rbx-profile" id="profileRoot">
    <div class="rbx-banner" id="profileBanner"></div>
    <div class="rbx-card">
      <div class="rbx-avatar-row">
        <img class="rbx-avatar" id="profileAvatar" src="/users/default/pfp.jpg" alt="">
        <div class="rbx-identity">
          <h1 id="profileDisplayName">User</h1>
          <p class="rbx-handle" id="profileHandle">@user</p>
          <p class="rbx-bio" id="profileBio">Coolbrador explorer.</p>
        </div>
        <div class="rbx-actions" id="profileActions"></div>
      </div>
      <div class="rbx-stats">
        <div class="rbx-stat"><strong id="statPosts">0</strong><span>Posts</span></div>
        <div class="rbx-stat"><strong id="statYeahs">0</strong><span>Yeahs</span></div>
        <div class="rbx-stat"><strong id="statJoined">-</strong><span>Joined</span></div>
      </div>
      <section class="rbx-section">
        <h2>About</h2>
        <p id="profileAbout">No extra details yet.</p>
      </section>

      <section class="rbx-section carrd-wrap">
        <h2>Custom page</h2>
        <div class="carrd-toolbar" id="carrdToolbar">
          <button type="button" id="carrdAddText">Add text</button>
          <button type="button" id="carrdAddImage">Add image</button>
          <input type="file" id="carrdImageFile" accept="image/*" hidden>
          <button type="button" id="carrdAddLink">Add link</button>
          <label class="carrd-color-label">Page BG <input type="color" id="carrdBgColor" value="#00001c"></label>
          <label class="carrd-color-label">Block BG <input type="color" id="carrdBlockBg" value="#00001c"></label>
          <label class="carrd-color-label">Text <input type="color" id="carrdBlockText" value="#e8eefc"></label>
          <label>W <input type="number" id="carrdWidth" min="320" max="1200" step="10" value="880" style="width:72px"></label>
          <label>H <input type="number" id="carrdHeight" min="240" max="1600" step="10" value="680" style="width:72px"></label>
          <button type="button" class="primary" id="carrdSave">Save</button>
          <button type="button" id="carrdCancel">Done</button>
        </div>
        <div class="carrd-canvas-host">
          <div class="profile-card carrd-card" id="carrdCard">
            <div class="resize-circle tl" data-resize="tl" hidden></div>
            <div class="resize-circle tr" data-resize="tr" hidden></div>
            <div class="resize-circle bl" data-resize="bl" hidden></div>
            <div class="resize-circle br" data-resize="br" hidden></div>
          </div>
        </div>
        <div class="carrd-fab-row" id="carrdFabRow">
          <button type="button" class="ghost" id="carrdReset">Reset layout</button>
          <button type="button" id="carrdQuickSave">Save layout</button>
        </div>
      </section>

      <section class="rbx-section">
        <h2>Recent posts</h2>
        <div id="profilePosts" class="gallery items"></div>
      </section>
      <div class="rbx-edit-panel" id="editPanel">
        <h2>Edit profile</h2>
        <label for="editDisplay">Display name</label>
        <input id="editDisplay" maxlength="40">
        <label for="editHandle">Handle</label>
        <input id="editHandle" maxlength="32">
        <label for="editBio">Bio</label>
        <textarea id="editBio" rows="3" maxlength="280"></textarea>
        <label for="editAbout">About</label>
        <textarea id="editAbout" rows="4" maxlength="600"></textarea>
        <label for="editAvatar">Avatar URL or leave blank</label>
        <input id="editAvatar" placeholder="/users/default/pfp.jpg">
        <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;">
          <button type="button" class="ghost" id="editOpenCarrd">Open page editor</button>
          <button type="button" class="ghost" id="editCancel">Cancel</button>
          <button type="button" id="editSave">Save</button>
        </div>
      </div>
    </div>
  </div>
  <div id="shared-footer"></div>
  <script src="/js/layout.js"></script>
  <script src="/js/seed-demo.js"></script>
  <script src="/js/profile.js"></script>
</body>
</html>
