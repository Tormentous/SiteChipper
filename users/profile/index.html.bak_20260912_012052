<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile - Coolbrador</title>
  <link rel="icon" href="/img/favicon3.ico" type="image/x-icon">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/styles-profile.css">
  <script>
    (function () {
      try {
        var known = ["default","green","ember","violet","ocean","rose","slate"];
        var t = localStorage.getItem("cb_theme") || "default";
        if (t === "certa-green") {
          t = "green";
          try { localStorage.setItem("cb_theme", "green"); } catch (e) {}
        }
        if (t === "light") {
          t = "default";
          try {
            localStorage.setItem("cb_theme", "default");
            if (!localStorage.getItem("cb_mode")) localStorage.setItem("cb_mode", "light");
          } catch (e) {}
        }
        if (known.indexOf(t) === -1) t = "default";
        var mode = localStorage.getItem("cb_mode") === "light" ? "light" : "dark";
        document.documentElement.dataset.theme = t;
        document.documentElement.dataset.mode = mode;
        if (t !== "default") document.documentElement.classList.add("pre-theme-" + t);
        var wall = localStorage.getItem("cb_wallpaper");
        if (wall) {
          document.documentElement.classList.add("cb-has-wallpaper");
          document.documentElement.style.setProperty("--cb-wallpaper", 'url("' + wall.replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '")');
          document.documentElement.style.setProperty("--cb-wallpaper-tint", (localStorage.getItem("cb_wallpaper_tint") || "55") + "%");
          document.documentElement.style.setProperty("--cb-wallpaper-blur", (localStorage.getItem("cb_wallpaper_blur") || "0") + "px");
        }
        var accent = localStorage.getItem("cb_custom_accent");
        if (accent) {
          document.documentElement.style.setProperty("--cb-accent", accent);
          document.documentElement.style.setProperty("--cb-link", accent);
        }
      } catch (e) {}
    })();
  </script>
</head>
<body class="profile-page">
  <div id="shared-header"></div>

  <div class="cb-profile" id="profileRoot" data-layout="profile">
    <div class="cb-profile-banner" id="profileBanner" role="img" aria-label="Profile banner">
      <img id="profileBannerImg" alt="" hidden>
      <button type="button" class="cb-profile-banner-open" id="bannerOpenBtn" title="View banner" aria-label="View banner" hidden></button>
    </div>

    <div class="cb-profile-body">
      <aside class="cb-profile-left" id="profileLeft">
        <button type="button" class="cb-profile-avatar-btn" id="avatarOpenBtn" title="View photo" aria-label="View profile photo">
          <img class="cb-profile-avatar" id="profileAvatar" src="/users/default/pfp.jpg" alt="">
        </button>
        <h1 class="cb-profile-name" id="profileDisplayName">User</h1>
        <p class="cb-profile-handle" id="profileHandle">@user</p>
        <p class="cb-profile-bio" id="profileBio">Coolbrador explorer.</p>

        <div class="cb-profile-stats" aria-label="Stats">
          <div class="cb-profile-stat"><strong id="statPosts">0</strong><span>Posts</span></div>
          <div class="cb-profile-stat"><strong id="statYeahs">0</strong><span>Yeahs</span></div>
          <div class="cb-profile-stat"><strong id="statJoined">-</strong><span>Joined</span></div>
        </div>

        <section class="cb-profile-block" id="mediaSection">
          <div class="cb-profile-block-head">
            <h2>Media</h2>
            <button type="button" class="cb-text-btn" id="seeAllMedia">See all media</button>
          </div>
          <div class="cb-media-grid" id="profileMediaGrid"></div>
        </section>

        <section class="cb-profile-block" id="friendsSection">
          <div class="cb-profile-block-head">
            <h2>Friends</h2>
          </div>
          <div class="cb-friends-list" id="profileFriends"></div>
        </section>
      </aside>

      <main class="cb-profile-right">
        <div class="cb-profile-right-top">
          <nav class="cb-profile-tabs" aria-label="Profile layouts">
            <div class="cb-profile-tabs-inner">
              <button type="button" class="cb-profile-tab is-active" data-layout-tab="profile">Profile</button>
              <button type="button" class="cb-profile-tab" data-layout-tab="card">Card</button>
              <button type="button" class="cb-profile-tab" data-layout-tab="links">Links</button>
              <span class="cb-profile-tab-ink" id="profileTabInk" aria-hidden="true"></span>
            </div>
          </nav>
          <div class="cb-profile-actions" id="profileActions"></div>
        </div>

        <div class="cb-profile-panes" id="profilePanes">
          <!-- PROFILE layout -->
          <section class="cb-profile-pane is-active" data-pane="profile" id="paneProfile">
            <nav class="cb-box-tabs" aria-label="Feed">
              <button type="button" class="cb-box-tab is-active" data-feed-tab="posts">Posts</button>
              <button type="button" class="cb-box-tab" data-feed-tab="replies">Replies</button>
              <button type="button" class="cb-box-tab" data-feed-tab="reposts">Reposts</button>
            </nav>

            <div class="cb-about-row" id="aboutSection">
              <section class="cb-about-copy">
                <h2>About me</h2>
                <p id="profileAbout">No extra details yet.</p>
              </section>
              <img class="cb-about-art-img" id="profileAboutImg" src="/img/favicon3.ico" alt="">
            </div>

            <div id="profileFeed" class="cb-profile-feed hub-feed"></div>
          </section>

          <!-- CARD layout -->
          <section class="cb-profile-pane" data-pane="card" id="paneCard" hidden>
            <div class="cb-business-card">
            <div class="cb-card-layout">
              <div class="cb-card-col cb-card-identity">
                <img id="cardAvatar" class="cb-card-avatar" src="/users/default/pfp.jpg" alt="">
                <h2 id="cardDisplayName">User</h2>
                <p id="cardHandle" class="cb-profile-handle">@user</p>
                <p id="cardBio" class="cb-profile-bio"></p>
              </div>
              <div class="cb-card-col cb-card-about">
                <h2>About me</h2>
                <p id="cardAbout"></p>
                <img id="cardAboutImg" class="cb-card-about-img" src="/img/favicon3.ico" alt="">
              </div>
              <div class="cb-card-col cb-card-socials">
                <h2>Socials</h2>
                <div id="cardSocials" class="cb-social-list"></div>
              </div>
            </div>
                      </div><!-- /.cb-business-card -->
</section>

          <!-- LINKS layout -->
          <section class="cb-profile-pane" data-pane="links" id="paneLinks" hidden>
            <div class="cb-links-layout">
              <img id="linksAvatar" class="cb-links-avatar" src="/users/default/pfp.jpg" alt="">
              <h2 id="linksDisplayName">User</h2>
              <p id="linksHandle" class="cb-profile-handle">@user</p>
              <p id="linksBio" class="cb-profile-bio"></p>
              <div id="linksSocials" class="cb-links-stack"></div>
            </div>
          </section>
        </div>
      </main>
    </div>

    <!-- Owner editor -->
    <div class="cb-edit-panel" id="editPanel" hidden>
      <div class="cb-edit-panel-inner">
        <h2>Edit profile</h2>
        <p class="cb-edit-note">You can update your own page. Handle and user id stay yours.</p>

        <label for="editDisplay">Display name</label>
        <input id="editDisplay" maxlength="40">

        <label for="editBio">Bio</label>
        <textarea id="editBio" rows="3" maxlength="280"></textarea>

        <label for="editAbout">About me</label>
        <textarea id="editAbout" rows="4" maxlength="600"></textarea>

        <label for="editLayoutPreset">Default layout</label>
        <select id="editLayoutPreset">
          <option value="profile">Profile</option>
          <option value="card">Card</option>
          <option value="links">Links</option>
        </select>

        <div class="cb-edit-upload-row">
          <div>
            <label>Profile photo</label>
            <input type="file" id="editAvatarFile" accept="image/*">
          </div>
          <div>
            <label>Banner</label>
            <input type="file" id="editBannerFile" accept="image/*">
          </div>
          <div>
            <label>About image</label>
            <input type="file" id="editAboutFile" accept="image/*">
          </div>
        </div>

        <h3>Social links</h3>
        <div class="cb-edit-socials">
          <label>Website <input id="editSocialWebsite" placeholder="https://"></label>
          <label>YouTube <input id="editSocialYoutube" placeholder="https://"></label>
          <label>Discord <input id="editSocialDiscord" placeholder="invite or tag"></label>
          <label>X / Twitter <input id="editSocialX" placeholder="https://"></label>
          <label>Instagram <input id="editSocialInstagram" placeholder="https://"></label>
          <label>Roblox <input id="editSocialRoblox" placeholder="https://"></label>
        </div>

        <details class="cb-builder-scaffold">
          <summary>Page builder scaffold</summary>
          <p>Section add / reorder / style using theme tokens. Full Canva-like builder comes later. Presets above switch Profile, Card, and Links.</p>
          <div class="cb-builder-actions">
            <button type="button" class="ghost" id="builderAddSection">Add section</button>
            <button type="button" class="ghost" id="builderReorderHint">Reorder tip</button>
          </div>
          <ul id="builderSections" class="cb-builder-list"></ul>
        </details>

        <div class="cb-edit-actions">
          <button type="button" class="ghost" id="editCancel">Cancel</button>
          <button type="button" id="editSave">Save</button>
        </div>
      </div>
    </div>

    <!-- Share menu -->
    <!-- Share menu template; JS moves into .cb-share-wrap under #profileActions -->
    <div class="cb-share-menu" id="shareMenu" hidden>
      <button type="button" data-share="profile">Share Profile <span class="cb-share-eg">/users/<span data-share-id>0</span></span></button>
      <button type="button" data-share="card">Share Card <span class="cb-share-eg">/users/<span data-share-id>0</span>/card</span></button>
      <button type="button" data-share="links">Share Links <span class="cb-share-eg">/users/<span data-share-id>0</span>/links</span></button>
    </div>
  </div>

  <div id="shared-footer"></div>
  <script src="/js/layout.js"></script>
  <script src="/js/seed-demo.js"></script>
  <script src="/js/media-viewer.js"></script>
  <script src="/js/posts.js"></script>
  <script src="/js/profile.js"></script>
</body>
</html>
