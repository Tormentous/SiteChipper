{
  "name": "coolbrador",
  "private": true,
  "description": "Coolbrador: static HTML/JS social site on Firebase Hosting, Auth and Firestore.",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "serve": "node tools/dev-server.mjs",
    "emulators": "firebase emulators:start --project demo-coolbrador --only auth,firestore,storage",
    "test": "firebase emulators:exec --project demo-coolbrador-tests --only auth,firestore,storage \"node --test tests/*.test.cjs\"",
    "test:unit": "node --test tests/chart.test.cjs tests/game-feed.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-coolbrador-tests --only firestore,storage \"node --test tests/social.rules.test.cjs\"",
    "dev:full": "node tools/dev.mjs --functions",
    "test:functions": "node tests/functions-smoke.cjs",
    "test:deletion": "node tests/deletion-http-smoke.cjs",
    "build": "node tools/build-hosting.mjs",
    "build:archive": "node tools/build-hosting.mjs --archive",
    "test:media": "node tests/media-http-smoke.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "15.31.0"
  }
}
