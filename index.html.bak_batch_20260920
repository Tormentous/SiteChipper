<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" href="/img/favicon3.ico" type="image/x-icon" sizes="any">
  <link rel="shortcut icon" href="/img/favicon3.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="/img/favicon3.ico">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - Coolbrador</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="home-hub-page">
  <div id="shared-header"></div>
<script src="/js/shell-boot.js"></script>
  <main class="hub">
    <header class="hub-top">
      <div>
        <p class="hub-eyebrow">Coolbrador</p>
        <h1 class="hub-title" id="hubGreeting">Home</h1>
        <p class="hub-sub">Boards, Chipper, Labradoria, and the pack - all in one starry place.</p>
      </div>
    </header>

    <section class="hub-row" id="rowFriends">
      <div class="hub-row-head"><h2>Friends</h2><a href="/community.html">Find Labradors</a></div>
      <div class="hub-carousel hub-friends-carousel" id="friendsCarousel">
        <button type="button" class="hub-carousel-btn prev" aria-label="Previous friends" title="Previous">
          <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <div class="hub-carousel-track hub-friends-track" id="friendsScroller"></div>
        <button type="button" class="hub-carousel-btn next" aria-label="Next friends" title="Next">
          <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </button>
      </div>
    </section>

    <section class="hub-row" id="rowRecommended">
      <div class="hub-row-head"><h2>Recommended communities</h2><a href="/community.html">Browse</a></div>
      <div class="hub-carousel" id="recommendedCarousel">
        <button type="button" class="hub-carousel-btn prev" aria-label="Previous communities" title="Previous">
          <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <div class="hub-carousel-track" id="recommendedScroller"></div>
        <button type="button" class="hub-carousel-btn next" aria-label="Next communities" title="Next">
          <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </button>
      </div>
    </section>

    <section class="hub-row hub-posts-row" id="rowPosts">
      <div class="hub-row-head"><h2>Posts</h2><a href="/community.html">See all</a></div>
      <div class="gallery items hub-home-feed" id="homePostsFeed"></div>
    </section>
  </main>
  <div id="shared-footer"></div>
  <script src="/js/layout.js"></script>
  <script src="/js/seed-demo.js"></script>
  <script src="/js/media-viewer.js"></script>
  <script src="/js/posts.js"></script>
  <script src="/js/home.js"></script>
</body>
</html>