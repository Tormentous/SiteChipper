/* Wider buttons + reduced internal padding */
.nav-rhombus {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-width: 140px;                 /* ÃƒÂ¢Ã¢â‚¬Â Ã‚Â Increased from 110px ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬â„¢ makes base width wider */
  padding: 0 1.2rem;                /* ÃƒÂ¢Ã¢â‚¬Â Ã‚Â Reduced horizontal padding by ~1/3 (was ~1.8rem ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬â„¢ now 1.2rem) */
  margin: 0;
  color: white;
  font-size: 1.3rem;
  font-weight: bold;
  text-decoration: none;
  background: rgba(0, 0, 0, 0.65);
  background-image: url(/img/Osaka_Stars_side.png);
  background-blend-mode: multiply;
  background-size: 260% auto;
  background-position: 0% center;
  overflow: hidden;
  clip-path: polygon(12% 0%, 100% 0%, 88% 100%, 0% 100%); /* Slightly adjusted for wider shape */
  animation: bgMove 14s linear infinite;
  transition: transform 0.4s ease, box-shadow 0.45s ease;
  text-shadow: 0 1px 4px rgba(0,0,0,0.7);
  pointer-events: auto;
}

/* Stronger per-link accent overlays (higher opacity for visibility) */
/* Per-link end accents stay vibrant on every theme; start fade uses --cb-navy-2 */
.nav-rhombus[href="/"] { --accent: #0062ff; }
.nav-rhombus[href="/community"], .nav-rhombus[href="/community.html"] { --accent: #7300ff; }
.nav-rhombus[href="/games/chipper"], .nav-rhombus[href="/games/chipper.html"] { --accent: #ff6200; }
.nav-rhombus[href="/polls"], .nav-rhombus[href="/polls.html"] { --accent: #15ff00; }
.nav-rhombus[href="/gift"], .nav-rhombus[href="/gift.html"] { --accent: #ff00bb; }

/* Replace the solid overlay with a vertical fade gradient */
.nav-rhombus::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    var(--cb-navy-2) 0%,                    /* Matches header top */
    rgba(var(--cb-navy-2-rgb), 0.85) 30%,            /* Stays dark a bit longer */
    var(--accent) 100%                    /* Fades fully into accent at bottom */
  );
  opacity: 0.22;                          /* Lower than before ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Å“ gradient is stronger, so less opacity needed */
  mix-blend-mode: overlay;                /* Keeps good visibility over stars + multiply bg */
  pointer-events: none;
  z-index: 1;
}

/* Hover: even stronger flash, colored glow, bigger scale */
.nav-rhombus:hover {
  transform: scale(1.18);               /* More dramatic grow */
  box-shadow: 0 0 35px var(--accent, rgba(255,255,255,0.5)); /* Colored outer glow! */
  
  animation: flashFade 0.35s ease-out forwards, bgMove 14s linear infinite;
  
  &::before {
    content: "";
    position: absolute;
    top: -100%;
    left: -80%;
    width: 70%;
    height: 300%;
    background: linear-gradient(
      120deg,
      transparent 20%,
      rgba(255, 255, 255, 0.7),
      transparent 80%
    );
    transform: skewX(-18deg);
    animation: shineMove 2s linear infinite;
    opacity: 1;
    z-index: 2;
  }
  
  &::after {
    opacity: 0.45;                      /* Max tint strength on hover */
  }
}

/* Flash now uses accent for colored pop */
@keyframes flashFade {
  0%   { background-color: var(--accent, white); opacity: 0.95; }
  100% { background-color: rgba(0, 0, 0, 0.65); opacity: 1; }
}

/* Keep shineMove & bgMove as-is (or tweak durations if needed) */

