  font-style: italic;                /* since it's an italic variant, set this to ensure correct rendering */
  font-size: 4.5rem;                  /* big ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Å“ adjust as needed (3.5remÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Å“6rem) */
  font-weight: bold;
  text-align: center;
  text-shadow: 
    0 0 30px rgba(255, 255, 255, 0.532); /* glow effect ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Å“ looks great on dark/star background */
  letter-spacing: 2px;
  pointer-events: none;               /* doesn't block clicks on buttons */
  white-space: nowrap;
  max-width: 90%;                     /* prevents overflow on small screens */
  
}

