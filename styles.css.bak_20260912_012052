/* === CB auth header chrome === */
#userSection {
  min-width: 148px;
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}
#userSectionMobile {
  min-width: 48px;
}

.cb-auth-skel {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 40px;
  pointer-events: none;
}
.cb-skel-line {
  width: 72px;
  height: 14px;
  border-radius: 0;
  background: linear-gradient(90deg, rgba(var(--cb-accent-rgb),0.12), rgba(var(--cb-accent-rgb),0.28), rgba(var(--cb-accent-rgb),0.12));
  background-size: 200% 100%;
  animation: cbSkel 1.1s ease-in-out infinite;
}
.cb-skel-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(90deg, rgba(var(--cb-accent-rgb),0.12), rgba(var(--cb-accent-rgb),0.28), rgba(var(--cb-accent-rgb),0.12));
  background-size: 200% 100%;
  animation: cbSkel 1.1s ease-in-out infinite;
}
@keyframes cbSkel {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}
#cbSidebarUser.cb-sidebar-user-skel {
  display: block;
  min-height: 1.2em;
  pointer-events: none;
}
#cbSidebarUser .cb-skel-line-side {
  display: block;
  width: min(120px, 70%);
  height: 16px;
  margin: 2px 0 6px;
}

.cb-user-menu { position: relative; display: inline-flex; align-items: center; }
.cb-user-menu-btn {
  appearance: none;
  border: 0;
  background: transparent;
  color: var(--cb-text);
  display: inline-flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  padding: 4px 0;
}
.cb-user-menu-name { font-weight: bold; }
.cb-user-menu-pfp {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  outline: 2px solid rgba(var(--cb-accent-rgb),0.25);
}
.cb-user-menu-panel {
  position: absolute;
  right: 0;
  top: calc(100% + 8px);
  min-width: 160px;
  background: var(--cb-navy);
  border: 1px solid rgba(var(--cb-accent-rgb),0.35);
  z-index: 3000;
  display: flex;
  flex-direction: column;
  padding: 6px;
  box-shadow: 0 12px 30px rgba(0,0,0,0.35);
}
.cb-user-menu-panel[hidden] { display: none !important; }
.cb-user-menu-panel a,
.cb-user-menu-panel button {
  appearance: none;
  border: 0;
  background: transparent;
  color: var(--cb-text);
  text-align: left;
  padding: 10px 12px;
  text-decoration: none;
  cursor: pointer;
  font: inherit;
}
.cb-user-menu-panel a:hover,
.cb-user-menu-panel button:hover {
  background: rgba(var(--cb-accent-rgb),0.16);
}
.rbx-profile .rbx-card,
.rbx-banner,
.rbx-avatar,
.rbx-stat,
.rbx-edit-panel {
  border-radius: 0 !important;
}



