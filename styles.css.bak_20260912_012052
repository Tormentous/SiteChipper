/* Chipper page - Sonic-style flat tabs, no text containers */
.chipper-page {
  position: relative;
  z-index: 2;
  max-width: none !important;
  width: 100%;
  margin: 0;
  padding: 0 0 3rem;
  box-sizing: border-box;
  --chip-blue: #1861da;
  --chip-red: #da444b;
  --chip-yellow: #ece053;
  --chip-purple: #7300ff;
  --chip-orange: #ff6200;
  --chip-green: #15ff00;
  --chip-pink: #ff00bb;
}

.chipper-tabs {
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 1rem;
  width: 100%;
  background: transparent;
  border-bottom: none;
  padding: 0.35rem 1.25rem 0;
  box-sizing: border-box;
  min-height: 52px;
}

.chipper-tabs-inner {
  display: flex;
  align-items: stretch;
  gap: 0.25rem;
  margin: 0 auto;
  flex: 1;
  justify-content: center;
}

.chipper-tab {
  appearance: none;
  border: 0;
  background: transparent;
  color: #fff;
  font-weight: 800;
  font-size: 1rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.95rem 1.35rem;
  cursor: pointer;
  position: relative;
}

.chipper-tab.is-active {
  color: #fff;
}

.chipper-tab.is-active::after {
  content: "";
  position: absolute;
  left: 12%;
  right: 12%;
  bottom: 0;
  height: 4px;
  background: #fff;
}



.chipper-panel {
  width: 100%;
  background: transparent;
  color: #fff;
  padding: 2.5rem 1.5rem 3.5rem;
  box-sizing: border-box;
}

.chipper-panel-inner {
  max-width: 1100px;
  margin: 0 auto;
}

.chipper-tab-pane[hidden] { display: none !important; }
.chipper-tab-pane.is-active { display: block; }

.chipper-panel-title {
  margin: 0 0 1.75rem;
