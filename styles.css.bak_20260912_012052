#container3D {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 800px;
  overflow: hidden;
  background: transparent;
  /* Soft top fade only - no bottom sawtooth */
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, #000 100%);
  mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, #000 100%);
}

#container3D canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;

  /* Top fade + sawtooth live on #container3D mask */
  /* Force consistent rendering (fixes DevTools zoom/visibility glitches) */
  transform: translateZ(0);
  backface-visibility: hidden;
  will-change: transform, opacity;
}

#container3D::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background: none;
}




/* Big heading text ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Å“ centered, large, with glow/shadow for visibility over stars */
.hero-heading {
  position: absolute;
  top: 15%;
  left: 50%;
  transform: translate(-50%, -50%);   /* perfect center */
  z-index: 3;                         /* above canvas and gradient */
  color: white;
