{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.py",
      "**/_patch*",
      "**/_probe*",
      "**/_fix*",
      "**/_verify*"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=300"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=60"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/notifications",
        "destination": "/notifications.html"
      },
      {
        "source": "/notifications/**",
        "destination": "/notifications.html"
      },
      {
        "source": "/messages",
        "destination": "/messages.html"
      },
      {
        "source": "/messages/**",
        "destination": "/messages.html"
      },
      {
        "source": "/polls",
        "destination": "/polls.html"
      },
      {
        "source": "/polls/**",
        "destination": "/polls.html"
      },
      {
        "source": "/settings",
        "destination": "/settings.html"
      },
      {
        "source": "/settings/**",
        "destination": "/settings.html"
      },
      {
        "source": "/users/**",
        "destination": "/users/profile/index.html"
      },
      {
        "source": "/b/*/post/*/comments",
        "destination": "/b/post-thread.html"
      },
      {
        "source": "/b/*/post/*/comments/",
        "destination": "/b/post-thread.html"
      }
    ]
  }
}
