{
  "rewrites": [
    {
      "source": "/notifications",
      "destination": "/notifications.html"
    },
    {
      "source": "/notifications/",
      "destination": "/notifications.html"
    },
    {
      "source": "/notifications/:n",
      "destination": "/notifications.html"
    },
    {
      "source": "/messages",
      "destination": "/messages.html"
    },
    {
      "source": "/messages/",
      "destination": "/messages.html"
    },
    {
      "source": "/messages/:n",
      "destination": "/messages.html"
    },
    {
      "source": "/messages/:n/",
      "destination": "/messages.html"
    },
    {
      "source": "/polls",
      "destination": "/polls.html"
    },
    {
      "source": "/polls/",
      "destination": "/polls.html"
    },
    {
      "source": "/polls/:type/:id",
      "destination": "/polls.html"
    },
    {
      "source": "/polls/:type/:id/",
      "destination": "/polls.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/settings/",
      "destination": "/settings.html"
    },
    {
      "source": "/users/:id",
      "destination": "/users/profile/index.html"
    },
    {
      "source": "/users/:id/",
      "destination": "/users/profile/index.html"
    }
  ],
  "directoryListing": false
}
