/* --- Profile page --- */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
body.profile-page {
  margin: 0;
  font-family: 'Inter', system-ui, sans-serif;
  background: linear-gradient(to bottom, var(--cb-navy-2), var(--cb-navy-3));
  color: var(--cb-text);
  min-height: 100vh;
}
.container { max-width: 960px; margin: 40px auto; padding: 0 20px; }
.profile-card {
  background: color-mix(in srgb, var(--cb-navy-2) 85%, transparent);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(var(--cb-accent-rgb),0.25);
  border-radius: 0;
  box-shadow: 0 20px 60px rgba(0,0,0,0.7);
  position: relative;
  overflow: hidden;
  margin: 40px auto;
  min-width: 400px;
  min-height: 400px;
  display: block;
}
/* Grid only while editing */
.profile-card.carrd-card.editing {
  background-image:
    linear-gradient(to right, rgba(var(--cb-accent-rgb),0.15) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(var(--cb-accent-rgb),0.15) 1px, transparent 1px);
  background-size: 20px 20px;
  background-position: 0 0;
}
.profile-card.carrd-card:not(.editing) {
  background-image: none;
}
.resize-circle {
  position: absolute; width: 16px; height: 16px; background: var(--cb-accent);
  border-radius: 50%; cursor: pointer; z-index: 20;
  box-shadow: 0 2px 8px rgba(0,0,0,0.5);
}
.resize-circle.tl { top: -8px; left: -8px; cursor: nwse-resize; }
.resize-circle.tr { top: -8px; right: -8px; cursor: nesw-resize; }
.resize-circle.bl { bottom: -8px; left: -8px; cursor: nesw-resize; }
.resize-circle.br { bottom: -8px; right: -8px; cursor: nwse-resize; }
.movable {
  position: absolute;
  cursor: move;
  user-select: none;
  padding: 8px;
  box-sizing: border-box;
  transition: box-shadow 0.12s ease, border-color 0.12s ease;
  border: 1px solid transparent;
  background: rgba(255,255,255,0.08);
  min-width: 80px;
  min-height: 40px;
  overflow: hidden;
}
.movable:hover {
  border-color: var(--cb-accent) !important;
  box-shadow: 0 0 0 3px rgba(var(--cb-accent-rgb),0.4), 0 4px 15px rgba(0,0,0,0.4);
}
.movable.selected {
  border-color: var(--cb-accent);
  box-shadow: 0 0 0 4px rgba(var(--cb-accent-rgb),0.6);
  z-index: 10;
}
.movable.locked {
  background: rgba(255,255,255,0.05);
}
.section-content {
  height: 100%;
  padding: 12px;
  box-sizing: border-box;
  overflow: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.section img { width: 100%; height: 100%; object-fit: cover; }
.resize-handle {
  position: absolute; bottom: -6px; right: -6px;
  width: 16px; height: 16px; background: var(--cb-accent); border-radius: 50%;
  cursor: nwse-resize; z-index: 15; box-shadow: 0 2px 6px rgba(0,0,0,0.4);
  opacity: 0;
  transition: opacity 0.15s;
}
.movable:hover .resize-handle { opacity: 1; }
.add-section-btn, .save-btn {
  position: fixed; bottom: 30px;
  width: 64px; height: 64px;
  background: var(--cb-accent); color: #000;
  font-size: 36px; border: none; border-radius: 50%; cursor: pointer;
  box-shadow: 0 8px 25px rgba(var(--cb-accent-rgb),0.5); z-index: 999;
}
.add-section-btn { right: 110px; }
.save-btn { right: 30px; font-size: 28px; }
#addSectionMenu {
  display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
  background: #1a1a2e; padding: 28px; border-radius: 0; z-index: 1200;
  box-shadow: 0 0 50px rgba(0,0,0,0.8); color: var(--cb-text);
}
.toolbar {
  position: fixed;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  background: color-mix(in srgb, var(--cb-surface) 92%, transparent);
  backdrop-filter: blur(10px);
  border-radius: 12px;
  padding: 8px 16px;
  display: flex;
  gap: 12px;
  align-items: center;
  box-shadow: 0 4px 20px rgba(0,0,0,0.5);
  z-index: 1000;
  border: 1px solid rgba(var(--cb-accent-rgb),0.3);
}
.toolbar button, .toolbar select, .toolbar input {
  background: rgba(255,255,255,0.1);
  color: var(--cb-text);
  border: 1px solid rgba(var(--cb-accent-rgb),0.4);
  border-radius: 6px;
  padding: 6px 10px;
  cursor: pointer;
}
.toolbar button:hover { background: rgba(var(--cb-accent-rgb),0.3); }
.toolbar .hidden { display: none !important; }

/* Carrd canvas under Roblox-like shell */
.carrd-card.editing .movable { cursor: move; }
.carrd-card:not(.editing) .movable {
  cursor: default;
  border-color: transparent !important;
  background: transparent;
  box-shadow: none !important;
}
.carrd-card:not(.editing) .movable:hover {
  border-color: transparent !important;
  box-shadow: none !important;
}
.carrd-card:not(.editing) .resize-handle { display: none !important; }
.carrd-card .movable a { pointer-events: auto; }
.carrd-card.editing .movable a { pointer-events: none; }
.profile-page .profile-card.carrd-card {
  margin: 0 auto;
  max-width: 100%;
  min-height: 320px;
}
.carrd-canvas-host {
  min-height: 340px;
}
.rbx-actions {
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
}
.rbx-edit-icon-btn {
  width: 48px !important;
  height: 48px !important;
  min-width: 48px;
  padding: 0 !important;
  border-radius: 50% !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--cb-accent), var(--cb-accent-2)) !important;
  border: none !important;
  color: #fff !important;
  box-shadow: 0 0 0 2px rgba(var(--cb-accent-rgb),0.35), 0 8px 24px rgba(0,0,0,0.35);
  cursor: pointer;
  font-size: 1.15rem !important;
}
.rbx-edit-icon-btn:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}
.rbx-edit-icon-btn i {
  font-family: "Font Awesome 6 Free" !important;
  font-weight: 900 !important;
  color: #fff !important;
  line-height: 1;
}
.carrd-color-label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.85rem;
  color: var(--cb-muted);
}
.carrd-color-label input[type="color"] {
  width: 36px;
  height: 28px;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
}

/* Image movables: no blue/white fill so PNG alpha shows card navy */
.movable[data-type="image"],
.movable.section.image,
.section.image {
  background: transparent !important;
}
.carrd-card:not(.editing) .movable[data-type="image"],
.carrd-card:not(.editing) .movable.section.image {
  background: transparent !important;
}
.movable[data-type="image"] .section-content,
.section.image .section-content {
  background: transparent;
  padding: 0;
}
